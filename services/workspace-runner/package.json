{
  "name": "@garden/workspace-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--conditions=development tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "build": "rm -rf dist && node ../../node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "NODE_OPTIONS=--conditions=development vitest run"
  },
  "dependencies": {
    "@garden/contracts": "workspace:*",
    "@garden/core": "workspace:*",
    "@davisvaughan/tree-sitter-r": "1.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/websocket": "11.3.0",
    "@homebridge/node-pty-prebuilt-multiarch": "0.13.1",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "fastify": "5.12.5",
    "playwright-core": "1.61.1",
    "pyright": "1.1.413",
    "typescript-native": "npm:typescript@7.0.2",
    "ws": "8.21.3",
    "yazl": "3.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/ws": "8.18.1",
    "@types/yazl": "3.3.1"
  }
}
