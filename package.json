{
  "name": "garden-ai-workspace",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @athanor/api --filter @athanor/web --filter @athanor/workspace-runner dev",
    "dev:postgres": "pnpm --parallel --filter @athanor/api --filter @athanor/web --filter @athanor/worker --filter @athanor/workspace-runner dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p evals/tsconfig.json --noEmit",
    "test": "pnpm -r test",
    "eval": "NODE_OPTIONS=--conditions=development tsx evals/run.ts",
    "eval:gate": "pnpm eval -- --gate",
    "eval:context": "NODE_OPTIONS=--conditions=development tsx evals/context-quality/run.ts",
    "eval:injection": "NODE_OPTIONS=--conditions=development tsx evals/agentdojo/run.ts",
    "eval:arms": "NODE_OPTIONS=--conditions=development tsx evals/arms/run.ts",
    "eval:cards": "NODE_OPTIONS=--conditions=development tsx evals/cards/run.ts",
    "eval:bench": "NODE_OPTIONS=--conditions=development tsx evals/bench/run.ts",
    "eval:edit": "NODE_OPTIONS=--conditions=development tsx evals/edit/run.ts",
    "eval:read": "NODE_OPTIONS=--conditions=development tsx evals/read/run.ts",
    "eval:rigs": "pnpm eval:context -- --ci && pnpm eval:injection -- --ci && pnpm eval:arms -- --ci && pnpm eval:cards -- --ci && pnpm eval:edit -- --ci && pnpm eval:read -- --ci",
    "lint": "NODE_OPTIONS=--max-old-space-size=8192 eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "license:check": "node scripts/check-dependency-licenses.mjs",
    "license:rust": "node scripts/check-rust-licenses.mjs",
    "release:check": "node scripts/check-release.mjs",
    "acp:check": "node scripts/acp/test-acp-bridge.mjs",
    "check": "pnpm license:check && pnpm release:check && node scripts/check-repository.mjs && node scripts/test-document.mjs && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm eval:gate && pnpm eval:rigs && pnpm build",
    "native:configure": "node apps/desktop/configure-native.mjs",
    "desktop:dev": "pnpm --filter @athanor/desktop dev",
    "desktop:build": "pnpm --filter @athanor/desktop native:build",
    "test:ui": "pnpm --filter @athanor/web build && node scripts/test-web-layout.mjs && node scripts/test-pdf-viewer.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.2",
    "eslint": "10.11.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
