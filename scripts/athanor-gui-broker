#!/usr/bin/python3 -I
"""Hold project GUI namespaces under an unprivileged service identity."""
import contextlib
import ctypes
import select
import json
import os
import pathlib
import re
import secrets
import selectors
import socket
import socketserver
import stat
import struct
import subprocess
import sys
import threading
import time

SOCKET = '/run/athanor-gui/control.sock'
UUID = r'[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}'


def workspace_root(value):
    if not isinstance(value, str) or not re.fullmatch(
            r'/home/athanor/' + UUID + r'(?:/\.athanor/gui/research/session-[A-Za-z0-9]+)?', value):
        raise ValueError('Invalid project GUI root')
    return pathlib.Path(value)


def open_directory(stack, parent, name, create=False, private=False):
    if create:
        try:
            os.mkdir(name, mode=0o700, dir_fd=parent)
        except FileExistsError:
            pass
    fd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent)
    stack.callback(os.close, fd)
    info = os.fstat(fd)
    if private and (info.st_uid != os.getuid() or info.st_mode & 0o077):
        raise ValueError('GUI state directory must be private to the runner')
    return fd


def namespace_command(root, stack):
    # Hold every path component so renames cannot change the directory bound into a namespace.
    held = open_directory(stack, None, '/')
    for component in root.parts[1:]:
        held = open_directory(stack, held, component)
    rootfd = held
    metadata = open_directory(stack, held, '.athanor', create=True)
    gui = open_directory(stack, metadata, 'gui', create=True, private=True)
    open_directory(stack, gui, 'home', create=True, private=True)
    try:
        machine = os.open('machine-id', os.O_RDWR | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=gui)
        os.write(machine, (secrets.token_hex(16) + '\n').encode())
    except FileExistsError:
        machine = os.open('machine-id', os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=gui)
    stack.callback(os.close, machine)
    info = os.fstat(machine)
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
        raise ValueError('Unsafe project GUI identity')
    os.lseek(machine, 0, os.SEEK_SET)
    if not re.fullmatch(b'[a-f0-9]{32}\n', os.read(machine, 34)):
        raise ValueError('Invalid project GUI identity')
    args = ['/usr/bin/bwrap', '--unshare-user', '--unshare-pid', '--unshare-ipc', '--unshare-uts',
            '--new-session', '--die-with-parent', '--ro-bind', '/usr', '/usr']
    for name in ('bin', 'sbin', 'lib', 'lib64'):
        source = pathlib.Path('/') / name
        if source.is_symlink():
            args.extend(['--symlink', os.readlink(source), str(source)])
        elif source.is_dir():
            args.extend(['--ro-bind', str(source), str(source)])
    public = ('/etc/alternatives', '/etc/dbus-1', '/etc/xdg', '/etc/fonts', '/etc/gtk-3.0',
              '/etc/ssl/certs', '/etc/ca-certificates', '/etc/ca-certificates.conf',
              '/etc/passwd', '/etc/group', '/etc/nsswitch.conf', '/etc/hosts', '/etc/resolv.conf',
              '/etc/localtime', '/etc/timezone', '/etc/ld.so.cache', '/etc/pulse',
              '/home/athanor/.cache/ms-playwright')
    for source in public:
        if pathlib.Path(source).exists():
            args.extend(['--ro-bind', source, source])
    args.extend(['--proc', '/proc', '--dev', '/dev', '--tmpfs', '/tmp', '--tmpfs', '/run',
                 '--bind', f'/proc/self/fd/{rootfd}', str(root),
                 '--ro-bind', f'/proc/self/fd/{machine}', '/etc/machine-id',
                 '--ro-bind', f'/proc/self/fd/{machine}', '/var/lib/dbus/machine-id',
                 '--chdir', str(root), '--info-fd', '2', '--', '/bin/sh', '-c',
                 'printf READY; exec /usr/bin/sleep infinity'])
    return args, (rootfd, machine)


def ready(child, info=None):
    parts = {'info': b'', 'ready': b'', 'error': b''}
    with selectors.DefaultSelector() as selector:
        selector.register(child.stdout, selectors.EVENT_READ, 'ready')
        selector.register(info or child.stderr, selectors.EVENT_READ, 'info')
        if info is not None:
            selector.register(child.stderr, selectors.EVENT_READ, 'error')
        deadline = time.monotonic() + 10
        while time.monotonic() < deadline:
            for key, _ in selector.select(.1):
                chunk = os.read(key.fileobj.fileno(), 8192)
                if not chunk:
                    selector.unregister(key.fileobj)
                    continue
                parts[key.data] += chunk
            if len(parts['info']) > 8192 or len(parts['error']) > 8192 or len(parts['ready']) > 16:
                break
            if parts['ready'] == b'READY':
                try:
                    info = json.loads(parts['info'])
                    pid = info['child-pid']
                    if type(pid) is not int or pid <= 0:
                        break
                    # starttime binds the subsequent proc-directory acquisition to this process.
                    identity = pathlib.Path(f'/proc/{pid}/stat').read_text().rsplit(')', 1)[1].split()[19]
                    return {'protocol': 1, 'pid': pid, 'startTime': identity}
                except (KeyError, ValueError):
                    pass
            if child.poll() is not None:
                break
    raise RuntimeError('GUI keeper did not become ready: ' + repr(parts)[:4096] + '; exit=' + str(child.poll()))


def stop(child, keeper=None):
    if child.poll() is None:
        child.kill()
    child.wait(timeout=10)
    if keeper is not None and not select.select([keeper], [], [], 10)[0]:
        raise RuntimeError('GUI namespace did not exit')
    child.stdout.close()
    child.stderr.close()


class Broker(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
    daemon_threads = True
    request_queue_size = 32

    def __init__(self, address):
        self.active = set()
        self.lock = threading.Lock()
        super().__init__(address, Handler)


class Handler(socketserver.StreamRequestHandler):
    def handle(self):
        _, uid, _ = struct.unpack('3i', self.request.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))
        if uid != os.getuid() or uid == 0:
            return
        self.request.settimeout(10)
        root = None
        child = None
        acquired = False
        stopped = False
        keeper = None
        try:
            raw = self.rfile.readline(4097)
            if len(raw) > 4096 or not raw.endswith(b'\n'):
                raise ValueError('Invalid GUI lease request')
            request = json.loads(raw)
            if request == {'check': True}:
                self.wfile.write(b'{"protocol":1,"ready":true}\n')
                return
            if not isinstance(request, dict) or set(request) != {'root'}:
                raise ValueError('Invalid GUI lease request')
            root = workspace_root(request['root'])
            with self.server.lock:
                if root in self.server.active:
                    raise ValueError('GUI root already leased')
                self.server.active.add(root)
                acquired = True
            with contextlib.ExitStack() as stack:
                command, fds = namespace_command(root, stack)
                metadata_read, metadata_write = os.pipe()
                metadata_stream = stack.enter_context(os.fdopen(metadata_read, 'rb'))
                command[command.index('--info-fd') + 1] = str(metadata_write)
                try:
                    child = subprocess.Popen(command, env={'PATH': '/usr/bin:/bin', 'LANG': 'C.UTF-8'},
                                             pass_fds=(*fds, metadata_write), stdin=subprocess.DEVNULL,
                                             stdout=subprocess.PIPE, stderr=subprocess.PIPE)
                finally:
                    os.close(metadata_write)
                metadata = ready(child, metadata_stream)
                keeper = os.pidfd_open(metadata['pid'])
                metadata['root'] = str(root)
                self.wfile.write(json.dumps(metadata).encode() + b'\n')
                self.request.settimeout(None)
                # A socket lifetime is a lease; runner death cannot leave an orphan keeper.
                request = self.rfile.readline(8)
                stop(child, keeper)
                stopped = True
                if request == b'stop\n':
                    self.wfile.write(b'{"stopped":true}\n')
        except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as cause:
            sys.stderr.write('Project GUI preparation failed: ' + str(cause)[:4096] + '\n')
            try:
                self.wfile.write(b'{"error":"Project GUI isolation is unavailable. Run garden doctor."}\n')
            except OSError:
                pass
        finally:
            if child is not None and not stopped:
                stop(child, keeper)
            if keeper is not None:
                os.close(keeper)
            if acquired:
                with self.server.lock:
                    self.server.active.discard(root)


def main():
    if os.getuid() == 0:
        raise RuntimeError('GUI broker must run without root privileges')
    if not hasattr(os, 'setns') or not hasattr(os, 'pidfd_open'):
        raise RuntimeError('GUI isolation requires Python namespace support')
    if sys.argv[1:] == ['check']:
        with socket.socket(socket.AF_UNIX) as client:
            client.settimeout(10)
            client.connect(SOCKET)
            client.sendall(b'{"check":true}\n')
            with client.makefile('rb') as response:
                if json.loads(response.readline(4096)) != {'protocol': 1, 'ready': True}:
                    raise RuntimeError('GUI broker is unavailable')
        print('gui=project_namespaces')
        return
    if sys.argv[1:]:
        raise ValueError('Invalid GUI broker command')
    if (os.uname().machine not in ('x86_64', 'aarch64') or
            ctypes.CDLL(None).syscall(444, 0, 0, 1) < 6):
        raise RuntimeError('GUI isolation requires Landlock scope support')
    subprocess.run(['/usr/bin/bwrap', '--unshare-user', '--unshare-pid', '--unshare-ipc',
                    '--unshare-uts', '--die-with-parent', '--ro-bind', '/usr', '/usr',
                    '--symlink', 'usr/bin', '/bin', '--symlink', 'usr/lib', '/lib',
                    '--symlink', 'usr/lib64', '/lib64', '--proc', '/proc', '--dev', '/dev',
                    '--', '/usr/bin/true'], check=True, timeout=10)
    os.umask(0o077)
    try:
        os.unlink(SOCKET)
    except FileNotFoundError:
        pass
    with Broker(SOCKET) as server:
        address = os.environ.pop('NOTIFY_SOCKET', None)
        if address:
            with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as notify:
                notify.connect('\0' + address[1:] if address.startswith('@') else address)
                notify.sendall(b'READY=1')
        server.serve_forever(poll_interval=.2)


if __name__ == '__main__':
    main()
