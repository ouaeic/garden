#!/bin/sh
set -eu

garden_root="${GARDEN_ROOT:-/opt/garden}"
garden_config="${GARDEN_CONFIG:-/etc/garden}"
garden_state="${GARDEN_STATE:-/var/lib/garden}"
control_env="$garden_config/control.env"
identity_key="$garden_config/tls/server.key"
certificate="$garden_config/tls/server.crt"
acme_webroot="$garden_state/acme"
network_refresh="${GARDEN_NETWORK_REFRESH:-/usr/local/lib/garden/garden-network-refresh}"
nginx_snippets="${GARDEN_NGINX_SNIPPETS:-/etc/nginx/snippets}"
subscriber_agreement="https://letsencrypt.org/repository/"
# Renewal runs unattended from a timer. Without a record of the last failure the only symptom is a
# browser warning days later, so every failed attempt leaves a note here that `garden doctor` and
# the login banner read. Same shape as the dynamic-DNS error file: timestamp, then reason.
certificate_error="$garden_state/certificate.error"
# A certificate the authority issued that nginx then refused. It is still a good certificate, and
# asking for another counts against the authority's limit of five identical certificates a week,
# which a renewal retried every quarter hour exhausts in an afternoon. So it is kept, and the next
# attempt installs it again before asking for anything. It holds a public chain and no key.
pending_certificate="$garden_state/certificate.pending"

# Ordinary certificates last 90 days; renewing at 30 leaves two further attempts before anything
# served to a browser expires.
renew_threshold_seconds=2592000
# A certificate covering a bare IP address is only issued under the "shortlived" profile, which
# lasts 160 hours. Thirty days of headroom is longer than the certificate, so that profile needs
# its own threshold: 72 hours still leaves several renewal attempts.
shortlived_renew_threshold_seconds=259200

fail() {
  printf 'garden certificate: %s\n' "$1" >&2
  exit 1
}

note() {
  printf 'garden certificate: %s\n' "$1"
}

record_renewal_failure() {
  install -d -m 0755 "$garden_state" 2>/dev/null || true
  printf '%s\n%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" >"$certificate_error" || return 0
  chmod 0644 "$certificate_error" || true
}

clear_renewal_failure() {
  rm -f "$certificate_error"
}

certificate_expiry_summary() {
  [ -s "$certificate" ] || {
    printf 'no certificate is installed'
    return 0
  }
  if openssl x509 -in "$certificate" -noout -checkend 0 >/dev/null 2>&1; then
    printf 'the served certificate is still valid until %s' \
      "$(openssl x509 -in "$certificate" -noout -enddate 2>/dev/null | sed 's/^notAfter=//')"
  else
    printf 'the served certificate has already expired, so every client sees a security warning'
  fi
}

control_value() {
  [ -r "$control_env" ] || return 0
  sed -n "s/^$1=//p" "$control_env" | sed -n '1p'
}

set_control_value() {
  config_key="$1"
  config_temp=$(mktemp "$control_env.XXXXXX")
  chmod 0600 "$config_temp"
  # The value reaches awk through the environment, never through `-v`: this file also holds
  # secrets, and a process argument list is world-readable through /proc/PID/cmdline.
  GARDEN_CONFIG_VALUE="$2" awk -v key="$config_key" '
    BEGIN { replaced = 0; value = ENVIRON["GARDEN_CONFIG_VALUE"] }
    index($0, key "=") == 1 {
      if (!replaced) print key "=" value
      replaced = 1
      next
    }
    { print }
    END { if (!replaced) print key "=" value }
  ' "$control_env" >"$config_temp"
  mv "$config_temp" "$control_env"
}

is_ip_literal() {
  case "$1" in
    *:*) return 0 ;;
  esac
  printf '%s' "$1" | awk '{ exit ($0 ~ /^[0-9]+([.][0-9]+){3}$/) ? 0 : 1 }'
}

public_hostname() {
  public_url=$(control_value PUBLIC_APP_URL)
  [ -n "$public_url" ] || return 0
  node -e '
    process.stdout.write(new URL(process.argv[1]).hostname.replace(/^\[|\]$/g, ""));
  ' "$public_url"
}

# Every DNS name a client may use has to be in the certificate, otherwise switching
# between the public origin and the dynamic-DNS name produces a name mismatch.
certificate_hostnames() {
  {
    public_hostname
    printf '\n'
    printf '%s\n' "$(control_value DDNS_HOSTNAME)"
  } |
    while IFS= read -r candidate; do
      [ -n "$candidate" ] || continue
      is_ip_literal "$candidate" && continue
      printf '%s\n' "$candidate"
    done |
    awk 'NF && !seen[$0]++'
}

certificate_subject_alt_names() {
  names_source="${1:-$certificate}"
  [ -s "$names_source" ] || return 0
  openssl x509 -in "$names_source" -noout -ext subjectAltName 2>/dev/null |
    tr ',' '\n' |
    sed -n -e 's/^[[:space:]]*DNS://p' -e 's/^[[:space:]]*IP Address://p' |
    tr 'A-Z' 'a-z' |
    awk 'NF'
}

# A name acquired after the certificate was issued - the usual case is `garden ddns configure`
# giving a server its first real hostname - is not covered by the file on disk, and an expiry
# check would never notice. IPv6 SANs are deliberately not compared: OpenSSL prints them fully
# expanded, so a textual comparison against the compact form would report a permanent mismatch
# and reissue on every timer firing.
certificate_covers_configured_names() {
  served_names=$(certificate_subject_alt_names "${1:-$certificate}")
  {
    certificate_hostnames
    if [ "$(control_value ACME_INCLUDE_IPS)" = true ]; then
      certificate_ip_addresses | awk '$0 !~ /:/'
    fi
  } |
    while IFS= read -r required_name; do
      [ -n "$required_name" ] || continue
      printf '%s\n' "$served_names" |
        grep -Fqx "$(printf '%s' "$required_name" | tr 'A-Z' 'a-z')" || exit 1
    done
}

certificate_is_ca_issued() {
  [ -s "$certificate" ] || return 1
  certificate_subject=$(openssl x509 -in "$certificate" -noout -subject 2>/dev/null || true)
  certificate_issuer=$(openssl x509 -in "$certificate" -noout -issuer 2>/dev/null || true)
  [ -n "$certificate_subject" ] || return 1
  [ "${certificate_subject#subject=}" != "${certificate_issuer#issuer=}" ]
}

# Every globally routable address the manifest advertises. A certificate that omits one leaves
# that endpoint on a browser warning, which is the failure this whole path exists to remove.
certificate_ip_addresses() {
  {
    ip -o -4 address show scope global 2>/dev/null |
      awk '$2 !~ /^(docker|br-|veth|cni|podman|virbr)/ { address = $4; sub(/\/.*/, "", address); print address }'
    ip -o -6 address show scope global -temporary 2>/dev/null |
      awk '$2 !~ /^(docker|br-|veth|cni|podman|virbr)/ { address = $4; sub(/\/.*/, "", address); print address }'
  } | awk 'NF && !seen[$0]++'
}

# lego rather than certbot. Certificates must carry the server's existing identity key so that
# already-paired native clients keep verifying, and lego takes that key directly with
# --private-key. It also implements RFC 8738, so the same code path issues for a bare IP address;
# the packaged certbot refuses an address identifier in its own client-side check, and even a
# current certbot rejects one supplied through a CSR. lego ships as a single static binary with
# no runtime, so there is no interpreter or virtual environment to maintain on the host.
lego_version="5.3.1"
lego_binary="${GARDEN_LEGO:-/usr/local/lib/garden/lego}"
lego_sha256_amd64="b3c71b122ee1947eacfe0b809b955647f6377239fe4bfc49f73b1a091ae1252a"
lego_sha256_arm64="58db563a2b97c2259516fa9910b4a9e1634a0737723d0381a65af1bf93a4b433"

require_acme_client() {
  if [ -x "$lego_binary" ] &&
    "$lego_binary" --version 2>/dev/null | grep -q "lego version $lego_version"; then
    return 0
  fi
  case "$(dpkg --print-architecture)" in
    amd64) lego_arch=amd64; lego_expected="$lego_sha256_amd64" ;;
    arm64) lego_arch=arm64; lego_expected="$lego_sha256_arm64" ;;
    *) fail "no pinned ACME client is available for this architecture" ;;
  esac
  note "installing the ACME client (lego $lego_version)"
  download_directory=$(mktemp -d)
  archive="$download_directory/lego.tar.gz"
  curl -fsSL --max-time 120 -o "$archive" \
    "https://github.com/go-acme/lego/releases/download/v${lego_version}/lego_v${lego_version}_linux_${lego_arch}.tar.gz" ||
    { rm -rf "$download_directory"; fail "the ACME client could not be downloaded"; }
  # The digest is pinned in this script rather than fetched alongside the archive: a checksum
  # served from the same place as the file it describes proves only that the download completed.
  observed=$(sha256sum "$archive" | awk '{print $1}')
  if [ "$observed" != "$lego_expected" ]; then
    rm -rf "$download_directory"
    fail "the downloaded ACME client does not match its pinned checksum; refusing to install it"
  fi
  tar -xzf "$archive" -C "$download_directory" lego ||
    { rm -rf "$download_directory"; fail "the ACME client archive could not be extracted"; }
  install -d -m 0755 /usr/local/lib/garden
  install -m 0755 "$download_directory/lego" "$lego_binary"
  rm -rf "$download_directory"
}

# A local fetch through the public hostname proves DNS, the HTTP listener, and the
# challenge root at once. It cannot prove that an off-site request reaches port 80,
# and a router without hairpin NAT fails it even when the internet path is fine.
preflight_hostname() {
  preflight_host="$1"
  getent ahosts "$preflight_host" >/dev/null 2>&1 ||
    fail "$preflight_host does not resolve; finish DNS or dynamic-DNS setup first"
  probe_token="garden-preflight-$(openssl rand -hex 16)"
  probe_directory="$acme_webroot/.well-known/acme-challenge"
  install -d -m 0755 "$acme_webroot" "$acme_webroot/.well-known" "$probe_directory"
  printf '%s\n' "$probe_token" >"$probe_directory/$probe_token"
  chmod 0644 "$probe_directory/$probe_token"
  probe_result=$(
    curl -fsS --max-time 20 \
      "http://$preflight_host/.well-known/acme-challenge/$probe_token" 2>/dev/null || true
  )
  rm -f "$probe_directory/$probe_token"
  [ "$probe_result" = "$probe_token" ] ||
    fail "http://$preflight_host/.well-known/acme-challenge/ is not reachable from this host; open inbound TCP 80, or pass --skip-preflight if the router cannot loop a request back to itself"
}

issue_certificate() {
  skip_preflight=""
  force_ips=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --skip-preflight) skip_preflight=yes ;;
      --include-ips) force_ips=yes ;;
      *) fail "usage: garden certificate issue [--skip-preflight] [--include-ips]" ;;
    esac
    shift
  done

  acme_email=$(control_value ACME_EMAIL)
  [ -n "$acme_email" ] ||
    fail "no ACME contact address is recorded; run sudo garden certificate enable --agree-tos --email you@example.com"
  [ -r "$identity_key" ] || fail "missing server identity key at $identity_key"

  hostnames=$(certificate_hostnames)
  # A server with no name at all is the case this exists for: rather than leaving the owner on a
  # browser warning until they buy a domain, certify the addresses the manifest already advertises.
  # A named server keeps 90-day certificates, because mixing in an address would force every
  # renewal onto the 160-hour profile for no benefit.
  addresses=""
  if [ -z "$hostnames" ] || [ -n "$force_ips" ] ||
    [ "$(control_value ACME_INCLUDE_IPS)" = true ]; then
    addresses=$(certificate_ip_addresses)
  fi
  # Remember the choice. Renewal re-runs this function, and without a record it would quietly drop
  # the address identifiers on the next renewal and put every IP endpoint back on a browser warning.
  if [ -n "$addresses" ]; then
    set_control_value ACME_INCLUDE_IPS true
  else
    set_control_value ACME_INCLUDE_IPS false
  fi
  [ -n "$hostnames$addresses" ] ||
    fail "no usable hostname or globally routable address was found; run sudo garden set-hostname ai.example.com or sudo garden ddns configure"

  if pending_certificate_usable; then
    install_certificate "$pending_certificate"
    clear_renewal_failure
    note "installed the certificate issued on an earlier attempt; nothing new was requested"
    return 0
  fi
  rm -f "$pending_certificate"

  require_acme_client
  if [ -z "$skip_preflight" ]; then
    for hostname_value in $hostnames; do
      preflight_hostname "$hostname_value"
    done
    for address_value in $addresses; do
      case "$address_value" in
        *:*) preflight_hostname "[$address_value]" ;;
        *) preflight_hostname "$address_value" ;;
      esac
    done
  fi

  work_directory=$(mktemp -d)
  chmod 0700 "$work_directory"
  trap 'rm -rf "$work_directory"' EXIT INT TERM

  # lego is handed the identity key directly, so the issued certificate carries the same public
  # key that already-paired native clients pin. A copy is used because lego opens the key for
  # reading as its own user and the original must keep its restrictive ownership.
  install -m 0600 "$identity_key" "$work_directory/identity.key" ||
    fail "the server identity key could not be read"

  install -d -m 0755 "$acme_webroot"
  acme_directory=$(control_value ACME_DIRECTORY)
  [ -n "$acme_directory" ] || acme_directory="https://acme-v02.api.letsencrypt.org/directory"
  set -- run \
    --accept-tos \
    --email "$acme_email" \
    --server "$acme_directory" \
    --path "$work_directory/lego" \
    --http \
    --http.webroot "$acme_webroot" \
    --private-key "$work_directory/identity.key"
  for hostname_value in $hostnames; do
    set -- "$@" --domains "$hostname_value"
  done
  for address_value in $addresses; do
    set -- "$@" --domains "$address_value"
  done
  # A bare address is only issued under the shortlived profile, which caps validity at 160 hours.
  # Named certificates keep the default profile so they are not renewed every few days for nothing.
  [ -z "$addresses" ] || set -- "$@" --profile shortlived

  # Issuance failure must leave the currently served certificate untouched.
  "$lego_binary" "$@" ||
    fail "the certificate could not be issued; the existing certificate is unchanged"

  primary=$(printf '%s\n%s\n' "$hostnames" "$addresses" | awk 'NF {print; exit}')
  issued_chain="$work_directory/lego/certificates/${primary}.crt"
  # lego writes the leaf and its issuer to the same directory; the bundled .crt is the chain.
  [ -s "$issued_chain" ] ||
    issued_chain=$(find "$work_directory/lego/certificates" -name '*.crt' ! -name '*.issuer.crt' 2>/dev/null | sed -n '1p')
  [ -n "$issued_chain" ] && [ -s "$issued_chain" ] ||
    fail "the ACME client reported success but produced no certificate chain"
  cp "$issued_chain" "$work_directory/fullchain.pem"

  issued_fingerprint=$(
    openssl x509 -in "$work_directory/fullchain.pem" -noout -pubkey 2>/dev/null |
      openssl pkey -pubin -outform DER 2>/dev/null |
      openssl dgst -sha256 -binary |
      openssl base64 -A
  )
  [ -n "$issued_fingerprint" ] && [ "$(identity_fingerprint)" = "$issued_fingerprint" ] ||
    fail "the issued certificate does not carry the pinned identity key; it was discarded"
  openssl x509 -in "$work_directory/fullchain.pem" -noout -checkend 0 >/dev/null ||
    fail "the issued certificate is already expired; it was discarded"

  install_certificate "$work_directory/fullchain.pem"
  rm -rf "$work_directory"
  trap - EXIT INT TERM
  clear_renewal_failure
  note "installed a publicly trusted certificate for: $(printf '%s\n%s\n' "$hostnames" "$addresses" | awk 'NF' | tr '\n' ' ')"
  note "the pinned server identity is unchanged, so paired clients keep working"
}

# HSTS follows the certificate, and only the certificate.
#
# The header tells a browser to refuse this host over anything but HTTPS, and to refuse an
# untrusted certificate outright rather than offering to proceed. That is what makes it worth
# having on a box with a real certificate, and exactly why it must never be sent by a box serving
# garden's own self-signed one: the owner would be locked out of their own computer with no way
# back in from the browser.
#
# So it is written when a publicly trusted certificate starts serving and removed when one stops,
# by swapping one included file. `garden certificate disable` calls this with `off` before the
# self-signed certificate goes back, because a browser that has already cached the header will not
# load the box afterwards.
set_hsts() {
  hsts_source="$garden_root/infra/native/nginx-hsts-$1.conf"
  hsts_target="$nginx_snippets/garden-hsts.conf"
  [ -f "$hsts_source" ] || fail "the HSTS snippet $hsts_source is missing from this installation"
  cmp -s "$hsts_source" "$hsts_target" 2>/dev/null && return 0
  hsts_previous=""
  if [ -f "$hsts_target" ]; then
    hsts_previous=$(mktemp)
    cat "$hsts_target" >"$hsts_previous"
  fi
  install -m 0644 "$hsts_source" "$hsts_target"
  if ! nginx_check=$(nginx -t 2>&1); then
    [ -z "$hsts_previous" ] || install -m 0644 "$hsts_previous" "$hsts_target"
    [ -z "$hsts_previous" ] || rm -f "$hsts_previous"
    fail "nginx rejected the HSTS change ($(nginx_refusal "$nginx_check")); the previous setting was restored"
  fi
  [ -z "$hsts_previous" ] || rm -f "$hsts_previous"
}

# nginx's own account of why it refused, for the record the owner reads: its last fault line, not
# the closing "test failed" that follows every fault. Discarding it once left a sandbox that could not write nginx's pid file reported as a
# rejected certificate for an afternoon.
nginx_refusal() {
  printf '%s\n' "$1" |
    awk '/\[(emerg|crit|alert)\]/ {fault = $0} /failed/ {other = $0} END {print (fault != "" ? fault : other)}' |
    sed 's/^.*\] [0-9#]*: //'
}

# Replacing the served certificate is only safe if nginx still accepts the result;
# otherwise the previous file goes back before anything reloads.
install_certificate() {
  new_certificate="$1"
  previous_certificate=""
  if [ -s "$certificate" ]; then
    previous_certificate=$(mktemp)
    cat "$certificate" >"$previous_certificate"
  fi
  install -m 0644 "$new_certificate" "$certificate"
  if ! nginx_check=$(nginx -t 2>&1); then
    if [ -n "$previous_certificate" ]; then
      install -m 0644 "$previous_certificate" "$certificate"
      rm -f "$previous_certificate"
    fi
    if [ "$new_certificate" != "$pending_certificate" ]; then
      install -d -m 0755 "$garden_state" 2>/dev/null || true
      install -m 0644 "$new_certificate" "$pending_certificate" 2>/dev/null || true
    fi
    fail "nginx rejected the new certificate ($(nginx_refusal "$nginx_check")); the previous certificate was restored and the new one kept for the next attempt"
  fi
  [ -z "$previous_certificate" ] || rm -f "$previous_certificate"
  rm -f "$pending_certificate"
  # After the certificate is known good, so a rejected certificate never leaves HSTS on behind it.
  if certificate_is_ca_issued; then set_hsts on; else set_hsts off; fi
  if systemctl is-active --quiet nginx.service; then
    systemctl reload nginx.service
  fi
}

# The kept certificate is used only while it is still the one the authority would issue now: it
# carries the pinned identity key, covers every configured name, and has more than a day left.
pending_certificate_usable() {
  [ -s "$pending_certificate" ] || return 1
  openssl x509 -in "$pending_certificate" -noout -checkend 86400 >/dev/null 2>&1 || return 1
  certificate_covers_configured_names "$pending_certificate" || return 1
  pending_fingerprint=$(
    openssl x509 -in "$pending_certificate" -noout -pubkey 2>/dev/null |
      openssl pkey -pubin -outform DER 2>/dev/null |
      openssl dgst -sha256 -binary |
      openssl base64 -A
  )
  [ -n "$pending_fingerprint" ] && [ "$pending_fingerprint" = "$(identity_fingerprint)" ]
}

identity_fingerprint() {
  openssl pkey -in "$identity_key" -pubout -outform DER 2>/dev/null |
    openssl dgst -sha256 -binary |
    openssl base64 -A
}

renew_certificate() {
  [ "$(control_value ACME_ENABLED)" = true ] || return 0
  # The margin has to be shorter than the certificate. A certificate covering an address lasts 160
  # hours, so the 30-day margin used for a 90-day certificate would mean "always due" and would
  # reissue on every timer firing.
  active_threshold="$renew_threshold_seconds"
  if openssl x509 -in "$certificate" -noout -ext subjectAltName 2>/dev/null |
    grep -q 'IP Address'; then
    active_threshold="$shortlived_renew_threshold_seconds"
  fi
  if certificate_is_ca_issued &&
    openssl x509 -in "$certificate" -noout -checkend "$active_threshold" >/dev/null 2>&1 &&
    certificate_covers_configured_names; then
    clear_renewal_failure
    return 0
  fi
  # issue_certificate exits on failure, taking the reason with it. Run it in a subshell so the
  # reason can be written down for the owner, then re-raise so the unit still counts as failed
  # and OnFailure= fires.
  renewal_status=0
  # Captured on the failing branch itself: after an `if` whose condition failed, `$?` is the
  # status of the `if`, which is zero, and the failure would be reported as a success.
  renewal_output=$(issue_certificate --skip-preflight 2>&1) || renewal_status=$?
  if [ "$renewal_status" -eq 0 ]; then
    printf '%s\n' "$renewal_output"
    clear_renewal_failure
    return 0
  fi
  printf '%s\n' "$renewal_output" >&2
  record_renewal_failure \
    "$(printf '%s' "$renewal_output" | awk 'NF {last = $0} END {print last}'); $(certificate_expiry_summary)"
  exit "$renewal_status"
}

# Started by OnFailure= on the renewal unit. Covers the case renew_certificate cannot: a run that
# was killed by its own start timeout, or that died before it could write anything down.
alert_renewal_failure() {
  [ -r "$certificate_error" ] ||
    record_renewal_failure "renewal did not finish; $(certificate_expiry_summary)"
  printf 'garden certificate: renewal failed - %s\n' \
    "$(sed -n '2p' "$certificate_error" 2>/dev/null)" >&2
  printf 'garden certificate: clients will see a security warning once the certificate expires. Run sudo garden certificate issue when DNS and inbound TCP 80 are working.\n' >&2
}

enable_acme() {
  agreed=""
  acme_email=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --agree-tos) agreed=yes; shift ;;
      --email) acme_email="${2:-}"; shift 2 ;;
      *) fail "usage: garden certificate enable --agree-tos --email you@example.com" ;;
    esac
  done
  case "$acme_email" in
    ?*@?*.?*) ;;
    *) fail "--email must be a contact address the certificate authority can reach" ;;
  esac
  [ "$agreed" = yes ] || fail "issuing a certificate accepts the certificate authority subscriber agreement on your behalf ($subscriber_agreement); re-run with --agree-tos to accept it"

  set_control_value ACME_EMAIL "$acme_email"
  set_control_value ACME_ENABLED true
  chmod 0600 "$control_env"
  systemctl enable --now garden-certificate-renew.timer >/dev/null 2>&1 || true
  issue_certificate "$@"
}

disable_acme() {
  set_control_value ACME_ENABLED false
  chmod 0600 "$control_env"
  systemctl disable --now garden-certificate-renew.timer >/dev/null 2>&1 || true
  # Nothing will renew from here on, so a recorded failure would keep alarming about a job that
  # is no longer scheduled.
  clear_renewal_failure
  if certificate_is_ca_issued; then
    # Before the trusted certificate goes, not after: a browser holding the header will not open a
    # box serving a self-signed certificate, and would have nowhere to be told otherwise.
    set_hsts off
    saved_certificate=$(mktemp)
    cat "$certificate" >"$saved_certificate"
    rm -f "$certificate"
    if "$network_refresh" && [ -s "$certificate" ]; then
      rm -f "$saved_certificate"
      printf 'Automatic renewal is off and the self-signed certificate is serving again.\n'
    else
      install -m 0644 "$saved_certificate" "$certificate"
      rm -f "$saved_certificate"
      fail "the self-signed certificate could not be rebuilt; the trusted certificate is still serving"
    fi
  else
    printf 'Automatic renewal is off.\n'
  fi
}

certificate_status() {
  if [ "$(control_value ACME_ENABLED)" = true ]; then
    printf 'Automatic issuance: on (%s)\n' "$(control_value ACME_EMAIL)"
  else
    printf 'Automatic issuance: off\n'
  fi
  if [ ! -s "$certificate" ]; then
    printf 'Certificate:        missing\n'
    return 0
  fi
  if certificate_is_ca_issued; then
    printf 'Certificate:        issued by a certificate authority\n'
  else
    printf 'Certificate:        self-signed, pinned by native clients\n'
  fi
  printf 'Issuer:             %s\n' \
    "$(openssl x509 -in "$certificate" -noout -issuer | sed 's/^issuer=//')"
  printf 'Expires:            %s\n' \
    "$(openssl x509 -in "$certificate" -noout -enddate | sed 's/^notAfter=//')"
  printf 'Names:              %s\n' "$(certificate_subject_alt_names | tr '\n' ' ')"
  if certificate_covers_configured_names; then
    printf 'Configured names:   all covered\n'
  else
    printf 'Configured names:   %s is not in the certificate; run sudo garden certificate issue\n' \
      "$(certificate_hostnames | tr '\n' ' ')"
  fi
  printf 'Renewal timer:      %s\n' \
    "$(systemctl is-enabled garden-certificate-renew.timer 2>/dev/null || printf 'not installed')"
  if [ -r "$certificate_error" ]; then
    printf 'Last renewal:       failed at %s - %s\n' \
      "$(sed -n '1p' "$certificate_error")" "$(sed -n '2p' "$certificate_error")"
  fi
}

[ "$(id -u)" -eq 0 ] || fail "run as root"
[ -r "$control_env" ] || fail "missing $control_env"

command_name="${1:-status}"
if [ "$#" -gt 0 ]; then shift; fi

case "$command_name" in
  status) certificate_status ;;
  enable) enable_acme "$@" ;;
  disable) disable_acme ;;
  issue) issue_certificate "$@" ;;
  renew) renew_certificate ;;
  alert-failed) alert_renewal_failure ;;
  *)
    printf '%s\n' \
      'Usage: garden certificate {status|enable --agree-tos --email ADDRESS|issue [--skip-preflight]|renew|disable}'
    exit 1
    ;;
esac
