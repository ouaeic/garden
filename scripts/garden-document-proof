#!/usr/bin/python3
"""Produce the documents the owner actually asks for, then measure the files that came out.

Every check here is an assertion about bytes on disk: how many pages the PDF has, whether its
fonts are embedded, whether the words that were placed on a slide are still in the render, whether
a workbook's formulas hold computed values after a real recalculation. Nothing passes because a
command exited 0.

Each job also builds a deliberately broken twin and asserts that the measurement catches it. A
check that cannot fail is not evidence, and the one-page CV check in particular is worthless
unless it is shown to notice a CV that ran onto a second page.

Jobs whose tools are absent are reported as skipped with the exact tools they needed. Pass
--require-all where every tool is meant to be present - the release drill does - and a skipped job
becomes a failure instead of a note.
"""

from __future__ import annotations

import argparse
import json
import math
import os
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from typing import Callable, NamedTuple

EMU_PER_POINT = 12700
A4_POINTS = (595.276, 841.89)
PLACEHOLDER_TOKENS = ("TODO", "Lorem", "{{", "XXX", "undefined", "NaN", "#REF!", "#VALUE!", "#N/A")

# Proportional sans faces average close to half their point size per glyph across running English
# text. It is an estimate, and it is only ever used to reject a slide before rendering; the
# authoritative overflow measurement is the word count that survives the render.
AVERAGE_GLYPH_ADVANCE = 0.5
LINE_HEIGHT = 1.2


class Failure(Exception):
    """A measurement that came out wrong. The message is the finding, not a stack trace."""


def tool(name: str) -> str | None:
    for candidate in (f"/usr/local/bin/{name}", f"/usr/bin/{name}"):
        if os.access(candidate, os.X_OK):
            return candidate
    return shutil.which(name)


def module(name: str) -> bool:
    import importlib.util

    try:
        return importlib.util.find_spec(name) is not None
    except (ImportError, ValueError):
        return False


def run(command: list[str], *, timeout: int = 300) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(command, check=False, capture_output=True, text=True, timeout=timeout)
    if result.returncode != 0:
        detail = (result.stderr or result.stdout or "").strip().splitlines()
        raise Failure(
            f"{Path(command[0]).name} exited {result.returncode}"
            + (f": {detail[-1]}" if detail else "")
        )
    return result


# --------------------------------------------------------------------------------------------
# PDF measurement, done through pypdf so that page geometry, font embedding and text extraction
# all come from one reader rather than three command-line tools that can disagree.
# --------------------------------------------------------------------------------------------


def pdf_pages(path: Path) -> int:
    from pypdf import PdfReader

    return len(PdfReader(str(path)).pages)


def pdf_page_size(path: Path, index: int = 0) -> tuple[float, float]:
    from pypdf import PdfReader

    box = PdfReader(str(path)).pages[index].mediabox
    return float(box.width), float(box.height)


def pdf_unembedded_fonts(path: Path) -> list[str]:
    """Font resources with no embedded font file, which is what shifts a layout on another machine."""
    from pypdf import PdfReader

    missing: set[str] = set()
    for page in PdfReader(str(path)).pages:
        resources = page.get("/Resources")
        fonts = resources.get("/Font") if resources else None
        if not fonts:
            continue
        for reference in fonts.values():
            font = reference.get_object()
            # A composite font carries its programme on the descendant, not on the parent.
            descendants = font.get("/DescendantFonts")
            holders = (
                [entry.get_object() for entry in descendants] if descendants else [font]
            )
            for holder in holders:
                descriptor = holder.get("/FontDescriptor")
                descriptor = descriptor.get_object() if descriptor else None
                embedded = descriptor and any(
                    key in descriptor for key in ("/FontFile", "/FontFile2", "/FontFile3")
                )
                if not embedded:
                    missing.add(str(font.get("/BaseFont", "unnamed")))
    return sorted(missing)


def pdf_text(path: Path) -> str:
    from pypdf import PdfReader

    return "\n".join(page.extract_text() or "" for page in PdfReader(str(path)).pages)


def words(text: str) -> list[str]:
    return [token for token in text.replace("­", "").split() if token]


def assert_no_placeholders(text: str, label: str) -> None:
    hits = [token for token in PLACEHOLDER_TOKENS if token in text]
    if hits:
        raise Failure(f"{label} still contains placeholder text: {', '.join(hits)}")


# --------------------------------------------------------------------------------------------
# Job 1 - a one-page CV, typeset. This is the document whose single most important property is
# that it is one page, and nothing about writing it guarantees that.
# --------------------------------------------------------------------------------------------

CV_TEMPLATE = """
#set document(title: "Curriculum vitae", author: "{name}")
#set page(paper: "a4", margin: (x: 1.8cm, y: 1.6cm))
#set text(size: 9.6pt)
#set par(justify: false, leading: 0.55em)
#show heading.where(level: 1): it => block(above: 0.9em, below: 0.45em)[
  #set text(size: 11pt, weight: 700); #upper(it.body)
  #v(-0.35em)
  #line(length: 100%, stroke: 0.6pt)
]

#block[
  #text(size: 19pt, weight: 700)[{name}]
  #v(-0.4em)
  #text(size: 9.4pt)[{headline}]
  #v(-0.5em)
  #text(size: 8.6pt)[{contact}]
]

= Profile
{profile}

= Experience
{experience}

= Selected projects
{projects}

= Education
{education}

= Skills
{skills}
"""

CV_ROLE = """
#grid(columns: (1fr, auto), gutter: 6pt,
  text(weight: 600)[{title} -- {employer}],
  text(size: 8.6pt)[{dates}],
)
#list(tight: true, spacing: 0.42em, {points})
"""


def cv_source(name: str, roles: list[dict[str, object]], bullet_repeat: int = 1) -> str:
    experience = "\n".join(
        CV_ROLE.format(
            title=role["title"],
            employer=role["employer"],
            dates=role["dates"],
            points=", ".join(
                f"[{point}]" for point in list(role["points"]) * bullet_repeat  # type: ignore[arg-type]
            ),
        )
        for role in roles
    )
    return CV_TEMPLATE.format(
        name=name,
        headline="Senior data engineer",
        # The backslash is not decoration: an unescaped @ starts a reference in Typst markup, and
        # every CV has an email address in it.
        contact="Cape Town  ·  +27 21 555 0134  ·  candidate\\@example.org",
        profile=(
            "Data engineer with fourteen years building batch and streaming pipelines for "
            "regulated financial reporting, most recently owning the ledger reconciliation "
            "platform end to end: its schema contracts, its overnight run, its on-call rotation "
            "and the cost model that pays for it."
        ),
        experience=experience,
        projects="#list(tight: true, spacing: 0.42em, "
        + ", ".join(f"[{project}]" for project in CV_PROJECTS)
        + ")",
        education=(
            "#grid(columns: (1fr, auto), gutter: 6pt,\n"
            "  text(weight: 600)[BSc Computer Science -- University of Cape Town],\n"
            "  text(size: 8.6pt)[2009 -- 2012],\n)\n"
            "Certified: AWS Solutions Architect (Associate), 2023."
        ),
        skills=(
            "Python, SQL, Spark, Airflow, dbt, PostgreSQL, Kafka, Terraform, AWS, Docker, "
            "Grafana, Great Expectations, Debezium, Parquet, Iceberg"
        ),
    )


# A full page, not a sparse one. A one-page check against a half-empty CV proves nothing, because
# the case that actually goes wrong is the CV with enough on it to nearly overflow.
CV_ROLES: list[dict[str, object]] = [
    {
        "title": "Lead data engineer",
        "employer": "Meridian Financial",
        "dates": "2021 -- present",
        "points": [
            "Rebuilt the nightly ledger reconciliation run from six hours to thirty-eight minutes, "
            "which moved the reporting deadline back inside the regulator's window.",
            "Introduced contract tests across twenty-four upstream feeds, cutting reporting "
            "incidents by two thirds year on year.",
            "Led a team of five through a migration to PostgreSQL with no reporting downtime and "
            "no change to any downstream consumer.",
            "Owned the on-call rotation and the incident review that came out of it.",
        ],
    },
    {
        "title": "Data engineer",
        "employer": "Kestrel Analytics",
        "dates": "2017 -- 2021",
        "points": [
            "Built the streaming ingest that carried four hundred million events a day at a "
            "ninety-ninth percentile latency under two seconds.",
            "Owned the warehouse cost model that reduced spend by forty-one percent over "
            "two quarters without reducing coverage.",
            "Mentored three graduates through their first production systems.",
        ],
    },
    {
        "title": "Analyst programmer",
        "employer": "Bellweather Group",
        "dates": "2014 -- 2017",
        "points": [
            "Automated the regulatory submissions previously assembled by hand each month, "
            "removing four days of manual work from every reporting cycle.",
            "Wrote the reconciliation rules engine still in use across three business units.",
            "Rebuilt the overnight batch schedule around explicit dependencies rather than "
            "start times, which ended the recurring Monday morning failures.",
        ],
    },
    {
        "title": "Junior developer",
        "employer": "Harbour Systems",
        "dates": "2012 -- 2014",
        "points": [
            "Maintained the settlement file exporters for two clearing houses.",
            "Added the first automated test suite the team had, covering the export formats.",
        ],
    },
]

CV_PROJECTS = [
    "*Ledger reconciliation platform.* Designed and shipped the service that reconciles nine "
    "million daily postings against three external custodians, with a replayable audit trail.",
    "*Feed contract framework.* An in-house schema contract and test harness now applied to "
    "every upstream feed, adopted by two other teams.",
    "*Warehouse cost model.* A per-query attribution model that made spend legible to the "
    "finance team and drove the reduction above.",
]


def job_cv(work: Path) -> list[tuple[str, str]]:
    typst = tool("typst")
    checks: list[tuple[str, str]] = []
    source = work / "cv.typ"
    source.write_text(cv_source("Thandiwe Nkosi", CV_ROLES), encoding="utf-8")
    pdf = work / "cv.pdf"
    result = run([typst, "compile", str(source), str(pdf)])  # type: ignore[list-item]
    if "convergence" in (result.stderr or "").lower():
        raise Failure("typst reported a layout convergence warning, so the pages are not stable")

    pages = pdf_pages(pdf)
    if pages != 1:
        raise Failure(f"the CV is {pages} pages; a CV that is meant to be one page is one page")
    checks.append(("one page", "1 page"))

    width, height = pdf_page_size(pdf)
    if abs(width - A4_POINTS[0]) > 1 or abs(height - A4_POINTS[1]) > 1:
        raise Failure(f"the CV page is {width:.0f}x{height:.0f}pt, which is not A4")
    checks.append(("A4 page geometry", f"{width:.0f}x{height:.0f}pt"))

    unembedded = pdf_unembedded_fonts(pdf)
    if unembedded:
        raise Failure(f"fonts are not embedded, so this reflows elsewhere: {', '.join(unembedded)}")
    checks.append(("every font embedded", "no unembedded font resource"))

    text = pdf_text(pdf)
    assert_no_placeholders(text, "the CV")
    flattened = " ".join(words(text))
    for needle in ("Thandiwe Nkosi", "Meridian Financial", "Kestrel Analytics", "Bellweather"):
        if needle not in flattened:
            raise Failure(f"the CV does not read back its own content: {needle!r} is missing")
    checks.append(("content extracts back out", f"{len(words(text))} words, every employer present"))

    # The twin: the same CV with each role's bullets tripled. If this still measures as one page,
    # the page-count check is not measuring anything.
    overlong = work / "cv-overlong.typ"
    overlong.write_text(cv_source("Thandiwe Nkosi", CV_ROLES, bullet_repeat=2), encoding="utf-8")
    overflow_pdf = work / "cv-overlong.pdf"
    run([typst, "compile", str(overlong), str(overflow_pdf)])  # type: ignore[list-item]
    overflow_pages = pdf_pages(overflow_pdf)
    if overflow_pages < 2:
        raise Failure(
            "a CV with twice the content still measured as one page, so the page count check "
            "proves nothing"
        )
    checks.append(("the check can fail", f"an overlong CV measured {overflow_pages} pages"))
    return checks


# --------------------------------------------------------------------------------------------
# Job 2 - a report with a table whose total is computed by the template, and the same PDF read
# back as a table so the extraction path is proven against a document we know the truth about.
# --------------------------------------------------------------------------------------------

REPORT_ROWS = [
    ("Northern Cape", 1200, 1450),
    ("Western Cape", 3100, 2980),
    ("Gauteng", 4500, 5210),
    ("KwaZulu-Natal", 2750, 3040),
]

REPORT_TEMPLATE = """
#set document(title: "Quarterly revenue")
#set page(paper: "a4", margin: 2cm, numbering: "1 / 1")
#set text(size: 10.5pt)
#let rows = {rows}
#let total = rows.map(r => r.at(1) + r.at(2)).sum()

= Quarterly revenue

Revenue by region for the first half, with the half-year total computed from the line items
rather than typed, so that changing a line changes the total.

#table(
  columns: (1fr, auto, auto, auto),
  align: (left, right, right, right),
  stroke: 0.5pt,
  table.header([Region], [Q1], [Q2], [Half year]),
  ..rows.map(r => (r.at(0), str(r.at(1)), str(r.at(2)), str(r.at(1) + r.at(2)))).flatten().map(c => [#c]),
  [Total], [], [], [#total],
)

The half-year total is #total.
"""


def build_report(work: Path) -> Path:
    pdf = work / "report.pdf"
    if pdf.is_file():
        return pdf
    rows_literal = (
        "(" + ", ".join(f'("{name}", {q1}, {q2})' for name, q1, q2 in REPORT_ROWS) + ",)"
    )
    source = work / "report.typ"
    source.write_text(REPORT_TEMPLATE.format(rows=rows_literal), encoding="utf-8")
    run([tool("typst"), "compile", str(source), str(pdf)])  # type: ignore[list-item]
    return pdf


def job_report(work: Path) -> list[tuple[str, str]]:
    checks: list[tuple[str, str]] = []
    pdf = build_report(work)

    expected_total = sum(q1 + q2 for _name, q1, q2 in REPORT_ROWS)
    text = pdf_text(pdf)
    assert_no_placeholders(text, "the report")
    if f"The half-year total is {expected_total}" not in " ".join(words(text)):
        raise Failure(
            f"the report's computed total is not {expected_total}; the template arithmetic and "
            "the source data disagree"
        )
    checks.append(("total computed from line items", f"{expected_total} matches the source rows"))

    unembedded = pdf_unembedded_fonts(pdf)
    if unembedded:
        raise Failure(f"fonts are not embedded: {', '.join(unembedded)}")
    checks.append(("every font embedded", f"{pdf_pages(pdf)} page(s), no unembedded font"))
    return checks


def job_tables(work: Path) -> list[tuple[str, str]]:
    """Read the report PDF back as a table and reconcile it against the numbers that made it."""
    extractor = tool("garden-pdf-tables") or str(Path(__file__).with_name("garden-pdf-tables"))
    pdf = build_report(work)
    result = subprocess.run(
        [sys.executable, extractor, "--path", pdf.name, "--page", "1"],
        check=False,
        capture_output=True,
        text=True,
        timeout=120,
        cwd=work,
    )
    if result.returncode != 0:
        raise Failure((result.stderr or "table extraction failed").strip().splitlines()[-1])
    payload = json.loads(result.stdout)
    extracted = [row["cells"] for row in payload["rows"]]
    expected = [["Region", "Q1", "Q2", "Half year"]] + [
        [name, str(q1), str(q2), str(q1 + q2)] for name, q1, q2 in REPORT_ROWS
    ]
    if extracted[: len(expected)] != expected:
        raise Failure(
            "the table read out of the PDF does not match the table that went in: "
            f"{extracted[: len(expected)]}"
        )
    reconciled = sum(int(row[3]) for row in extracted[1 : len(expected)])
    if reconciled != sum(q1 + q2 for _name, q1, q2 in REPORT_ROWS):
        raise Failure("the extracted half-year column does not sum to the source total")
    return [
        ("table round-trips through the PDF", f"{len(expected)} rows, 4 columns, exact match"),
        ("extracted column reconciles", f"half-year column sums to {reconciled}"),
    ]


# --------------------------------------------------------------------------------------------
# Job 3 - a slide deck, structurally sound and measured for the defect that has no error message:
# text that a placeholder silently clips instead of growing to fit.
# --------------------------------------------------------------------------------------------

DECK_SLIDES = [
    (
        "Where the quarter landed",
        [
            "Revenue reached 18.4 million, 6 percent ahead of plan",
            "Gauteng carried the growth; Northern Cape was flat",
            "Cost to serve fell for the third consecutive quarter",
        ],
    ),
    (
        "What changed",
        [
            "Reconciliation moved from six hours to thirty-eight minutes",
            "Contract tests now cover twenty-four upstream feeds",
            "Two thirds fewer reporting incidents than the same quarter last year",
        ],
    ),
    (
        "What we are asking for",
        [
            "Two engineers to finish the ledger migration",
            "A decision on the warehouse contract before the end of month",
        ],
    ),
]


def lines_needed(paragraphs: list[str], width_emu: int, size_points: float) -> int:
    width_points = width_emu / EMU_PER_POINT
    characters_per_line = max(1, int(width_points / (size_points * AVERAGE_GLYPH_ADVANCE)))
    return sum(max(1, math.ceil(len(text) / characters_per_line)) for text in paragraphs)


def build_deck(path: Path, bullets: list[tuple[str, list[str]]], body_points: float) -> int:
    """Build the deck the way pptx-authoring prescribes, including the 16:9 repositioning.

    python-pptx's own starting template is 10x7.5 inches and its layout placeholders are 9 inches
    wide. Widening the slide to 16:9 does not widen them, so a deck that only sets the slide size
    lays every bullet out inside the left three quarters of the slide and leaves a bar of dead
    space down the right. Placing the two placeholders from the slide's own dimensions is what
    makes the size change real.
    """
    from pptx import Presentation
    from pptx.chart.data import CategoryChartData
    from pptx.enum.chart import XL_CHART_TYPE
    from pptx.enum.text import MSO_AUTO_SIZE
    from pptx.util import Inches, Pt

    presentation = Presentation()
    presentation.slide_width = Inches(13.333)
    presentation.slide_height = Inches(7.5)
    margin = Inches(0.6)
    text_width = presentation.slide_width - 2 * margin
    body_top = Inches(1.75)
    body_height = presentation.slide_height - body_top - Inches(0.6)

    layout = presentation.slide_layouts[1]
    placed = 0
    for title, points in bullets:
        slide = presentation.slides.add_slide(layout)
        heading = slide.shapes.title
        heading.left, heading.top = margin, Inches(0.45)
        heading.width, heading.height = text_width, Inches(1.1)
        heading.text = title
        placed += len(title.split())
        body = slide.placeholders[1]
        body.left, body.top = margin, body_top
        body.width, body.height = text_width, body_height
        frame = body.text_frame
        frame.word_wrap = True
        frame.auto_size = MSO_AUTO_SIZE.NONE
        frame.text = points[0]
        for point in points[1:]:
            frame.add_paragraph().text = point
        for paragraph in frame.paragraphs:
            for piece in paragraph.runs:
                piece.font.size = Pt(body_points)
        placed += sum(len(point.split()) for point in points)
        slide.notes_slide.notes_text_frame.text = f"Speaker note for: {title}"

    chart_slide = presentation.slides.add_slide(presentation.slide_layouts[5])
    heading = chart_slide.shapes.title
    heading.left, heading.top = margin, Inches(0.45)
    heading.width, heading.height = text_width, Inches(1.1)
    heading.text = "Revenue by region"
    placed += 3
    data = CategoryChartData()
    data.categories = [name for name, _q1, _q2 in REPORT_ROWS]
    data.add_series("Q1", tuple(q1 for _name, q1, _q2 in REPORT_ROWS))
    data.add_series("Q2", tuple(q2 for _name, _q1, q2 in REPORT_ROWS))
    chart_slide.shapes.add_chart(
        XL_CHART_TYPE.COLUMN_CLUSTERED, margin, body_top, text_width, body_height, data
    )
    chart_slide.notes_slide.notes_text_frame.text = "Both quarters, same axis."
    presentation.save(str(path))
    return placed


def deck_overflows(path: Path, body_points: float) -> list[str]:
    from pptx import Presentation

    over: list[str] = []
    for index, slide in enumerate(Presentation(str(path)).slides, 1):
        for shape in slide.shapes:
            if not shape.has_text_frame or not shape.text_frame.text.strip():
                continue
            paragraphs = [
                paragraph.text for paragraph in shape.text_frame.paragraphs if paragraph.text
            ]
            if not paragraphs:
                continue
            size = next(
                (
                    piece.font.size.pt
                    for paragraph in shape.text_frame.paragraphs
                    for piece in paragraph.runs
                    if piece.font.size is not None
                ),
                body_points,
            )
            required = lines_needed(paragraphs, shape.width, size)
            available = max(1, int((shape.height / EMU_PER_POINT) / (size * LINE_HEIGHT)))
            if required > available:
                over.append(f"slide {index}: needs {required} lines, box holds {available}")
    return over


def job_deck(work: Path) -> list[tuple[str, str]]:
    from pptx import Presentation

    checks: list[tuple[str, str]] = []
    deck = work / "deck.pptx"
    placed = build_deck(deck, DECK_SLIDES, body_points=18)

    reopened = Presentation(str(deck))
    slides = list(reopened.slides)
    if len(slides) != len(DECK_SLIDES) + 1:
        raise Failure(f"the deck reopened with {len(slides)} slides, not {len(DECK_SLIDES) + 1}")
    if any(not slide.has_notes_slide for slide in slides):
        raise Failure("a slide has no speaker notes, so the deck is not usable by a presenter")
    charts = [shape for slide in slides for shape in slide.shapes if shape.has_chart]
    if not charts:
        raise Failure("the chart is not a native chart, so the owner cannot edit its data")
    checks.append(
        ("structure", f"{len(slides)} slides, notes on every slide, {len(charts)} native chart")
    )

    overflowing = deck_overflows(deck, body_points=18)
    if overflowing:
        raise Failure("text does not fit its box: " + "; ".join(overflowing))
    checks.append(("every text box holds its text", f"{placed} words placed, none over capacity"))

    # The twin: the same slides with four times the bullets, which is what a deck built from an
    # over-long outline looks like. If this is not caught, the fit check is decoration.
    overfull = work / "deck-overfull.pptx"
    crowded = [(title, [" ".join(points)] * 12) for title, points in DECK_SLIDES]
    build_deck(overfull, crowded, body_points=18)
    caught = deck_overflows(overfull, body_points=18)
    if not caught:
        raise Failure("a deck with twelve paragraphs a slide measured as fitting; the check is inert")
    checks.append(("the check can fail", f"an over-filled deck was caught: {caught[0]}"))

    converter = tool("garden-office-convert")
    if not converter:
        return checks
    pdf = work / "deck.pdf"
    run([sys.executable, converter, str(deck), str(pdf)], timeout=420)
    pages = pdf_pages(pdf)
    if pages != len(slides):
        raise Failure(f"the deck rendered {pages} pages for {len(slides)} slides")
    checks.append(("renders one page per slide", f"{pages} pages"))

    rendered = words(pdf_text(pdf))
    # Notes are not rendered, and the chart contributes its own axis labels, so the test is that
    # nothing was lost rather than that the counts are equal.
    survived = len(rendered)
    if survived < placed * 0.98:
        raise Failure(
            f"{placed - survived} of {placed} placed words are missing from the render, which is "
            "what a clipped text box looks like"
        )
    checks.append(("no word lost in the render", f"{survived} words survived of {placed} placed"))

    if tool("pdftoppm") and module("PIL"):
        coverage = page_ink(work, pdf)
        blank = [index for index, value in enumerate(coverage, 1) if value < 0.002]
        if blank:
            raise Failure(f"rendered slide(s) {blank} are blank")
        checks.append(
            (
                "no blank slide in the render",
                "ink coverage " + ", ".join(f"{value:.1%}" for value in coverage),
            )
        )
    return checks


def page_ink(work: Path, pdf: Path) -> list[float]:
    """Fraction of non-white pixels per rendered page - the only way to see an empty slide."""
    from PIL import Image

    proofs = work / "proofs"
    if proofs.exists():
        shutil.rmtree(proofs)
    proofs.mkdir()
    run([tool("pdftoppm"), "-jpeg", "-r", "60", str(pdf), str(proofs / "p")])  # type: ignore[list-item]
    coverage: list[float] = []
    for image_path in sorted(proofs.glob("p-*.jpg")):
        with Image.open(image_path) as image:
            grey = image.convert("L")
            histogram = grey.histogram()
            dark = sum(histogram[:240])
            coverage.append(dark / max(1, sum(histogram)))
    return coverage


# --------------------------------------------------------------------------------------------
# Job 4 - a workbook whose formulas are formulas, recalculated for real, with the answers checked
# against arithmetic done independently in Python.
# --------------------------------------------------------------------------------------------

WORKBOOK_UNITS = [12, 3, 24, 8]
WORKBOOK_PRICES = [400.0, 425.5, 120.0, 92.25]


def build_workbook(path: Path, *, broken: bool = False) -> None:
    from openpyxl import Workbook
    from openpyxl.styles import Font
    from openpyxl.workbook.defined_name import DefinedName

    workbook = Workbook()
    assumptions = workbook.active
    assumptions.title = "Assumptions"
    assumptions["A1"] = "Input"
    assumptions["B1"] = "Value"
    assumptions["A1"].font = Font(bold=True)
    assumptions["B1"].font = Font(bold=True)
    assumptions["A2"] = "VAT rate"
    assumptions["B2"] = 0.15
    assumptions["B2"].number_format = "0.0%"
    workbook.defined_names.add(DefinedName("vat_rate", attr_text="Assumptions!$B$2"))

    data = workbook.create_sheet("Data")
    for column, header in enumerate(["Line", "Units", "Unit price"], start=1):
        cell = data.cell(row=1, column=column, value=header)
        cell.font = Font(bold=True)
    for index, (units, price) in enumerate(zip(WORKBOOK_UNITS, WORKBOOK_PRICES), start=2):
        data.cell(row=index, column=1, value=f"Line {index - 1}")
        data.cell(row=index, column=2, value=units)
        cell = data.cell(row=index, column=3, value=price)
        cell.number_format = '"R"#,##0.00'
    data.freeze_panes = "A2"

    model = workbook.create_sheet("Model")
    model["A1"] = "Line"
    model["B1"] = "Net"
    model["C1"] = "VAT"
    model["D1"] = "Gross"
    for index in range(2, len(WORKBOOK_UNITS) + 2):
        model.cell(row=index, column=1, value=f"=Data!A{index}")
        model.cell(row=index, column=2, value=f"=Data!B{index}*Data!C{index}")
        model.cell(row=index, column=3, value=f"=ROUND(B{index}*vat_rate,2)")
        model.cell(row=index, column=4, value=f"=B{index}+C{index}")
    last = len(WORKBOOK_UNITS) + 1
    model["A7"] = "Total"
    model["B7"] = f"=SUM(B2:B{last})"
    model["C7"] = f"=SUM(C2:C{last})"
    # XLOOKUP is exactly the modern function LibreOffice cannot evaluate, so the broken twin uses
    # it to prove the error-cell count is measuring the recalculation and not the write.
    model["D7"] = "=XLOOKUP(1,B2:B5,B2:B5)" if broken else f"=SUM(D2:D{last})"
    for row in model.iter_rows(min_row=2, min_col=2, max_col=4):
        for cell in row:
            cell.number_format = '"R"#,##0.00'
    workbook.save(str(path))


# Functions LibreOffice cannot evaluate. A workbook containing one of these looks perfect until
# the recalculation, at which point every cell that depends on it is an error - so the cheap scan
# runs before the expensive round trip.
FORBIDDEN_FUNCTIONS = (
    "XLOOKUP",
    "XMATCH",
    "SORTBY",
    "FILTER(",
    "UNIQUE(",
    "SEQUENCE(",
    "LET(",
    "LAMBDA(",
    "TEXTSPLIT",
)


def forbidden_formulas(path: Path) -> list[str]:
    from openpyxl import load_workbook

    workbook = load_workbook(str(path))
    return [
        f"{sheet.title}!{cell.coordinate} uses {name.rstrip('(')}"
        for sheet in workbook
        for row in sheet.iter_rows()
        for cell in row
        if isinstance(cell.value, str) and cell.value.startswith("=")
        for name in FORBIDDEN_FUNCTIONS
        if name in cell.value.upper()
    ]


def error_cells(path: Path) -> list[str]:
    from openpyxl import load_workbook

    workbook = load_workbook(str(path), data_only=True)
    return [
        f"{sheet.title}!{cell.coordinate}={cell.value}"
        for sheet in workbook
        for row in sheet.iter_rows()
        for cell in row
        if isinstance(cell.value, str) and cell.value.startswith("#")
    ]


def job_workbook(work: Path) -> list[tuple[str, str]]:
    from openpyxl import load_workbook

    checks: list[tuple[str, str]] = []
    book = work / "model.xlsx"
    build_workbook(book)

    written = load_workbook(str(book))
    formulas = [
        cell.value
        for row in written["Model"].iter_rows(min_row=2)
        for cell in row
        if isinstance(cell.value, str) and cell.value.startswith("=")
    ]
    if len(formulas) < 16:
        raise Failure(f"only {len(formulas)} cells hold formulas; the derived cells are values")
    if "vat_rate" not in written.defined_names:
        raise Failure("the workbook has no named input, so its formulas are unreviewable")
    checks.append(("derived cells are formulas", f"{len(formulas)} formulas, 1 named input"))

    forbidden = forbidden_formulas(book)
    if forbidden:
        raise Failure("the workbook uses a function LibreOffice cannot evaluate: " + forbidden[0])
    checks.append(("every formula survives recalculation", "no unevaluable function written"))

    broken = work / "model-broken.xlsx"
    build_workbook(broken, broken=True)
    if not forbidden_formulas(broken):
        raise Failure(
            "a workbook written with XLOOKUP was not flagged, so the unevaluable-function scan "
            "is inert"
        )
    checks.append(("the check can fail", "an XLOOKUP workbook was flagged before any conversion"))

    converter = tool("garden-office-convert")
    if not converter:
        return checks
    recalculated = work / "model.recalc.xlsx"
    run([sys.executable, converter, str(book), str(recalculated)], timeout=420)

    errors = error_cells(recalculated)
    if errors:
        raise Failure("the recalculated workbook has error cells: " + ", ".join(errors[:5]))
    values = load_workbook(str(recalculated), data_only=True)["Model"]
    net = [values.cell(row=index, column=2).value for index in range(2, 6)]
    if any(value is None for value in net):
        raise Failure(
            "the recalculated workbook has no computed values, so the owner opens it to blanks"
        )
    expected_net = [units * price for units, price in zip(WORKBOOK_UNITS, WORKBOOK_PRICES)]
    if [round(float(value), 2) for value in net] != [round(value, 2) for value in expected_net]:
        raise Failure(f"recalculated line totals {net} do not match {expected_net}")
    expected_total = round(sum(expected_net), 2)
    total = round(float(values["B7"].value), 2)
    if total != expected_total:
        raise Failure(f"the recalculated grand total is {total}, not {expected_total}")
    checks.append(
        ("formulas recalculate to the right numbers", f"grand total {total} computed by the sheet")
    )

    broken_recalculated = work / "model-broken.recalc.xlsx"
    run([sys.executable, converter, str(broken), str(broken_recalculated)], timeout=420)
    if not error_cells(broken_recalculated):
        raise Failure(
            "a workbook using XLOOKUP recalculated without a single error cell, so the error "
            "count is not measuring the recalculation"
        )
    checks.append(
        ("error cells are counted after a real recalculation", "the XLOOKUP twin came back in error")
    )
    return checks


# --------------------------------------------------------------------------------------------
# Job 5 - a Word document with real styles, converted and read back.
# --------------------------------------------------------------------------------------------


def job_letter(work: Path) -> list[tuple[str, str]]:
    from docx import Document
    from docx.shared import Pt

    checks: list[tuple[str, str]] = []
    path = work / "letter.docx"
    document = Document()
    document.add_heading("Reconciliation platform review", level=1)
    document.add_paragraph(
        "This note records the state of the ledger reconciliation platform at the end of the "
        "quarter, the two decisions outstanding, and what each of them costs to defer."
    )
    document.add_heading("Findings", level=2)
    for finding in (
        "The nightly run now completes in thirty-eight minutes.",
        "Twenty-four upstream feeds are covered by contract tests.",
        "Reporting incidents are down by two thirds year on year.",
    ):
        document.add_paragraph(finding, style="List Bullet")
    document.add_heading("Revenue by region", level=2)
    table = document.add_table(rows=1, cols=4)
    table.style = "Table Grid"
    for index, header in enumerate(["Region", "Q1", "Q2", "Half year"]):
        cell = table.rows[0].cells[index]
        cell.text = header
        cell.paragraphs[0].runs[0].font.bold = True
    for name, q1, q2 in REPORT_ROWS:
        cells = table.add_row().cells
        for index, value in enumerate([name, str(q1), str(q2), str(q1 + q2)]):
            cells[index].text = value
    document.styles["Normal"].font.size = Pt(11)
    document.save(str(path))

    reopened = Document(str(path))
    headings = [
        paragraph.style.name
        for paragraph in reopened.paragraphs
        if paragraph.style.name.startswith("Heading")
    ]
    if len(headings) < 3:
        raise Failure(
            f"only {len(headings)} paragraphs use a heading style, so the document has no "
            "navigation and a table of contents would come out empty"
        )
    if len(reopened.tables) != 1 or len(reopened.tables[0].rows) != len(REPORT_ROWS) + 1:
        raise Failure("the table did not survive the write")
    checks.append(("real styles, real table", f"{len(headings)} headings, 1 table with 5 rows"))

    converter = tool("garden-office-convert")
    if not converter:
        return checks
    pdf = work / "letter.pdf"
    run([sys.executable, converter, str(path), str(pdf)], timeout=420)
    text = pdf_text(pdf)
    assert_no_placeholders(text, "the letter")
    flattened = " ".join(words(text))
    missing = [
        name for name, _q1, _q2 in REPORT_ROWS if name.replace("-", "") not in flattened.replace("-", "")
    ]
    if missing:
        raise Failure(f"the rendered PDF lost table rows: {', '.join(missing)}")
    unembedded = pdf_unembedded_fonts(pdf)
    if unembedded:
        raise Failure(f"fonts are not embedded in the converted PDF: {', '.join(unembedded)}")
    checks.append(
        (
            "converts with every row and every font intact",
            f"{pdf_pages(pdf)} page(s), {len(words(text))} words, no unembedded font",
        )
    )
    return checks


# --------------------------------------------------------------------------------------------


def require_equal(actual: object, expected: object, description: str) -> None:
    if actual != expected:
        raise Failure(f"{description}: expected {expected!r}, got {actual!r}")


def rejects(check: Callable[[], object], description: str) -> None:
    try:
        check()
    except (Failure, AssertionError, ValueError):
        return
    raise Failure(f"the check accepted {description}")


def job_parquet(work: Path) -> list[tuple[str, str]]:
    import pandas as pd

    original = pd.DataFrame({
        "id": pd.Series([1, None, 3], dtype="Int64"),
        "label": pd.Series(["α", None, "third"], dtype="string"),
        "time": pd.to_datetime(["2026-01-01", None, "2026-01-03"], utc=True),
        "value": [0.25, -2.5, float("nan")],
    })
    target = work / "typed-table.parquet"
    original.to_parquet(target, engine="pyarrow", index=False)
    restored = pd.read_parquet(target, engine="pyarrow")
    pd.testing.assert_frame_equal(restored, original, check_exact=True)
    broken = restored.copy()
    broken.loc[0, "id"] = 99
    rejects(lambda: pd.testing.assert_frame_equal(broken, original), "a changed Parquet value")
    return [("typed table round trip", "values, nullable types, Unicode and UTC timestamps retained"),
            ("the check can fail", "a changed value fails the exact frame comparison")]


def job_data(work: Path) -> list[tuple[str, str]]:
    import pandas as pd
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt

    source = work / "observations.csv"
    source.write_text("group,value\na,1\na,3\nb,8\nb,\n", encoding="utf-8")
    table = pd.read_csv(source)
    result = table.groupby("group")["value"].agg(["mean", "count"])
    measured = result["mean"].to_dict()
    require_equal(measured, {"a": 2.0, "b": 8.0}, "group means")
    require_equal(result["count"].to_dict(), {"a": 2, "b": 1}, "missing-value counts")
    figure, axes = plt.subplots()
    result["mean"].plot.bar(ax=axes)
    plot = work / "group-means.svg"
    figure.savefig(plot)
    plt.close(figure)
    if "<svg" not in plot.read_text(encoding="utf-8"):
        raise Failure("the chart is not an SVG document")
    rejects(lambda: require_equal({"a": 3.0, "b": 8.0}, measured, "group means"), "an incorrect mean")
    return [("CSV analysis and chart", "missing values excluded, group counts and means reconciled, SVG produced"),
            ("the check can fail", "an incorrect mean is rejected")]


def job_statistics(work: Path) -> list[tuple[str, str]]:
    import numpy as np
    from scipy import stats
    import statsmodels.api as sm

    x = np.arange(5, dtype=float)
    y = 1 + 2 * x + np.array([0.2, -0.1, -0.2, -0.1, 0.2])
    fitted = sm.OLS(y, sm.add_constant(x)).fit()
    np.testing.assert_allclose(fitted.params, [1, 2], rtol=0, atol=1e-12)
    interval = fitted.conf_int(alpha=0.05)[1]
    if not interval[0] < 2 < interval[1]:
        raise Failure("the slope interval does not contain the known slope")
    test = stats.ttest_1samp(y, 5)
    if abs(test.statistic) > 1e-12 or abs(test.pvalue - 1) > 1e-12:
        raise Failure("the known-mean t-test is inconsistent")
    (work / "statistics.json").write_text(json.dumps({
        "coefficients": fitted.params.tolist(), "slope95": interval.tolist(),
        "testP": float(test.pvalue), "observations": len(y),
    }), encoding="utf-8")
    rejects(lambda: np.testing.assert_allclose(fitted.params, [1, 3]), "an incorrect slope")
    return [("regression and inference", "known coefficients, confidence interval and null mean reconciled"),
            ("the check can fail", "an incorrect slope is rejected")]


def job_pdf_form(work: Path) -> list[tuple[str, str]]:
    from pypdf import PdfReader, PdfWriter
    from pypdf.generic import (ArrayObject, BooleanObject, DictionaryObject,
                               FloatObject, NameObject, TextStringObject)

    original = work / "form-blank.pdf"
    writer = PdfWriter()
    page = writer.add_blank_page(width=300, height=200)
    field = DictionaryObject({
        NameObject("/Type"): NameObject("/Annot"), NameObject("/Subtype"): NameObject("/Widget"),
        NameObject("/FT"): NameObject("/Tx"), NameObject("/T"): TextStringObject("owner"),
        NameObject("/V"): TextStringObject(""),
        NameObject("/Rect"): ArrayObject([FloatObject(n) for n in [20, 100, 250, 140]]),
    })
    reference = writer._add_object(field)
    page[NameObject("/Annots")] = ArrayObject([reference])
    writer._root_object[NameObject("/AcroForm")] = DictionaryObject({
        NameObject("/Fields"): ArrayObject([reference]),
        NameObject("/NeedAppearances"): BooleanObject(True),
    })
    writer.write(original)
    filled = PdfWriter(clone_from=original)
    filled.update_page_form_field_values(filled.pages[0], {"owner": "Garden owner"}, auto_regenerate=False)
    target = work / "form-filled.pdf"
    filled.write(target)
    fields = PdfReader(target).get_fields()
    require_equal((fields or {}).get("owner", {}).get("/V"), "Garden owner", "filled form field")
    rejects(lambda: require_equal((PdfReader(original).get_fields() or {})["owner"]["/V"],
                                  "Garden owner", "filled form field"), "an unfilled form")
    return [("PDF form round trip", "field enumerated, filled, saved and read back"),
            ("the check can fail", "the unfilled twin is rejected")]


def job_media(work: Path) -> list[tuple[str, str]]:
    target = work / "tone.wav"
    run([tool("ffmpeg") or "ffmpeg", "-hide_banner", "-loglevel", "error", "-y",
         "-f", "lavfi", "-i", "sine=frequency=440:duration=1", "-ar", "16000", "-ac", "1", str(target)])
    result = run([tool("ffprobe") or "ffprobe", "-v", "error", "-show_streams", "-show_format",
                  "-of", "json", str(target)])
    report = json.loads(result.stdout)
    streams = report["streams"]
    if len(streams) != 1:
        raise Failure("expected one audio stream")
    measured = (streams[0]["codec_type"], streams[0]["sample_rate"], streams[0]["channels"])
    require_equal(measured, ("audio", "16000", 1), "audio format")
    if abs(float(report["format"]["duration"]) - 1) > 0.01:
        raise Failure("the encoded duration changed")
    rejects(lambda: require_equal(measured, ("audio", "48000", 2), "audio format"), "an incorrect audio format")
    return [("audio encoding and inspection", "one-second mono PCM at the requested sample rate"),
            ("the check can fail", "an incorrect channel and sample-rate claim is rejected")]


def job_pdf_assembly(work: Path) -> list[tuple[str, str]]:
    from PIL import Image
    from pypdf import PdfReader

    raster = work / "assembly-page.png"
    Image.new("RGB", (200, 100), (20, 90, 140)).save(raster)
    single = work / "assembly-single.pdf"
    merged = work / "assembly-merged.pdf"
    run([tool("img2pdf") or "img2pdf", str(raster), "-o", str(single)])
    run([tool("qpdf") or "qpdf", "--empty", "--pages", str(single), "1", str(single), "1", "--", str(merged)])
    run([tool("qpdf") or "qpdf", "--check", str(merged)])
    require_equal(len(PdfReader(merged).pages), 2, "merged page count")
    rejects(lambda: require_equal(len(PdfReader(single).pages), 2, "merged page count"), "a missing page")
    return [("PDF assembly", "a raster page converted, duplicated into a valid PDF and counted"),
            ("the check can fail", "a missing page is rejected")]


def job_images(work: Path) -> list[tuple[str, str]]:
    from PIL import Image
    import xml.etree.ElementTree as ET

    original = Image.new("RGBA", (100, 60), (255, 0, 0, 255))
    original.paste((0, 0, 255, 255), (50, 0, 100, 60))
    cropped = original.crop((50, 0, 100, 60)).resize((25, 30))
    target = work / "crop.png"
    cropped.save(target)
    with Image.open(target) as restored:
        require_equal(restored.size, (25, 30), "image geometry")
        require_equal(restored.getpixel((12, 15)), (0, 0, 255, 255), "cropped pixel")
    source = work / "flow.dot"
    source.write_text('digraph flow { input -> result; }', encoding="utf-8")
    diagram = work / "flow.svg"
    run([tool("dot") or "dot", "-Tsvg", str(source), "-o", str(diagram)])
    root = ET.parse(diagram).getroot()
    texts = [element.text for element in root.iter() if element.tag.endswith("}text")]
    if "input" not in texts or "result" not in texts:
        raise Failure("the rendered graph lost a node label")
    rejects(lambda: require_equal(original.size, (25, 30), "image geometry"), "an uncropped image")
    return [("image and diagram output", "crop pixels and geometry read back; graph labels retained in SVG"),
            ("the check can fail", "the original uncropped image fails the geometry check")]


class Job(NamedTuple):
    id: str
    purpose: str
    binaries: tuple[str, ...]
    modules: tuple[str, ...]
    # What the render half of the job needs. Its absence costs the render measurements and
    # nothing else, so the structural half still runs and still reports - except under
    # --require-all, where a box missing any of it is a box that cannot finish a document job.
    rendering: tuple[str, ...]
    run: Callable[[Path], list[tuple[str, str]]]
    capabilities: tuple[str, ...]


JOBS: tuple[Job, ...] = (
    Job("cv", "A one-page CV, typeset to a PDF", ("typst",), ("pypdf",), (), job_cv, ("typeset-pdf", "document-fonts")),
    Job(
        "report",
        "A report whose totals are computed by the template",
        ("typst",),
        ("pypdf",),
        (),
        job_report,
        ('typeset-pdf', 'document-fonts'),
    ),
    Job(
        "tables",
        "The report's own table, read back out of the PDF",
        ("typst", "pdftotext"),
        ("pypdf",),
        (),
        job_tables,
        ('pdf-extraction',),
    ),
    Job(
        "deck",
        "An editable slide deck that does not clip its own text",
        (),
        ("pptx",),
        ("garden-office-convert", "pdftoppm", "pypdf", "PIL"),
        job_deck,
        ('office-authoring', 'office-conversion'),
    ),
    Job(
        "workbook",
        "A spreadsheet whose formulas recalculate",
        (),
        ("openpyxl",),
        ("garden-office-convert",),
        job_workbook,
        ('office-authoring', 'office-conversion'),
    ),
    Job(
        "letter",
        "A Word document with real styles, converted to PDF",
        (),
        ("docx",),
        ("garden-office-convert", "pypdf"),
        job_letter,
        ('office-authoring', 'office-conversion'),
    ),
    Job("parquet", "A typed Parquet table saved and read back", (), ("pandas", "pyarrow"), (), job_parquet, ("parquet-data",)),
    Job("data", "CSV aggregation and a saved chart", (), ("pandas", "matplotlib"), (), job_data, ("data-analysis",)),
    Job("statistics", "Regression and inference against known coefficients", (), ("scipy", "statsmodels"), (), job_statistics, ("statistics",)),
    Job("pdf-form", "A PDF form field filled and read back", (), ("pypdf",), (), job_pdf_form, ("pdf-forms",)),
    Job("media", "Audio encoded and inspected", ("ffmpeg", "ffprobe"), (), (), job_media, ("media",)),
    Job("pdf-assembly", "Raster conversion and PDF page assembly", ("qpdf", "img2pdf"), ("PIL", "pypdf"), (), job_pdf_assembly, ("pdf-assembly",)),
    Job("images", "Image geometry and diagram labels read back", ("dot",), ("PIL",), (), job_images, ("image-work",)),
)


def absent(*groups: tuple[str, ...]) -> list[str]:
    """A name is present if it imports or if it runs; which of the two it is does not matter here."""
    return [name for group in groups for name in group if not module(name) and not tool(name)]


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="garden-document-proof",
        description=(
            "Build a CV, a report, a slide deck, a spreadsheet and a Word document with the "
            "document toolchain on this computer, then measure the files that came out."
        ),
    )
    parser.add_argument("--workdir", type=Path, help="where to build; a temporary directory by default")
    parser.add_argument("--keep", action="store_true", help="leave the built documents behind")
    parser.add_argument("--only", action="append", help="run only these jobs, by id")
    parser.add_argument(
        "--require-all",
        action="store_true",
        help="treat a job that cannot run for want of a tool as a failure",
    )
    parser.add_argument("--manifest", action="store_true", help="list representative workflow contracts without running them")
    parser.add_argument("--json", action="store_true", help="machine-readable report on stdout")
    arguments = parser.parse_args()
    if arguments.manifest:
        json.dump([{"id": job.id, "purpose": job.purpose, "capabilities": job.capabilities,
                    "binaries": job.binaries, "modules": job.modules, "rendering": job.rendering}
                   for job in JOBS], sys.stdout)
        sys.stdout.write("\n")
        return 0
    unknown = set(arguments.only or ()) - {job.id for job in JOBS}
    if unknown:
        parser.error(f"unknown jobs: {', '.join(sorted(unknown))}")

    scratch = arguments.workdir or Path(tempfile.mkdtemp(prefix="garden-document-proof-"))
    scratch.mkdir(parents=True, exist_ok=True)
    selected = [job for job in JOBS if not arguments.only or job.id in arguments.only]

    results: list[dict[str, object]] = []
    try:
        for job in selected:
            blocking = absent(job.binaries, job.modules)
            unrendered = absent(job.rendering)
            if arguments.require_all:
                blocking = blocking + unrendered
            if blocking:
                results.append(
                    {
                        "id": job.id,
                        "purpose": job.purpose,
                        "capabilities": job.capabilities,
                        "status": "skipped",
                        "missing": blocking,
                        "checks": [],
                    }
                )
                continue
            started = time.monotonic()
            try:
                checks = job.run(scratch)
                status, detail = "passed", None
            except Failure as error:
                checks, status, detail = [], "failed", str(error)
            except Exception as error:  # noqa: BLE001 - any breakage here is a real finding
                checks, status, detail = [], "failed", f"{type(error).__name__}: {error}"
            results.append(
                {
                    "id": job.id,
                    "purpose": job.purpose,
                    "capabilities": job.capabilities,
                    "status": status,
                    # Named on a passing job too, because "passed" without this line would read
                    # as though the render was measured when it was not.
                    "notExercised": unrendered,
                    "durationMs": int((time.monotonic() - started) * 1000),
                    "checks": [{"name": name, "detail": value} for name, value in checks],
                    **({"failure": detail} if detail else {}),
                }
            )
    finally:
        if not arguments.keep and not arguments.workdir:
            shutil.rmtree(scratch, ignore_errors=True)

    failed = [result for result in results if result["status"] == "failed"]
    skipped = [result for result in results if result["status"] == "skipped"]
    # Under --require-all a skip is a failure, because the caller has said every tool is meant to
    # be here. Anywhere else a skip is a fact about the machine and not a defect in the documents.
    unacceptable = bool(failed) or bool(skipped and arguments.require_all)
    payload = {
        "ok": not unacceptable,
        "workdir": str(scratch),
        "passed": [result["id"] for result in results if result["status"] == "passed"],
        "failed": [result["id"] for result in failed],
        "skipped": [result["id"] for result in skipped],
        "jobs": results,
    }
    if arguments.json:
        json.dump(payload, sys.stdout, ensure_ascii=False)
        sys.stdout.write("\n")
    else:
        for result in results:
            print(f"{result['status']:>7}  {result['id']:<9} {result['purpose']}")
            for check in result["checks"]:  # type: ignore[union-attr]
                print(f"           - {check['name']}: {check['detail']}")
            if result.get("missing"):
                print(f"           needs: {', '.join(result['missing'])}")  # type: ignore[arg-type]
            if result.get("notExercised"):
                print(
                    "           not exercised here, needs: "
                    f"{', '.join(result['notExercised'])}"  # type: ignore[arg-type]
                )
            if result.get("failure"):
                print(f"           FAILED: {result['failure']}")
        print(
            f"\n{len(payload['passed'])} passed, {len(failed)} failed, {len(skipped)} not "
            f"exercised on this computer"
        )
    return 1 if unacceptable else 0


if __name__ == "__main__":
    raise SystemExit(main())
