#!/usr/bin/python3
"""The one way an Office file becomes a PDF, or is recalculated, on this computer.

LibreOffice is the engine underneath and it has three habits that make it unsafe to invoke
directly from a procedure: it exits 0 when the conversion produced nothing, it decides the output
name itself from the input stem, and concurrent runs sharing one user profile corrupt each other.
This wrapper gives each run its own throwaway profile, names the output where the caller asked for
it, and fails loudly when the bytes are not there - so a skill can say "run this" and a non-zero
exit genuinely means the document did not convert.
"""

from __future__ import annotations

import argparse
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

# Only the conversions the skill library prescribes. A filter that is not listed is not a filter
# the agent has a vetted procedure for, and guessing one produces a file nobody checked.
FILTERS = {".pdf": "pdf", ".docx": "docx", ".pptx": "pptx", ".xlsx": "xlsx"}

# Magic bytes for the formats this can emit: a PDF that is not a PDF, or an Office file that is
# not a zip, is the exact failure LibreOffice reports as success.
SIGNATURES = {".pdf": b"%PDF-", ".docx": b"PK", ".pptx": b"PK", ".xlsx": b"PK"}

SOFFICE_CANDIDATES = (
    "/usr/bin/soffice",
    "/usr/lib/libreoffice/program/soffice",
    "/usr/local/bin/soffice",
)


def soffice() -> str:
    # Named explicitly by the toolchain test, which drives this wrapper against a stub so that
    # its failure handling is proven without a 400 MB office suite in the loop.
    override = os.environ.get("GARDEN_SOFFICE")
    if override:
        return override
    for candidate in SOFFICE_CANDIDATES:
        if os.access(candidate, os.X_OK):
            return candidate
    found = shutil.which("soffice") or shutil.which("libreoffice")
    if found:
        return found
    raise SystemExit(
        "garden-office-convert: LibreOffice is not installed on this computer, so Office files "
        "cannot be converted. Install it with: apt-get install -y libreoffice-writer "
        "libreoffice-impress libreoffice-calc"
    )


def convert(source: Path, target: Path, timeout: int) -> None:
    suffix = target.suffix.lower()
    if suffix not in FILTERS:
        raise SystemExit(
            f"garden-office-convert: {suffix or target.name} is not a target this computer "
            f"converts to. Supported: {', '.join(sorted(FILTERS))}"
        )
    if not source.is_file():
        raise SystemExit(f"garden-office-convert: {source} is not a file")
    target.parent.mkdir(parents=True, exist_ok=True)

    with tempfile.TemporaryDirectory(prefix="garden-office-") as scratch:
        staging = Path(scratch) / "out"
        staging.mkdir()
        # A private user profile per run. Two conversions started in the same second against one
        # shared profile is the documented way to corrupt a LibreOffice installation, and a deck
        # proof and a workbook recalculation genuinely do overlap.
        profile = (Path(scratch) / "profile").as_uri()
        command = [
            soffice(),
            f"-env:UserInstallation={profile}",
            "--headless",
            "--invisible",
            "--nodefault",
            "--nofirststartwizard",
            "--nolockcheck",
            "--nologo",
            "--norestore",
            "--convert-to",
            FILTERS[suffix],
            "--outdir",
            str(staging),
            str(source),
        ]
        environment = {**os.environ, "HOME": scratch, "SAL_USE_VCLPLUGIN": "svp"}
        try:
            result = subprocess.run(
                command,
                check=False,
                capture_output=True,
                text=True,
                timeout=timeout,
                env=environment,
            )
        except subprocess.TimeoutExpired:
            raise SystemExit(
                f"garden-office-convert: LibreOffice did not finish converting {source.name} "
                f"within {timeout}s"
            ) from None

        produced = sorted(staging.iterdir())
        if not produced:
            detail = (result.stderr or result.stdout or "").strip().splitlines()
            raise SystemExit(
                f"garden-office-convert: LibreOffice produced no output for {source.name} "
                f"(exit {result.returncode})"
                + (f": {detail[-1]}" if detail else "")
            )
        written = produced[0]
        if written.stat().st_size == 0:
            raise SystemExit(f"garden-office-convert: LibreOffice wrote an empty {suffix} file")
        signature = SIGNATURES.get(suffix)
        if signature:
            with written.open("rb") as handle:
                if not handle.read(len(signature)).startswith(signature):
                    raise SystemExit(
                        f"garden-office-convert: the file LibreOffice wrote is not a valid "
                        f"{suffix.lstrip('.')} document"
                    )
        # Across filesystems in the general case, because the workspace and /tmp are often not
        # the same mount; shutil.move falls back to a copy when rename cannot cross them.
        shutil.move(str(written), str(target))


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="garden-office-convert",
        description=(
            "Convert a Word, PowerPoint, Excel or OpenDocument file through LibreOffice. The "
            "target format is taken from the output extension. Converting a workbook to .xlsx "
            "recalculates every formula in it."
        ),
    )
    parser.add_argument("source", type=Path, help="the file to convert")
    parser.add_argument("target", type=Path, help="the exact path to write, extension included")
    parser.add_argument(
        "--timeout",
        type=int,
        default=180,
        help="seconds to allow LibreOffice, default 180",
    )
    arguments = parser.parse_args()
    convert(arguments.source, arguments.target, max(10, min(900, arguments.timeout)))
    print(arguments.target)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
