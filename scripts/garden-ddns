#!/bin/sh
set -eu

garden_root="${GARDEN_ROOT:-/opt/garden}"
garden_config="${GARDEN_CONFIG:-/etc/garden}"
garden_state="${GARDEN_STATE:-/var/lib/garden}"
garden_cli="${GARDEN_CLI:-/usr/local/bin/garden}"
control_env="$garden_config/control.env"
ddns_state="$garden_state/ddns.state"
ddns_error="$garden_state/ddns.error"

# Providers are re-published on this interval even when the address set is unchanged,
# so an account that lost the record recovers without waiting for the next move.
republish_seconds=86400
# A host behind NAT has no public address of its own, so the published address is the one the
# provider read from the request and a change to it is completely invisible here: no netlink
# event fires when the router's address changes. Such a host has to re-assert on a short cycle
# rather than waiting a day, while still not publishing on every link event.
nat_republish_seconds=1800

cloudflare_api="https://api.cloudflare.com/client/v4"

# Working state shared with the provider functions. Declared here so `set -u` catches a
# provider that forgets to fill one in rather than silently sending an empty request.
provider_token=""
provider_report=""
publish_reason=""
curl_config=""
curl_errors=""
response_body=""
ipv4_address=""
ipv6_address=""
ddns_provider=""
ddns_hostname=""

note() {
  printf 'garden ddns: %s\n' "$1"
}

warn() {
  printf 'garden ddns: %s\n' "$1" >&2
}

# The reason a publish failed has to survive the process: `garden ddns status` and
# `garden doctor` are the places an operator looks, and neither can read a journal entry
# from a netlink-triggered run that happened hours ago.
record_error() {
  [ -d "$garden_state" ] || return 0
  {
    printf '%s\n%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" >"$ddns_error" &&
      chmod 0644 "$ddns_error"
  } 2>/dev/null || true
}

fail() {
  warn "$1"
  record_error "$1"
  exit 1
}

control_value() {
  [ -r "$control_env" ] || return 0
  sed -n "s/^$1=//p" "$control_env" | sed -n '1p'
}

set_control_value() {
  config_key="$1"
  config_temp=$(mktemp "$control_env.XXXXXX")
  chmod 0600 "$config_temp"
  # The value reaches awk through the environment, never through `-v`: a process argument list
  # is world-readable through /proc/PID/cmdline and DDNS_TOKEN is a secret.
  GARDEN_CONFIG_VALUE="$2" awk -v key="$config_key" '
    BEGIN { replaced = 0; value = ENVIRON["GARDEN_CONFIG_VALUE"] }
    index($0, key "=") == 1 {
      if (!replaced) print key "=" value
      replaced = 1
      next
    }
    { print }
    END { if (!replaced) print key "=" value }
  ' "$control_env" >"$config_temp"
  mv "$config_temp" "$control_env"
  chmod 0600 "$control_env"
}

# Credentials are rejected unless they are safe both as a URL query value and as a
# curl configuration value, so a pasted secret can never break out of either quoting.
validate_credential() {
  case "$1" in
    '') return 1 ;;
    *[!A-Za-z0-9._~:+/=-]*) return 1 ;;
  esac
  return 0
}

validate_hostname() {
  printf '%s' "$1" | awk '
    BEGIN { status = 1 }
    {
      if (length($0) > 253) exit 1
      count = split($0, labels, ".")
      if (count < 2) exit 1
      for (index_ = 1; index_ <= count; index_++) {
        if (labels[index_] !~ /^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$/) exit 1
      }
      status = 0
    }
    END { exit status }
  '
}

# Only the address this host can see for itself. Temporary (RFC 4941) addresses are excluded
# because they are deprecated within a day, and a DNS record pointing at one stops working.
public_addresses() {
  if [ "$1" = 6 ]; then
    address_lines=$(ip -o -6 address show scope global -temporary 2>/dev/null || true)
  else
    address_lines=$(ip -o -4 address show scope global 2>/dev/null || true)
  fi
  printf '%s\n' "$address_lines" |
    awk -v family="$1" '$2 !~ /^(docker|br-|veth|cni|podman|virbr)/ {
      address = $4
      sub(/\/.*/, "", address)
      if (address == "") next
      if (family == 4) {
        if (address ~ /^(10[.]|127[.]|169[.]254[.]|192[.]168[.])/) next
        if (address ~ /^172[.]/) {
          split(address, octets, ".")
          if (octets[2] >= 16 && octets[2] <= 31) next
        }
      } else {
        if (tolower(address) ~ /^(f[cd]|fe80)/) next
      }
      print address
    }' |
    sort -u |
    sed -n '1p'
}

# curl's own diagnostics are filtered before they reach stderr or the journal: a DuckDNS
# update URL carries the token in its query string, and curl prints the URL in some errors.
redact_credential() {
  GARDEN_REDACTED_VALUE="$provider_token" awk '
    BEGIN { secret = ENVIRON["GARDEN_REDACTED_VALUE"] }
    {
      if (secret != "") {
        while ((position = index($0, secret)) > 0) {
          $0 = substr($0, 1, position - 1) "<redacted>" substr($0, position + length(secret))
        }
      }
      print
    }
  '
}

# Only the secret-bearing parts of a request go through the configuration file on standard
# input; everything else stays in the argument list where it is harmless. Prints the HTTP
# status code, or 000 when no response was received at all.
send_request() {
  response_path="$1"
  shift
  http_status=$(
    printf '%s' "$curl_config" |
      curl --config - --silent --show-error --max-time 20 \
        --retry 1 --retry-delay 3 --retry-connrefused \
        --output "$response_path" --write-out '%{http_code}' "$@" \
        2>"$curl_errors"
  ) || true
  if [ -s "$curl_errors" ]; then
    redact_credential <"$curl_errors" >&2
    : >"$curl_errors"
  fi
  case "$http_status" in
    ''|*[!0-9]*) http_status=000 ;;
  esac
  printf '%s' "$http_status"
}

require_credential() {
  provider_token=$(control_value DDNS_TOKEN)
  validate_credential "$provider_token" ||
    fail "DDNS_TOKEN is missing or contains unsupported characters; run sudo garden ddns configure"
}

# Publishes one DuckDNS request and reports failure through its return status instead of
# exiting, because a host that needs one request per address family must be able to publish
# the second even when the first could not be sent.
duckdns_publish() {
  publish_ipv4="$1"
  publish_ipv6="$2"
  shift 2
  update_url="https://www.duckdns.org/update?domains=$duckdns_names&token=$provider_token&verbose=true"
  [ -z "$publish_ipv4" ] || update_url="$update_url&ip=$publish_ipv4"
  [ -z "$publish_ipv6" ] || update_url="$update_url&ipv6=$publish_ipv6"
  curl_config="url = \"$update_url\"
"
  status_code=$(send_request "$response_body" "$@")
  if [ "$status_code" != 200 ]; then
    publish_reason="DuckDNS returned HTTP $status_code"
    warn "$publish_reason"
    return 1
  fi
  if ! sed -n '1p' "$response_body" | grep -q '^OK'; then
    publish_reason="DuckDNS rejected the update; check the token and that the name is yours"
    warn "$publish_reason"
    return 1
  fi
  # verbose=true answers OK, then the recorded IPv4, the recorded IPv6, then UPDATED/NOCHANGE.
  provider_report=$(
    awk 'NR > 1 && NF { printf "%s%s", separator, $0; separator = " " }' "$response_body"
  )
  return 0
}

update_duckdns() {
  require_credential
  publish_reason="DuckDNS did not accept the update"
  case "$ddns_hostname" in
    *.duckdns.org) ;;
    *) fail "a DuckDNS name ends in .duckdns.org; run sudo garden ddns configure" ;;
  esac
  duckdns_names=${ddns_hostname%.duckdns.org}
  case "$duckdns_names" in
    ''|*.*) fail "a DuckDNS name has exactly one label before .duckdns.org" ;;
  esac
  if [ -n "$ipv4_address" ] || [ -z "$ipv6_address" ]; then
    # Omitting ip lets DuckDNS record the address the request came from, which is the router's
    # public address when this host only holds a private one behind NAT.
    if [ -n "$ipv4_address" ]; then
      duckdns_publish "$ipv4_address" "$ipv6_address" || fail "$publish_reason"
    else
      duckdns_publish "" "" --ipv4 || fail "$publish_reason"
    fi
    return 0
  fi
  # DuckDNS stops detecting the caller's IPv4 as soon as ipv6 is supplied, so a host that is
  # behind NAT for IPv4 but holds its own public IPv6 needs one request per family: the first
  # learns the router's address from the connection, the second carries the observed address.
  duckdns_address_report=""
  if duckdns_publish "" "" --ipv4; then
    duckdns_address_report="$provider_report"
  else
    warn "DuckDNS could not be reached over IPv4; the A record was left unchanged"
  fi
  duckdns_publish "" "$ipv6_address" || fail "$publish_reason"
  [ -z "$duckdns_address_report" ] ||
    provider_report="$duckdns_address_report / $provider_report"
}

update_desec() {
  require_credential
  curl_config="header = \"Authorization: Token $provider_token\"
"
  desec_query="hostname=$ddns_hostname"
  # "preserve" keeps an AAAA that this host cannot observe, such as one held by a router,
  # instead of deleting it: deSEC removes the record of any family it is given neither a
  # parameter nor a matching connection address for.
  if [ -n "$ipv6_address" ]; then
    desec_query="$desec_query&myipv6=$ipv6_address"
  else
    desec_query="$desec_query&myipv6=preserve"
  fi
  if [ -n "$ipv4_address" ]; then
    status_code=$(
      send_request "$response_body" --url "https://update.dedyn.io/?$desec_query&myipv4=$ipv4_address"
    )
  else
    # No public IPv4 on this host means it is behind NAT, so the connection address is the one
    # clients have to reach. Forcing IPv4 makes deSEC read the router's address rather than
    # deleting the A record because the request happened to arrive over IPv6.
    status_code=$(send_request "$response_body" --ipv4 --url "https://update.dedyn.io/?$desec_query")
    if [ "$status_code" = 000 ]; then
      warn "deSEC could not be reached over IPv4; the existing A record is being preserved"
      status_code=$(
        send_request "$response_body" --url "https://update.dedyn.io/?$desec_query&myipv4=preserve"
      )
    fi
  fi
  case "$status_code" in
    200) ;;
    401) fail "deSEC rejected the token; create a new one and run sudo garden ddns configure" ;;
    404) fail "deSEC does not know $ddns_hostname; create the domain in your deSEC account first" ;;
    *) fail "deSEC returned HTTP $status_code" ;;
  esac
  grep -q '^good' "$response_body" ||
    fail "deSEC rejected the update; check the token and the hostname"
  provider_report=$(sed -n '1p' "$response_body")
}

cloudflare_authorization() {
  curl_config="header = \"Authorization: Bearer $provider_token\"
"
}

# A zone id cannot be derived from a record name, so the zones the token can see are listed and
# the longest one that is a suffix of the hostname wins. A token without Zone:Read simply gets
# no answer and the operator is asked for the id instead of the request failing obscurely.
cloudflare_discover_zone() {
  cloudflare_authorization
  status_code=$(send_request "$response_body" --url "$cloudflare_api/zones?per_page=50")
  [ "$status_code" = 200 ] || return 1
  jq -e '.success == true' "$response_body" >/dev/null 2>&1 || return 1
  jq -r --arg host "$ddns_hostname" '
    [
      .result[]
      | . as $zone
      | ($host | ascii_downcase) as $wanted
      | ($zone.name | ascii_downcase) as $zone_name
      | select($wanted == $zone_name or ($wanted | endswith("." + $zone_name)))
      | $zone
    ]
    | sort_by(.name | length)
    | (last // {})
    | .id // empty
  ' "$response_body"
}

cloudflare_zone_id() {
  cloudflare_zone=$(control_value DDNS_ZONE_ID)
  case "$cloudflare_zone" in
    '') ;;
    *[!A-Za-z0-9]*) fail "DDNS_ZONE_ID must be the hexadecimal zone identifier" ;;
    *) return 0 ;;
  esac
  cloudflare_zone=$(cloudflare_discover_zone || true)
  case "$cloudflare_zone" in
    ''|*[!A-Za-z0-9]*)
      fail "the Cloudflare zone for $ddns_hostname could not be determined; re-run sudo garden ddns configure --zone-id ID with the zone id from the Cloudflare dashboard"
      ;;
  esac
  # Cached so every later publish is two requests instead of three.
  set_control_value DDNS_ZONE_ID "$cloudflare_zone"
}

cloudflare_record() {
  record_type="$1"
  record_content="$2"
  cloudflare_records="$cloudflare_api/zones/$cloudflare_zone/dns_records"
  cloudflare_authorization
  status_code=$(
    send_request "$response_body" \
      --url "$cloudflare_records?type=$record_type&name.exact=$ddns_hostname"
  )
  [ "$status_code" = 200 ] || fail "Cloudflare returned HTTP $status_code while reading records"
  jq -e '.success == true' "$response_body" >/dev/null ||
    fail "Cloudflare rejected the record lookup; check the API token scope and the zone id"
  # The name is matched here as well as in the query. A filter this code got wrong would
  # otherwise select an unrelated record of the same type and overwrite it.
  record_id=$(
    jq -r --arg name "$ddns_hostname" '
      [.result[] | select((.name | ascii_downcase) == ($name | ascii_downcase))]
      | (first // {})
      | .id // empty
    ' "$response_body"
  )

  request_body=$(mktemp)
  chmod 0600 "$request_body"
  # ttl 60 is the shortest value Cloudflare accepts outside Enterprise plans. proxied must stay
  # false: a proxied record would terminate TLS at Cloudflare and break the pinned server identity.
  jq -n -c \
    --arg type "$record_type" \
    --arg name "$ddns_hostname" \
    --arg content "$record_content" \
    '{type: $type, name: $name, content: $content, ttl: 60, proxied: false}' \
    >"$request_body"
  if [ -n "$record_id" ]; then
    status_code=$(
      send_request "$response_body" --request PATCH \
        --header 'Content-Type: application/json' \
        --data "@$request_body" \
        --url "$cloudflare_records/$record_id"
    )
  else
    status_code=$(
      send_request "$response_body" --request POST \
        --header 'Content-Type: application/json' \
        --data "@$request_body" \
        --url "$cloudflare_records"
    )
  fi
  rm -f "$request_body"
  [ "$status_code" = 200 ] || [ "$status_code" = 201 ] ||
    fail "Cloudflare returned HTTP $status_code while writing the $record_type record"
  jq -e '.success == true' "$response_body" >/dev/null ||
    fail "Cloudflare rejected the $record_type record write: $(jq -r '[.errors[]?.message] | join("; ")' "$response_body")"
}

update_cloudflare() {
  command -v jq >/dev/null 2>&1 || fail "the Cloudflare provider needs jq; install it and retry"
  require_credential
  [ -n "$ipv4_address" ] || [ -n "$ipv6_address" ] ||
    fail "Cloudflare needs an explicit address and this host has no public address; use DuckDNS or deSEC behind NAT"
  cloudflare_zone_id
  cloudflare_written=""
  if [ -n "$ipv4_address" ]; then
    cloudflare_record A "$ipv4_address"
    cloudflare_written="A $ipv4_address"
  fi
  if [ -n "$ipv6_address" ]; then
    cloudflare_record AAAA "$ipv6_address"
    cloudflare_written="${cloudflare_written:+$cloudflare_written / }AAAA $ipv6_address"
  fi
  provider_report="$cloudflare_written"
}

publish() {
  provider_report=""
  case "$ddns_provider" in
    duckdns) update_duckdns ;;
    desec) update_desec ;;
    cloudflare) update_cloudflare ;;
    *) fail "unsupported provider $ddns_provider" ;;
  esac
}

load_configuration() {
  ddns_provider=$(control_value DDNS_PROVIDER)
  ddns_hostname=$(control_value DDNS_HOSTNAME)
}

ddns_update() {
  forced="${1:-}"
  load_configuration
  [ -n "$ddns_provider" ] || return 0
  validate_hostname "$ddns_hostname" ||
    fail "DDNS_HOSTNAME is missing or is not a DNS hostname"

  ipv4_address=$(public_addresses 4)
  ipv6_address=$(public_addresses 6)
  desired_state="$ddns_provider $ddns_hostname ${ipv4_address:--} ${ipv6_address:--}"
  recorded_state=$(sed -n '1p' "$ddns_state" 2>/dev/null || true)
  recorded_epoch=$(sed -n '2p' "$ddns_state" 2>/dev/null || true)
  case "$recorded_epoch" in
    ''|*[!0-9]*) recorded_epoch=0 ;;
  esac
  now_epoch=$(date +%s)
  republish_interval="$republish_seconds"
  case "$ddns_provider" in
    duckdns|desec) [ -n "$ipv4_address" ] || republish_interval="$nat_republish_seconds" ;;
  esac
  if [ "$forced" != "--force" ] &&
    [ "$desired_state" = "$recorded_state" ] &&
    [ $((now_epoch - recorded_epoch)) -lt "$republish_interval" ]; then
    return 0
  fi

  response_body=$(mktemp)
  curl_errors=$(mktemp)
  chmod 0600 "$response_body" "$curl_errors"
  trap 'rm -f "$response_body" "$curl_errors"' EXIT INT TERM
  publish
  rm -f "$response_body" "$curl_errors"
  trap - EXIT INT TERM

  install -d -m 0755 "$garden_state"
  state_temp=$(mktemp "$ddns_state.XXXXXX")
  printf '%s\n%s\n' "$desired_state" "$now_epoch" >"$state_temp"
  chmod 0644 "$state_temp"
  mv "$state_temp" "$ddns_state"
  rm -f "$ddns_error"
  note "published $ddns_hostname through $ddns_provider"
}

ddns_status() {
  load_configuration
  if [ -z "$ddns_provider" ]; then
    printf 'Dynamic DNS is not configured. Run: sudo garden ddns configure\n'
    printf 'A hostname is what makes browser sign-in possible; a passkey cannot be bound to an\n'
    printf 'IP address, so a server reached only by address can be used from native clients only.\n'
    return 0
  fi
  printf 'Provider:    %s\n' "$ddns_provider"
  printf 'Hostname:    %s\n' "$ddns_hostname"
  if validate_credential "$(control_value DDNS_TOKEN)"; then
    printf 'Credential:  stored in %s (root-only)\n' "$control_env"
  else
    printf 'Credential:  missing or unusable\n'
  fi
  if [ "$ddns_provider" = cloudflare ]; then
    printf 'Zone id:     %s\n' "$(control_value DDNS_ZONE_ID)"
  fi
  printf 'Detected:    IPv4 %s, IPv6 %s\n' \
    "$(public_addresses 4 || true)" "$(public_addresses 6 || true)"
  if [ -r "$ddns_state" ]; then
    printf 'Published:   %s\n' "$(sed -n '1p' "$ddns_state")"
    printf 'Last update: %s\n' \
      "$(date -u -d "@$(sed -n '2p' "$ddns_state")" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || true)"
  else
    printf 'Published:   never\n'
  fi
  if [ -r "$ddns_error" ]; then
    printf 'Last error:  %s (%s)\n' \
      "$(sed -n '2p' "$ddns_error")" "$(sed -n '1p' "$ddns_error")"
  fi
  public_origin=$(control_value PUBLIC_APP_URL)
  case "$public_origin" in
    "https://$ddns_hostname") printf 'Public origin: %s (browser sign-in works)\n' "$public_origin" ;;
    *)
      printf 'Public origin: %s\n' "$public_origin"
      printf 'This name is published but is not the public origin, so browser sign-in still uses\n'
      printf 'the old one. Run: sudo garden set-hostname %s\n' "$ddns_hostname"
      ;;
  esac
}

wait_for_resolution() {
  resolution_attempt=1
  while [ "$resolution_attempt" -le 30 ]; do
    if getent ahosts "$1" >/dev/null 2>&1; then
      return 0
    fi
    sleep 2
    resolution_attempt=$((resolution_attempt + 1))
  done
  return 1
}

read_hidden() {
  if [ -t 0 ]; then
    printf '%s' "$1" >&2
    stty -echo 2>/dev/null || true
    read -r hidden_value || { stty echo 2>/dev/null || true; fail "cancelled"; }
    stty echo 2>/dev/null || true
    printf '\n' >&2
  else
    read -r hidden_value || fail "no credential was supplied on standard input"
  fi
}

configure_interactively() {
  printf '%s\n' \
    'Signing in from a browser needs a hostname. A passkey is bound to a domain name and the' \
    'WebAuthn standard does not allow an IP address, so a server reached only by address can' \
    'be used from the native clients but never from a browser.' \
    '' \
    'Where should the name come from?' \
    '  1) DuckDNS   - free, sign in at https://www.duckdns.org and pick NAME.duckdns.org' \
    '  2) deSEC     - free and non-profit, register at https://desec.io for NAME.dedyn.io' \
    '  3) Cloudflare - you already own a domain whose DNS is hosted at Cloudflare' \
    ''
  printf 'Choice [1-3]: ' >&2
  read -r provider_choice || fail "cancelled"
  case "$provider_choice" in
    1) configure_provider=duckdns ;;
    2) configure_provider=desec ;;
    3) configure_provider=cloudflare ;;
    *) fail "choose 1, 2, or 3" ;;
  esac
  case "$configure_provider" in
    duckdns) printf 'Full hostname (for example my-garden.duckdns.org): ' >&2 ;;
    desec) printf 'Full hostname (for example my-garden.dedyn.io): ' >&2 ;;
    cloudflare) printf 'Full hostname (for example ai.example.com): ' >&2 ;;
  esac
  read -r configure_hostname || fail "cancelled"
  if [ "$configure_provider" = cloudflare ]; then
    printf 'Cloudflare zone id (press enter to look it up with the token): ' >&2
    read -r configure_zone || fail "cancelled"
  fi
}

ddns_configure() {
  configure_provider=""
  configure_hostname=""
  configure_zone=""
  adopt_origin=yes
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --provider) configure_provider="${2:-}"; shift 2 ;;
      --hostname) configure_hostname="${2:-}"; shift 2 ;;
      --zone-id) configure_zone="${2:-}"; shift 2 ;;
      # For an operator who deliberately keeps a different public origin, such as a reverse
      # proxy in front of this server, and only wants the record published.
      --keep-origin) adopt_origin=""; shift ;;
      *) fail "usage: garden ddns configure [--provider duckdns|cloudflare|desec --hostname HOST [--zone-id ID]] [--keep-origin]" ;;
    esac
  done
  [ -n "$configure_provider" ] || configure_provider="${GARDEN_DDNS_PROVIDER:-}"
  [ -n "$configure_hostname" ] || configure_hostname="${GARDEN_DDNS_HOSTNAME:-}"
  [ -n "$configure_zone" ] || configure_zone="${GARDEN_DDNS_ZONE_ID:-}"
  if [ -z "$configure_provider" ] && [ -z "${GARDEN_DDNS_TOKEN:-}" ] && [ -t 0 ]; then
    configure_interactively
  fi

  case "$configure_provider" in
    duckdns|cloudflare|desec) ;;
    *) fail "choose a provider: duckdns, desec, or cloudflare" ;;
  esac
  validate_hostname "$configure_hostname" ||
    fail "use the full DNS hostname, such as my-garden.duckdns.org"
  case "$configure_provider" in
    duckdns)
      case "$configure_hostname" in
        *.*.duckdns.org|duckdns.org) fail "a DuckDNS name looks like my-garden.duckdns.org" ;;
        *.duckdns.org) ;;
        *) fail "a DuckDNS name ends in .duckdns.org" ;;
      esac
      ;;
    cloudflare)
      case "$configure_zone" in
        '') ;;
        *[!A-Za-z0-9]*) fail "the Cloudflare zone id is hexadecimal" ;;
      esac
      ;;
  esac

  # The credential is read from the environment, the terminal, or a pipe so it never reaches
  # the argument list of this process or of the shell that started it.
  if [ -n "${GARDEN_DDNS_TOKEN:-}" ]; then
    configure_token="$GARDEN_DDNS_TOKEN"
  else
    case "$configure_provider" in
      duckdns) read_hidden 'DuckDNS token (input hidden): ' ;;
      desec) read_hidden 'deSEC token (input hidden): ' ;;
      cloudflare) read_hidden 'Cloudflare API token with Zone:DNS:Edit (input hidden): ' ;;
    esac
    configure_token="$hidden_value"
  fi
  validate_credential "$configure_token" ||
    fail "the token is empty or contains characters no supported provider issues"

  set_control_value DDNS_PROVIDER "$configure_provider"
  set_control_value DDNS_HOSTNAME "$configure_hostname"
  set_control_value DDNS_TOKEN "$configure_token"
  set_control_value DDNS_ZONE_ID "$configure_zone"
  note "configuration saved; publishing the current address"
  ddns_update --force

  if [ -z "$adopt_origin" ]; then
    printf 'The record is published. The public origin was left alone, so browser sign-in still\n'
    printf 'uses %s. Run “sudo garden set-hostname %s” to change it.\n' \
      "$(control_value PUBLIC_APP_URL)" "$configure_hostname"
    return 0
  fi

  if [ "$(control_value PUBLIC_APP_URL)" = "https://$configure_hostname" ]; then
    printf 'The public origin is already https://%s.\n' "$configure_hostname"
    return 0
  fi
  printf 'Waiting for %s to resolve before making it the public origin\n' "$configure_hostname"
  if ! wait_for_resolution "$configure_hostname"; then
    fail "$configure_hostname does not resolve yet; when it does, run sudo garden set-hostname $configure_hostname"
  fi
  # This is the step that actually turns browser sign-in on: it moves PUBLIC_APP_URL,
  # WEBAUTHN_ORIGIN and WEBAUTHN_RP_ID onto the name, refreshes the manifest and certificate
  # names, and restarts the services.
  if [ -x "$garden_cli" ]; then
    "$garden_cli" set-hostname "$configure_hostname"
  elif [ -r "$garden_root/scripts/garden" ]; then
    /bin/sh "$garden_root/scripts/garden" set-hostname "$configure_hostname"
  else
    fail "the garden command could not be found; run sudo garden set-hostname $configure_hostname"
  fi
}

ddns_disable() {
  set_control_value DDNS_PROVIDER ""
  set_control_value DDNS_TOKEN ""
  set_control_value DDNS_ZONE_ID ""
  rm -f "$ddns_state" "$ddns_error"
  printf 'Dynamic DNS updates are off. The existing DNS record was left untouched.\n'
  printf 'The public origin was not changed; run “sudo garden set-hostname” to move it.\n'
}

ddns_test() {
  load_configuration
  [ -n "$ddns_provider" ] || fail "dynamic DNS is not configured; run sudo garden ddns configure"
  ddns_update --force
  [ -z "$provider_report" ] || printf 'Provider recorded: %s\n' "$provider_report"
  resolved=$(
    getent ahosts "$ddns_hostname" 2>/dev/null | awk '{print $1}' | sort -u | tr '\n' ' ' || true
  )
  if [ -z "$resolved" ]; then
    printf 'Update accepted, but %s does not resolve yet. Wait for the record TTL.\n' \
      "$ddns_hostname"
    return 0
  fi
  printf '%s currently resolves to: %s\n' "$ddns_hostname" "$resolved"
  matched=""
  for expected_address in $ipv4_address $ipv6_address; do
    case " $resolved" in
      *" $expected_address "*) matched=yes ;;
    esac
  done
  if [ -n "$matched" ] || [ -z "$ipv4_address$ipv6_address" ]; then
    printf 'The published address is the one this computer holds.\n'
  else
    printf 'That does not include this computer address yet. A stale answer here is DNS caching\n'
    printf 'rather than a failed update; re-run this in a few minutes to confirm.\n'
  fi
}

[ "$(id -u)" -eq 0 ] || fail "run as root"
[ -r "$control_env" ] || fail "missing $control_env"

command_name="${1:-status}"
if [ "$#" -gt 0 ]; then shift; fi

case "$command_name" in
  status) ddns_status ;;
  configure) ddns_configure "$@" ;;
  disable) ddns_disable ;;
  test) ddns_test ;;
  update) ddns_update "${1:-}" ;;
  *)
    printf '%s\n' \
      'Usage: garden ddns {status|configure [--provider P --hostname H [--zone-id ID]] [--keep-origin]|test|update [--force]|disable}'
    exit 1
    ;;
esac
