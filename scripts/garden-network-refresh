#!/bin/sh
set -eu

garden_root="${GARDEN_ROOT:-/opt/garden}"
garden_config="${GARDEN_CONFIG:-/etc/garden}"
garden_state="${GARDEN_STATE:-/var/lib/garden}"
ddns_updater="${GARDEN_DDNS:-/usr/local/lib/garden/garden-ddns}"
[ -r "$ddns_updater" ] || ddns_updater="$garden_root/scripts/garden-ddns"
control_env="$garden_config/control.env"
relay_settings="$garden_config/relay/settings.json"
identity_key="$garden_config/tls/server.key"
certificate="$garden_config/tls/server.crt"
manifest="$garden_state/connection.json"
network_hash="$garden_state/network.sha256"

fail() {
  printf 'garden network refresh: %s\n' "$1" >&2
  exit 1
}

[ "$(id -u)" -eq 0 ] || fail "run as root"
[ -r "$control_env" ] || fail "missing $control_env"
[ -r "$identity_key" ] || fail "missing server identity key"
install -d -m 0755 "$garden_state" "$garden_config/tls"

control_value() {
  sed -n "s/^$1=//p" "$control_env" | sed -n '1p'
}

ipv4_addresses=$(
  ip -o -4 address show scope global |
    awk '$2 !~ /^(docker|br-|veth|cni|podman|virbr)/ {
      address = $4
      sub(/\/.*/, "", address)
      print address
    }' |
    sort -u
)
ipv6_addresses=$(
  ip -o -6 address show scope global -temporary |
    awk '$2 !~ /^(docker|br-|veth|cni|podman|virbr)/ {
      address = $4
      sub(/\/.*/, "", address)
      print address
    }' |
    sort -u
)
[ -n "$ipv4_addresses$ipv6_addresses" ] || fail "no usable network address was detected"

public_url=$(control_value PUBLIC_APP_URL)
[ -n "$public_url" ] || fail "PUBLIC_APP_URL is not configured"
public_hostname=$(
  node -e '
    process.stdout.write(new URL(process.argv[1]).hostname.replace(/^\[|\]$/g, ""));
  ' "$public_url"
)
case "$public_hostname" in
  *:*) public_endpoint="https://[$public_hostname]" ;;
  *) public_endpoint="https://$public_hostname" ;;
esac

ddns_hostname=$(control_value DDNS_HOSTNAME)
# Only a syntactically valid name may reach the certificate configuration or the manifest,
# whatever ended up in the configuration file.
case "$ddns_hostname" in
  *[!A-Za-z0-9.-]*|.*|-*|*.) ddns_hostname="" ;;
  *.*) ;;
  *) ddns_hostname="" ;;
esac
# This script already runs on every netlink event, so publishing here is what makes a new
# public address reach DNS. A provider that cannot be reached must not stop the endpoint and
# certificate refresh, and the updater keeps the credential out of its argument list and logs.
if [ -n "$(control_value DDNS_PROVIDER)" ] && [ -r "$ddns_updater" ]; then
  /bin/sh "$ddns_updater" update ||
    printf 'garden network refresh: dynamic DNS did not publish; endpoints were refreshed\n' >&2
fi

# The relay address, and only while the relay is switched on. The API owns this file; reading it
# here is what makes turning the relay off stop the box advertising an address nothing answers on.
relay_host=""
relay_label=""
if [ -r "$relay_settings" ]; then
  relay_host=$(jq -r 'select(.enabled == true) | .host // empty' "$relay_settings" 2>/dev/null || true)
  relay_label=$(jq -r 'select(.enabled == true) | .label // empty' "$relay_settings" 2>/dev/null || true)
fi
# Same rule as the dynamic-DNS name above: only something that can be a hostname reaches the
# manifest, whatever ended up in the file.
case "$relay_host" in
  *[!A-Za-z0-9.-]*|.*|-*|*.) relay_host="" ;;
  *.*) ;;
  *) relay_host="" ;;
esac
# A label is derived by the relay from the box's own public key and is base32, nothing else.
case "$relay_label" in
  ''|*[!a-z0-9]*) relay_label="" ;;
esac

server_identity=$(
  openssl pkey -in "$identity_key" -pubout 2>/dev/null |
    openssl pkey -pubin -outform DER 2>/dev/null |
    openssl dgst -sha256 -binary |
    openssl base64 -A
)

endpoints_json=$(
  {
    {
      printf '%s\n' "$public_endpoint"
      [ -z "$ddns_hostname" ] || printf 'https://%s\n' "$ddns_hostname"
      for address in $ipv4_addresses; do printf 'https://%s\n' "$address"; done
      for address in $ipv6_addresses; do printf 'https://[%s]\n' "$address"; done
    } |
      awk 'NF && !seen[$0]++' |
      sed -n '1,16p'
    # Last, because it is the slowest path and the only one with a third party in it, and outside
    # the cap above, because on a server with many addresses the relay is the one endpoint that
    # still works from behind carrier-grade NAT.
    if [ -n "$relay_host" ] && [ -n "$relay_label" ]; then
      printf 'https://%s.%s\n' "$relay_label" "$relay_host"
    fi
  } |
    awk 'NF && !seen[$0]++' |
    jq -R . |
    jq -s -c .
)

manifest_temp=$(mktemp)
certificate_config=$(mktemp)
cleanup() {
  rm -f "$manifest_temp" "$certificate_config"
}
trap cleanup EXIT INT TERM

# The JavaScript is intentionally single-quoted so the shell cannot expand manifest data.
# shellcheck disable=SC2016
node -e '
  const manifest = {
    version: 1,
    identity: `sha256/${process.argv[1]}`,
    endpoints: JSON.parse(process.argv[2]),
    discovery: {
      mdnsService: "_garden._tcp.local",
      mdnsPort: 443
    },
    refreshedAt: new Date().toISOString()
  };
  process.stdout.write(`${JSON.stringify(manifest, null, 2)}\n`);
' "$server_identity" "$endpoints_json" >"$manifest_temp"
chmod 0644 "$manifest_temp"
chown root:root "$manifest_temp"

cat >"$certificate_config" <<EOF
[req]
distinguished_name=subject
x509_extensions=extensions
prompt=no
[subject]
CN=garden
[extensions]
subjectAltName=@alt_names
keyUsage=critical,digitalSignature,keyEncipherment
extendedKeyUsage=serverAuth
basicConstraints=critical,CA:false
[alt_names]
DNS.1=garden
EOF

dns_index=2
# Address literals belong in the IP SANs below. Anything holding a character an IPv4 literal
# cannot contain is a name, including names with four or more labels.
case "$public_hostname" in
  *:*)
    ;;
  *[!0-9.]*)
    printf 'DNS.%s=%s\n' "$dns_index" "$public_hostname" >>"$certificate_config"
    dns_index=$((dns_index + 1))
    ;;
esac
if [ -n "$ddns_hostname" ] && [ "$ddns_hostname" != "$public_hostname" ]; then
  printf 'DNS.%s=%s\n' "$dns_index" "$ddns_hostname" >>"$certificate_config"
  dns_index=$((dns_index + 1))
fi
local_hostname=$(hostname 2>/dev/null || true)
case "$local_hostname" in
  ""|localhost|localhost.localdomain|*.*.*.*) ;;
  *)
    printf 'DNS.%s=%s.local\n' "$dns_index" "$local_hostname" >>"$certificate_config"
    ;;
esac

ip_index=1
for address in $ipv4_addresses $ipv6_addresses; do
  printf 'IP.%s=%s\n' "$ip_index" "$address" >>"$certificate_config"
  ip_index=$((ip_index + 1))
done

desired_hash=$(
  {
    sed '/refreshedAt/d' "$manifest_temp"
    cat "$certificate_config"
  } |
    sha256sum |
    awk '{print $1}'
)
current_hash=$(sed -n '1p' "$network_hash" 2>/dev/null || true)

# A certificate whose subject differs from its issuer came from a public certificate
# authority. It carries the same pinned identity key, so replacing it with a freshly
# generated self-signed one would silently downgrade a working trusted certificate.
certificate_is_ca_issued() {
  [ -s "$certificate" ] || return 1
  certificate_subject=$(openssl x509 -in "$certificate" -noout -subject 2>/dev/null || true)
  certificate_issuer=$(openssl x509 -in "$certificate" -noout -issuer 2>/dev/null || true)
  [ -n "$certificate_subject" ] || return 1
  [ "${certificate_subject#subject=}" != "${certificate_issuer#issuer=}" ]
}

install -m 0644 "$manifest_temp" "$manifest"
# Self-signed certificates are also rebuilt in their final month, because nothing else
# renews them and the served certificate would otherwise expire in place.
if [ "$desired_hash" != "$current_hash" ] || [ ! -s "$certificate" ] ||
  ! openssl x509 -in "$certificate" -noout -checkend 2592000 >/dev/null 2>&1; then
  if certificate_is_ca_issued; then
    printf '%s\n' "$desired_hash" >"$network_hash"
    chmod 0644 "$network_hash"
    # Reissuing here would let a flapping address burn the certificate authority's rate limit on
    # every netlink event. The renewal timer notices the same mismatch within six hours and
    # reissues once, so this only has to say so.
    printf 'garden network refresh: the names or addresses of the trusted certificate changed; the renewal timer will reissue, or run sudo garden certificate issue now\n' >&2
  else
    openssl req -new -x509 -sha256 -days 825 \
      -key "$identity_key" \
      -out "$certificate" \
      -config "$certificate_config"
    chmod 0644 "$certificate"
    printf '%s\n' "$desired_hash" >"$network_hash"
    chmod 0644 "$network_hash"
    if systemctl is-active --quiet nginx.service; then
      nginx -t >/dev/null
      systemctl reload nginx.service
    fi
  fi
fi
