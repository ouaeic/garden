#!/bin/sh
# Structural lint for the in-repo skill library.
#
# Deliberately dependency-free (sh + awk + grep) so it runs in CI, in a provisioning image, and on
# a box that has no node build. It checks the things a malformed skill would otherwise fail on
# silently at load time: a broken front matter fence, a description that never says when NOT to
# apply, a body too long for a reviewer to read, or a capability grant that asks for the world.
#
# Usage: garden-skill-check [SKILLS_DIR]
set -eu

# `CDPATH= cd` empties CDPATH for that one command: with it set, cd resolves a relative path against
# it and can land somewhere else entirely, which would make pwd report the wrong root. shellcheck
# reads the empty assignment as a typo, so the check is turned off for this line rather than the
# idiom being dropped.
# shellcheck disable=SC1007
root="${1:-$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)/skills}"
max_body_lines=500
max_body_chars=20000
max_catalog_words=20

errors=0
warnings=0
checked=0

fail() {
  printf '%s: error: %s\n' "$1" "$2" >&2
  errors=$((errors + 1))
}

warn() {
  printf '%s: warning: %s\n' "$1" "$2" >&2
  warnings=$((warnings + 1))
}

if [ ! -d "$root" ]; then
  printf 'garden-skill-check: no skill library at %s\n' "$root" >&2
  exit 1
fi

for directory in "$root"/*/; do
  [ -d "$directory" ] || continue
  name=$(basename "$directory")
  skill="$directory/SKILL.md"
  sidecar="$directory/garden.yaml"

  if [ ! -f "$skill" ]; then
    fail "$name" "no SKILL.md"
    continue
  fi
  checked=$((checked + 1))

  # --- front matter -------------------------------------------------------
  if [ "$(head -n 1 "$skill")" != "---" ]; then
    fail "$name" "SKILL.md does not open with a --- front matter fence"
    continue
  fi
  fence=$(awk 'NR > 1 && $0 == "---" { print NR; exit }' "$skill")
  if [ -z "$fence" ]; then
    fail "$name" "front matter is never closed"
    continue
  fi

  front=$(awk -v end="$fence" 'NR > 1 && NR < end' "$skill")
  body=$(awk -v start="$fence" 'NR > start' "$skill")

  declared=$(printf '%s\n' "$front" | awk -F': *' '/^name: */ { print $2; exit }')
  [ "$declared" = "$name" ] ||
    fail "$name" "front matter name is '$declared' but the directory is '$name'"

  printf '%s\n' "$name" | grep -Eq '^[a-z0-9]+(-[a-z0-9]+)*$' ||
    fail "$name" "skill names are lowercase words separated by single hyphens"
  case "$name" in
    *anthropic* | *claude*) fail "$name" "skill names may not contain a vendor name" ;;
  esac

  description=$(printf '%s\n' "$front" | awk -F': *' '/^description: */ { sub(/^description: */, ""); print; exit }')
  if [ -z "$description" ]; then
    fail "$name" "description is empty, so the skill can never be selected"
  else
    printf '%s\n' "$description" | grep -Eq 'Use (when|whenever|after|before)' ||
      fail "$name" "description does not say when to use the skill"
    printf '%s\n' "$description" | grep -Eq 'Do not use|do not use|never' ||
      fail "$name" "description does not say when NOT to use the skill"
    [ "${#description}" -le 1024 ] ||
      warn "$name" "description is ${#description} characters; keep it under 1024"
  fi

  for key in garden.tier garden.version garden.risk garden.domain; do
    printf '%s\n' "$front" | grep -q "^  $key:" ||
      fail "$name" "front matter metadata is missing $key"
  done
  # The spec defines metadata as string keys to string VALUES; nested structure there breaks
  # other clients that read it as a flat map.
  printf '%s\n' "$front" | awk '/^  garden\./ { if ($0 !~ /: *.+$/) exit 1 }' ||
    fail "$name" "metadata values must be flat strings"

  body_lines=$(printf '%s\n' "$body" | wc -l | tr -d ' ')
  body_chars=$(printf '%s' "$body" | wc -c | tr -d ' ')
  [ "$body_lines" -le "$max_body_lines" ] ||
    fail "$name" "body is $body_lines lines, over the $max_body_lines-line review budget"
  [ "$body_chars" -le "$max_body_chars" ] ||
    fail "$name" "body is $body_chars characters, over the ~5k-token review budget"

  # An empty inline code span is the shape a mechanical edit leaves behind, and it is invisible in
  # review: the since-deleted `code-change` skill shipped "find every caller with ``" and "verify
  # the real signature with ``" for four months. Both sentences were load-bearing - they named the
  # one tool that does the thing - and both reduced to an instruction with the instruction removed.
  # The skill is gone; the defect class is not, so the check stays. Fenced blocks are
  # skipped, including the indented ones inside a list item, and a run of three or more backticks
  # is stripped before the search so a fence marker on a prose line cannot masquerade as one.
  empty_span=$(printf '%s\n' "$body" | awk '
    { line = $0; sub(/^[ \t]+/, "", line) }
    line ~ /^```/ { fence = !fence; next }
    fence == 0 {
      probe = line
      gsub(/```+/, "", probe)
      if (probe ~ /``/) { print NR; exit }
    }
  ')
  [ -z "$empty_span" ] ||
    fail "$name" "body line $empty_span has an empty \`\` code span, so a named tool went missing"

  # --- sidecar ------------------------------------------------------------
  if [ ! -f "$sidecar" ]; then
    warn "$name" "no garden.yaml; the skill loads with an empty capability grant"
    continue
  fi

  sidecar_id=$(awk -F': *' '/^id: */ { print $2; exit }' "$sidecar")
  [ "$sidecar_id" = "$name" ] ||
    fail "$name" "garden.yaml id is '$sidecar_id' but the directory is '$name'"

  grep -q '^version: ' "$sidecar" || fail "$name" "garden.yaml has no version"
  grep -q '^capability:' "$sidecar" || fail "$name" "garden.yaml has no capability block"
  grep -q '^verify:' "$sidecar" || fail "$name" "garden.yaml declares no verification contract"
  grep -q '^requires:' "$sidecar" || fail "$name" "garden.yaml declares no required tools"

  # A verify-step key the loader does not read is dropped in silence, and what the model is handed
  # is the rest of the step with its subject removed. `verifyFrom` in apps/worker/src/skills.ts
  # reads exactly run, assert, check and the render/vision sub-mappings and nothing else;
  # `deployment` shipped `artifact: workspace/deploy/health-response.txt` naming the file its
  # assertion was about, so the opened skill carried a bare "assert: the captured health response
  # body" with no file anywhere in the block. One key in sixty, which is what a typo in a
  # hand-written sidecar looks like from the outside. Enforced here rather than written down
  # anywhere the model pays for: a lint that runs in CI costs zero tokens for ever.
  #
  # Indent decides what is a step key: 2 is the `- key:` that opens a step, 4 is a sibling key
  # inside it, and 6 or more is a field of the render/vision sub-mapping, which has its own names.
  unknown_key=$(awk '
    /^verify:/ { inv = 1; next }
    inv && /^[^ ]/ { inv = 0 }
    inv == 0 { next }
    {
      line = $0
      indent = match(line, /[^ ]/) - 1
      if (indent >= 6 || indent < 2) next
      sub(/^ +/, "", line)
      sub(/^- +/, "", line)
      if (line !~ /^[a-z_]+:/) next
      key = line
      sub(/:.*$/, "", key)
      if (key !~ /^(run|assert|check|render|vision)$/) { print key; exit }
    }
  ' "$sidecar")
  [ -z "$unknown_key" ] ||
    fail "$name" "verify step key '$unknown_key' is not read by the loader, so the step is silently dropped"

  catalog=$(awk '/^catalog_line: */ { sub(/^catalog_line: */, ""); gsub(/^.|.$/, ""); print; exit }' "$sidecar")
  if [ -z "$catalog" ]; then
    warn "$name" "no catalog_line; the resident catalog falls back to the first sentence"
  else
    words=$(printf '%s\n' "$catalog" | wc -w | tr -d ' ')
    [ "$words" -le "$max_catalog_words" ] ||
      warn "$name" "catalog_line is $words words; the resident budget is $max_catalog_words"
  fi

  origin=$(awk '/^  origin: */ { print $2; exit }' "$sidecar")
  if [ "${origin:-builtin}" != "builtin" ]; then
    grep -q "net.hosts: \['\*'\]" "$sidecar" &&
      fail "$name" "only built-in skills may request unbounded network access"
    grep -q 'spend: metered' "$sidecar" &&
      fail "$name" "only built-in skills may request metered spend"
  fi
done

printf 'garden-skill-check: %d skill(s), %d error(s), %d warning(s)\n' \
  "$checked" "$errors" "$warnings"
[ "$errors" -eq 0 ] || exit 1
[ "$checked" -gt 0 ] || exit 1
exit 0
