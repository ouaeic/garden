#!/bin/sh
set -eu

# The one root-privileged path on this computer, reached from a single sudoers rule the agent
# account may use. Everything here is written for that: the search path is pinned, the file it
# reads its distribution facts from is named absolutely, and no environment variable chooses
# either. A helper that took its own path from its caller would hand root to whoever called it.
#
# It knew one package manager. `garden_pm_install` and the table beside it know four families,
# and the runner's own parse has known four families since the wave that widened it - so on a
# Fedora, Rocky, Arch or openSUSE box the owner approved an install, the runner rewrote it onto
# this helper exactly as designed, and this helper ran /usr/bin/apt-get and exited 127. The
# approval was real, the refusal was invisible, and the message named a binary that host has
# never had. Dispatching through the host table is the whole of the repair.

# Pinned rather than inherited, for the same reason the manifest tools below are absolute: this
# runs as root on behalf of an unprivileged account, and a search path that account chose would
# decide which `apt-get` root runs.
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

if [ "$(id -u)" -ne 0 ]; then
  echo "garden-system-packages must run through the installed sudo policy" >&2
  exit 1
fi

# Where the distribution facts live, named by an absolute literal and never by a variable. This is
# the same file the installer sources, so the names this helper installs and the names the
# installer placed are one list rather than two.
host_definitions=/opt/garden/scripts/garden-host.sh
garden_state_dir=/var/lib/garden

[ -f "$host_definitions" ] || {
  echo "garden-system-packages cannot read $host_definitions, so it does not know what this host's package manager is called" >&2
  exit 1
}
# shellcheck source=scripts/garden-host.sh
. "$host_definitions"

# The manager and nothing else. The family, the version and the architecture are the installer's
# questions; asking them here would refuse an install on any host without /etc/os-release.
garden_detect_package_manager || exit 1

operation="${1:-}"
[ "$#" -eq 0 ] || shift

# The name check runs here, before the dispatch below, and therefore on every family at once.
#
# It is a security control, not a tidiness rule: it is what stops `-o
# APT::Update::Pre-Invoke::=id`, `../../etc/passwd` and `foo bar` from reaching a root package
# manager as arguments. Putting it inside a per-family branch is how a control ends up correct on
# the branch it was written for and absent on the three that came later, so there is exactly one
# branch it can be written in.
reject_unsafe_names() {
  for package_name in "$@"; do
    case "$package_name" in
    *[!A-Za-z0-9+._:-]* | -* | *::* | *: | .* | /*)
      echo "Rejected unsafe package name: $package_name" >&2
      exit 1
      ;;
    esac
  done
}

case "$operation" in
update)
  [ "$#" -eq 0 ] || {
    echo "update does not accept additional arguments" >&2
    exit 1
  }
  garden_pm_refresh "$garden_pm"
  ;;
install)
  [ "$#" -gt 0 ] || {
    echo "install requires at least one package name" >&2
    exit 1
  }
  reject_unsafe_names "$@"
  garden_pm_refresh "$garden_pm"
  garden_pm_install "$garden_pm" "$@"
  # What this computer has been asked to add to itself, kept as plain text so `garden doctor` and
  # the owner can read it without asking the package manager anything.
  /usr/bin/install -d -m 0755 "$garden_state_dir"
  package_manifest="$garden_state_dir/installed-packages"
  temporary_manifest=$(/usr/bin/mktemp "$garden_state_dir/installed-packages.XXXXXX")
  {
    [ ! -f "$package_manifest" ] || /usr/bin/cat "$package_manifest"
    /usr/bin/printf '%s\n' "$@"
  } | /usr/bin/sort -u >"$temporary_manifest"
  /usr/bin/chmod 0644 "$temporary_manifest"
  /usr/bin/mv "$temporary_manifest" "$package_manifest"
  ;;
*)
  echo "Usage: garden-system-packages {update|install PACKAGE...}" >&2
  exit 1
  ;;
esac
