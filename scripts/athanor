#!/bin/sh
set -eu

athanor_root="${ATHANOR_ROOT:-/opt/athanor}"
athanor_config="${ATHANOR_CONFIG:-/etc/athanor}"
athanor_state="${ATHANOR_STATE:-/var/lib/athanor}"
# Where the control-plane services may write. It is the only such directory they have, so the model
# registry's record of what its last refresh pass did lives here rather than beside the rest of the
# state above, which athanor@.service cannot open for writing.
athanor_control_state="${ATHANOR_CONTROL_STATE:-/var/lib/athanor-control}"
athanor_home="${ATHANOR_HOME:-/home/athanor}"
athanor_backup_root="${ATHANOR_BACKUP_ROOT:-/var/backups/athanor}"
# Every update leaves a full copy of the database and every workspace behind. Unpruned, the
# mechanism that protects the disk is the one that fills it. Five is enough to step back past a
# bad release without keeping months of them.
athanor_backup_keep="${ATHANOR_BACKUP_KEEP:-5}"
# No single step of an update may run forever. Exceeding this rolls the server back rather than
# leaving it stopped and half-built with nobody watching.
athanor_update_step_seconds="${ATHANOR_UPDATE_STEP_SECONDS:-1800}"
# How long a restart is given to come back serving. Longer than the sixty seconds this used to
# allow, because it now waits for migrations to finish against a populated database rather than
# for a socket to open. Overridable for a server slow enough to need it.
athanor_ready_timeout_seconds="${ATHANOR_READY_TIMEOUT_SECONDS:-180}"
athanor_runtime_prefix="${ATHANOR_RUNTIME_PREFIX:-}"
service_units="athanor-jobs.service athanor-gui.service athanor-runner.service athanor@api.service athanor@worker.service athanor@registry.service athanor@notifications.service athanor-network-watch.service"
auto_update_timer="athanor-auto-update.timer"
backup_timer="athanor-backup.timer"
# What the last backup run did, beside the certificate and dynamic DNS files the same way: the
# interface has no other way to know whether the thing it promises daily has ever happened.
athanor_backup_status="$athanor_state/backup.status"
# And what the last update run did, beside it, for the same reason and in the same format.
#
# The daily backup has three things the weekly update did not: an OnFailure= companion, a status
# record, and a `doctor` arm that reads it. Without them a 3 a.m. update that failed and rolled the
# server back was invisible - the unit exits non-zero into a journal nobody reads, the timer
# schedules next week, and the same failure repeats weekly for as long as its cause lasts, while
# `doctor` reports unattended updates are on and the server looks perfectly healthy because it is:
# the rollback worked. What nothing said was that the box had stopped moving.
athanor_update_status="$athanor_state/update.status"
# Written by the `update install-runtime-files` phase when it has already applied what the release
# carries, and read by the shell that started the update so it does not do it a second time. A file
# rather than a variable because the two are different processes, and the phase is the only route a
# release has into an update whose shell predates it.
athanor_release_steps_marker="$athanor_state/release-steps-applied"
# How long the unattended backup waits for the worker to go idle before standing down for the day.
athanor_backup_idle_wait_seconds="${ATHANOR_BACKUP_IDLE_WAIT_SECONDS:-300}"
# How long the model catalogue may go without a provider answering before `doctor` calls it a fault
# rather than a provider having a bad afternoon. The loop retries hourly, so a week is about a
# hundred and seventy consecutive failures - long past anything that fixes itself.
athanor_catalog_stale_seconds="${ATHANOR_CATALOG_STALE_SECONDS:-604800}"
last_backup_destination=""
maintenance_lock_acquired=0

runtime_path() {
  printf '%s%s' "$athanor_runtime_prefix" "$1"
}

fail() {
  printf 'garden: %s\n' "$1" >&2
  exit 1
}

# Something went wrong that is not a reason to stop. There was only `fail` before, so every part of
# a long operation that could go wrong slightly was written as though it could only go wrong fatally
# - which is how reinstalling optional packages came to be able to abandon a restore halfway.
warn() {
  printf 'garden: %s\n' "$1" >&2
}

need_root() {
  if [ "$(id -u)" -ne 0 ]; then
    command -v sudo >/dev/null 2>&1 || fail "this command must run as root"
    exec sudo -E "$0" "$@"
  fi
}

acquire_maintenance_lock() {
  [ "$maintenance_lock_acquired" -eq 0 ] || return 0
  maintenance_lock_directory=/run/athanor-maintenance
  [ ! -L "$maintenance_lock_directory" ] || fail 'the maintenance lock directory is a symlink'
  install -d -m 0700 -o root -g root "$maintenance_lock_directory"
  maintenance_lock_file="$maintenance_lock_directory/lock"
  [ ! -L "$maintenance_lock_file" ] || fail 'the maintenance lock file is a symlink'
  if [ -e "$maintenance_lock_file" ] && [ ! -f "$maintenance_lock_file" ]; then
    fail 'the maintenance lock is not a regular file'
  fi
  # A child phase shares the open file description, never an environment flag. The fixed private
  # root directory prevents an unprivileged caller from supplying a matching descriptor.
  if ! python3 -I - "$maintenance_lock_file" <<'PYTHON'
import os, stat, sys
try:
    expected = os.stat(sys.argv[1], follow_symlinks=False)
    inherited = os.fstat(9)
    matches = (stat.S_ISREG(expected.st_mode) and expected.st_nlink == 1
               and os.path.samestat(expected, inherited))
except OSError:
    matches = False
sys.exit(0 if matches else 1)
PYTHON
  then
    (umask 077; : >>"$maintenance_lock_file")
    exec 9>>"$maintenance_lock_file"
  fi
  chown root:root "$maintenance_lock_file"
  chmod 0600 "$maintenance_lock_file"
  if [ -n "${1:-}" ]; then
    case "$1" in *[!0-9]*) fail 'maintenance lock wait must be a whole number of seconds' ;; esac
    [ "$1" -le 1800 ] || fail 'maintenance lock wait exceeds its bounded window'
    if ! flock -w "$1" 9; then
      printf 'garden: another maintenance operation is still running\n' >&2
      return 75
    fi
  else
    flock -n 9 || fail 'another backup, update or rollback holds the maintenance lock; retry when it finishes'
  fi
  maintenance_lock_acquired=1
}

set_control_value() {
  config_key="$1"
  temporary=$(mktemp "$athanor_config/control.env.XXXXXX")
  # The value reaches awk through the environment, never through `-v`: this file holds the
  # pairing code and other secrets, and a process argument list is world-readable through
  # /proc/PID/cmdline for as long as the command runs.
  ATHANOR_CONFIG_VALUE="$2" awk -v key="$config_key" '
    BEGIN { replaced = 0; value = ENVIRON["ATHANOR_CONFIG_VALUE"] }
    index($0, key "=") == 1 {
      if (!replaced) print key "=" value
      replaced = 1
      next
    }
    { print }
    END { if (!replaced) print key "=" value }
  ' "$athanor_config/control.env" >"$temporary"
  chmod 0600 "$temporary"
  mv "$temporary" "$athanor_config/control.env"
}

# Prints why the running release is not usable, or nothing when it is.
#
# /healthz answers `{"ok":true}` from a static literal: it is true of a build that cannot reach
# PostgreSQL, cannot read its own schema, and serves an error to every request. Using it as the
# update's rollback gate meant a broken release cleared the gate, the rollback trap was cleared,
# and the operator was told the update was complete while the product was dead. Each check below
# needs something the previous one does not.
release_readiness_failure() {
  # The database, from inside the new build's own pool.
  curl -fsS --max-time 10 http://127.0.0.1:4100/readyz >/dev/null 2>&1 || {
    printf 'the API cannot reach the database'
    return 0
  }
  # A real request, served end to end: this route counts users, so it goes through the store and
  # the schema rather than answering from a literal.
  case "$(curl -fsS --max-time 10 http://127.0.0.1:4100/v1/legal 2>/dev/null)" in
    *'"applicationLicense"'*) ;;
    *)
      printf 'the API did not serve a request that reads from the database'
      return 0
      ;;
  esac
  # The schema the new code expects is the schema the database has. Migrations run at service
  # startup, so a migration that failed leaves the old version applied under the new build.
  migrations_source="$athanor_root/packages/data/src/migrations.ts"
  if [ -r "$migrations_source" ]; then
    expected_migration=$(
      sed -n 's/^ *version: \([0-9][0-9]*\),$/\1/p' "$migrations_source" | sort -n | sed -n '$p'
    )
    applied_migration=$(
      runuser -u postgres -- psql -tAqc \
        'SELECT COALESCE(MAX(version), 0) FROM schema_migrations' athanor 2>/dev/null |
        tr -d '[:space:]'
    )
    if [ -n "$expected_migration" ] && [ "$applied_migration" != "$expected_migration" ]; then
      printf 'the database is at schema version %s but this release expects %s' \
        "${applied_migration:-unknown}" "$expected_migration"
      return 0
    fi
  fi
  # The worker leases tasks and the runner executes them; a release where either never comes up
  # is a computer that answers and does nothing.
  worker_metrics=$(curl -fsS --max-time 10 http://127.0.0.1:4201/metrics 2>/dev/null) || {
    printf 'the worker is not answering'
    return 0
  }
  # Answering is not the same as working. A worker whose lease keeps failing serves this endpoint
  # perfectly while accepting no tasks at all, so the release passed its own gate on a process that
  # had done nothing since it started. The counter is read the same way the idle check reads
  # athanor_worker_active, a few lines below.
  lease_errors=$(printf '%s\n' "$worker_metrics" |
    sed -n 's/^athanor_worker_lease_errors_total //p' | sed -n '1p' | tr -d '[:space:]')
  case "$lease_errors" in
  '' | 0) ;;
  *)
    printf 'the worker is answering but cannot lease tasks (%s failures)' "$lease_errors"
    return 0
    ;;
  esac
  curl -fsS --max-time 10 http://127.0.0.1:4300/healthz >/dev/null 2>&1 || {
    printf 'the workspace runner is not answering'
    return 0
  }
}

wait_until_serving() {
  attempt=1
  readiness=""
  while [ "$attempt" -le "$athanor_ready_timeout_seconds" ]; do
    readiness=$(release_readiness_failure)
    [ -n "$readiness" ] || return 0
    sleep 1
    attempt=$((attempt + 1))
  done
  fail "this release is not serving: $readiness; run sudo athanor logs"
}

start_athanor() {
  need_root start
  systemctl start athanor.target
  systemctl reload-or-restart nginx
  wait_until_serving
  printf 'athanor is running. Use “athanor connect” to show the client connection details.\n'
}

stop_athanor() {
  need_root stop
  systemctl stop athanor.target
  for unit_name in $service_units; do systemctl stop "$unit_name"; done
  printf 'athanor services stopped; files and database were preserved.\n'
}

# systemd stops wanting a unit that a release has withdrawn, which keeps it from starting again but
# never stops the copy already running: it goes on holding its port and its database connections
# until somebody reboots. `service_units` above is the list this release ships, so anything still up
# under the instance template and absent from it is stopped here.
stop_withdrawn_units() {
  withdrawn=$(systemctl list-units --state=active --no-legend 'athanor@*.service' 2>/dev/null |
    awk '{ for (i = 1; i <= NF; i++) if ($i ~ /^athanor@.*\.service$/) { print $i; break } }') ||
    return 0
  for unit_name in $withdrawn; do
    case " $service_units " in
    *" $unit_name "*) ;;
    *)
      printf 'Stopping %s, which this release no longer installs.\n' "$unit_name"
      systemctl stop "$unit_name" 2>/dev/null || true
      systemctl disable "$unit_name" 2>/dev/null || true
      ;;
    esac
  done
}

restart_athanor() {
  need_root restart
  systemctl start athanor.target
  stop_withdrawn_units
  for unit_name in $service_units; do
    if [ "$unit_name" = athanor-jobs.service ]; then systemctl reload-or-restart "$unit_name"
    else systemctl restart "$unit_name"; fi
  done
  systemctl reload-or-restart nginx
  wait_until_serving
  printf 'athanor restarted.\n'
}

status_athanor() {
  # First, because it is the one condition whose other symptom is a browser refusing to open the
  # server at all - by which point the owner cannot be told anything through the interface.
  if [ -r "$athanor_state/certificate.error" ]; then
    printf 'garden: TLS renewal failed at %s - %s\n' \
      "$(sed -n '1p' "$athanor_state/certificate.error")" \
      "$(sed -n '2p' "$athanor_state/certificate.error")" >&2
    printf 'garden: clients will see a security warning once the certificate expires. Run sudo athanor certificate issue.\n\n' >&2
  fi
  systemctl --no-pager --full status athanor.target nginx.service || true
  for unit_name in $service_units; do
    systemctl --no-pager --full status "$unit_name" || true
  done
}

# All six units interleaved, or one of them.
#
# It took no argument and the dispatch passed none, while `doctor` sent the owner here with one:
# "run sudo athanor logs notifications to see which push service and why". The word was silently
# discarded and they got a live tail of six units at once, in which the lines they had been sent to
# find were a small minority, with nothing to say the filter had not applied. Naming a service is
# what an operator wants from this command anyway, so the argument works rather than the advice
# being withdrawn.
logs_athanor() {
  requested="${1:-}"
  case "$requested" in
    '')
      journalctl -f --no-hostname -n 250 \
        -u athanor-runner.service \
        -u athanor@api.service \
        -u athanor@worker.service \
        -u athanor@registry.service \
        -u athanor@notifications.service \
        -u nginx.service
      return
      ;;
    api | worker | registry | notifications) requested_unit="athanor@$requested.service" ;;
    runner) requested_unit="athanor-runner.service" ;;
    nginx) requested_unit="nginx.service" ;;
    *) fail "unknown service: athanor logs [api|worker|runner|registry|notifications|nginx]" ;;
  esac
  journalctl -f --no-hostname -n 250 -u "$requested_unit"
}

control_env_value() {
  [ -r "$athanor_config/control.env" ] || return 0
  sed -n "s/^$1=//p" "$athanor_config/control.env" | sed -n '1p'
}

# What the certificate a browser is shown actually is, in the one word that decides what a browser
# will do with this server. The comparison already lives in athanor-certificate, which owns the
# file, so it is asked rather than repeated here: a second copy of the same test is a second thing
# free to drift. "unknown" is a real answer and is kept as one - a report that cannot reach that
# script has not learned that the certificate is self-signed, only that it did not find out.
certificate_trust_state() {
  case "$("$(runtime_path /usr/local/lib/athanor/athanor-certificate)" status 2>/dev/null |
    sed -n 's/^Certificate: *//p' | sed -n '1p')" in
    'issued by a certificate authority') printf 'trusted' ;;
    'self-signed'*) printf 'self-signed' ;;
    *) printf 'unknown' ;;
  esac
}

relay_directory="$athanor_config/relay"
relay_settings="$relay_directory/settings.json"
relay_status_file="$relay_directory/status.json"

relay_setting() {
  [ -r "$relay_settings" ] || return 0
  jq -r "$1 // empty" "$relay_settings" 2>/dev/null || true
}

relay_status_value() {
  [ -r "$relay_status_file" ] || return 0
  jq -r "$1 // empty" "$relay_status_file" 2>/dev/null || true
}

relay_public_hostname() {
  relay_label=$(relay_setting .label)
  relay_host=$(relay_setting .host)
  [ -n "$relay_label" ] && [ -n "$relay_host" ] || return 0
  printf '%s.%s' "$relay_label" "$relay_host"
}

# Bytes moved through the relay this month, as the relay itself last reported them. Printed
# because the relay is a control path, not a media path: a desktop preview will exhaust a
# hobbyist quota in hours and the owner should see that coming rather than be cut off.
relay_used_summary() {
  relay_used_bytes=$(relay_status_value .usedBytes)
  case "$relay_used_bytes" in
    ''|*[!0-9]*) return 0 ;;
  esac
  printf ', %s MiB used this month' "$((relay_used_bytes / 1048576))"
}

# Which Chromium the workspace runner will try to launch, asked of the thing that decides it.
#
# `playwright-core` pins a browser revision rather than a range - 1.61.1 asks for Chromium 1228 and
# 1.62.1 asks for 1234 - and the cache directory is named after the revision. So the release that
# bumps the dependency is the release the browser on disk stops being the one the code launches. The
# installer fetched it once and `athanor update` never fetched it again, while `doctor` asked only
# whether ~/.cache/ms-playwright exists - which it does, holding the revision from whenever the box
# was installed. Verified broken on a live server: the checkout wanted 1234 and the cache held 1228,
# every check passed, and every browser job failed. Both halves now ask the revision, from here, so
# there is one answer rather than two that drift.
managed_chromium_revision() {
  node -e '
    const browsers = require(process.argv[1]).browsers;
    const chromium = browsers.find((browser) => browser.name === "chromium");
    if (chromium && chromium.revision) process.stdout.write(String(chromium.revision));
  ' "$athanor_root/services/workspace-runner/node_modules/playwright-core/browsers.json" 2>/dev/null ||
    true
}

# The revision that is wanted and not on disk, or nothing when the right one is already there.
#
# Both directories are checked. The runner launches the headless shell and Playwright's own probe
# reaches for the full browser, and a cache holding one without the other is exactly what a fetch
# interrupted by a reboot leaves behind - which reads as healthy to anything that only counts
# directories.
managed_chromium_absent() {
  chromium_revision=$(managed_chromium_revision)
  [ -n "$chromium_revision" ] || return 0
  for chromium_directory in \
    "$athanor_home/.cache/ms-playwright/chromium-$chromium_revision" \
    "$athanor_home/.cache/ms-playwright/chromium_headless_shell-$chromium_revision"; do
    if [ ! -d "$chromium_directory" ]; then
      printf '%s' "$chromium_revision"
      return 0
    fi
  done
}

# Fetch as the account that runs the browser, into its own cache. Updates and restores both need
# this runtime. A failed download must leave recovered data serving; doctor reports the missing
# browser independently of database readiness.
fetch_managed_chromium() {
  chromium_wanted=$(managed_chromium_absent)
  [ -n "$chromium_wanted" ] || return 0
  chromium_cli="$athanor_root/services/workspace-runner/node_modules/playwright-core/cli.js"
  [ -f "$chromium_cli" ] || {
    warn "the pinned Playwright dependency is not installed, so the managed Chromium could not be fetched"
    return 0
  }
  printf 'Fetching the managed Chromium dependency (revision %s).\n' "$chromium_wanted"
  runuser -u athanor -- env HOME="$athanor_home" node "$chromium_cli" install chromium ||
    warn "the managed Chromium (revision $chromium_wanted) could not be fetched; browser jobs will fail until sudo athanor update succeeds at it. sudo athanor doctor reports this"
}

doctor() {
  need_root doctor
  failed=0
  check_ok() { printf 'ok    %s\n' "$1"; }
  check_fail() {
    printf 'fail  %s\n' "$1"
    failed=1
  }
  check_note() { printf 'note  %s\n' "$1"; }
  # A warning is a working server that is missing a capability the owner probably wants, not a
  # fault. It must not fail the run, or an operator who deliberately runs address-only would
  # have `doctor` return non-zero forever and stop reading it.
  check_warn() { printf 'warn  %s\n' "$1"; }

  if [ -f "$athanor_config/control.env" ] && [ -f "$athanor_config/runner.env" ]; then
    check_ok "private configuration exists"
  else
    check_fail "configuration is missing"
  fi
  if [ "$(stat -c '%a' "$athanor_config/control.env" 2>/dev/null || printf 0)" = 600 ] &&
    [ "$(stat -c '%a' "$athanor_config/runner.env" 2>/dev/null || printf 0)" = 600 ]; then
    check_ok "configuration permissions"
  else
    check_fail "configuration must be mode 0600"
  fi
  case "$(control_env_value PREVIEW_BASE_URL)" in
    https://*:8443/*)
      preview_status=$(curl -ksS --max-time 5 -o /dev/null -w '%{http_code}' \
        https://127.0.0.1:8443/v1/healthz 2>/dev/null || true)
      if [ "$preview_status" = 404 ]; then
        check_ok "isolated preview listener rejects control API paths"
      else
        check_fail "isolated previews need HTTPS port 8443; verify nginx, firewall and router forwarding"
      fi
      ;;
  esac
  for unit_name in $service_units nginx.service postgresql.service; do
    if systemctl is-active --quiet "$unit_name"; then
      check_ok "$unit_name"
    else
      check_fail "$unit_name is not running"
    fi
  done
  if systemctl is-active --quiet athanor-network-refresh.timer; then
    check_ok "network reconciliation timer"
  else
    check_fail "network reconciliation timer is not running"
  fi
  # The registry unit being active, checked a few lines above, says the process is up and nothing
  # more - and almost all of that process's life is the hour it spends asleep between refreshes. A
  # revoked provider key, an owner on a provider this service cannot ask, and a feed that has been
  # failing since Friday all look exactly like a healthy sleeping unit from out here. So each pass
  # writes down what it did and this reads it. The catalogue in the database goes on serving the
  # picker either way; what it must not do is look current when it is a year old, because a model
  # the provider withdrew is still being offered and the prices a run is charged against are the
  # ones recorded then. The record holds whole seconds, so nothing here has to parse a date - only
  # render one, the same way `athanor ddns status` renders the stamp in ddns.state.
  catalog_state=$(control_env_value MODEL_CATALOG_STATE_PATH)
  [ -n "$catalog_state" ] || catalog_state="$athanor_control_state/model-catalog.state"
  if [ -r "$catalog_state" ]; then
    catalog_pass=$(jq -r '.state // empty' "$catalog_state" 2>/dev/null || true)
    catalog_models=$(jq -r '.models // 0' "$catalog_state" 2>/dev/null || true)
    catalog_reason=$(jq -r '.reason // empty' "$catalog_state" 2>/dev/null || true)
    catalog_interval=$(jq -r '.intervalSeconds // empty' "$catalog_state" 2>/dev/null || true)
    catalog_checked_epoch=$(jq -r '.checkedAtEpoch // empty' "$catalog_state" 2>/dev/null || true)
    catalog_refreshed_epoch=$(jq -r '.lastRefreshEpoch // empty' "$catalog_state" 2>/dev/null || true)
    case "$catalog_interval" in
      ''|*[!0-9]*) catalog_interval=3600 ;;
    esac
    case "$catalog_checked_epoch" in
      ''|*[!0-9]*) catalog_checked_epoch=0 ;;
    esac
    case "$catalog_refreshed_epoch" in
      ''|*[!0-9]*) catalog_refreshed_epoch=0 ;;
    esac
    case "$catalog_models" in
      1) catalog_models_said="1 model" ;;
      *) catalog_models_said="$catalog_models models" ;;
    esac
    catalog_checked=$(date -u -d "@$catalog_checked_epoch" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || true)
    catalog_refreshed=""
    [ "$catalog_refreshed_epoch" -eq 0 ] ||
      catalog_refreshed=$(date -u -d "@$catalog_refreshed_epoch" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || true)
    catalog_now=$(date +%s)
    if [ "$catalog_checked_epoch" -eq 0 ]; then
      check_fail "the model registry's record at $catalog_state does not say when its last pass ran; run sudo athanor logs registry"
    elif [ "$((catalog_now - catalog_checked_epoch))" -gt "$((catalog_interval * 4))" ]; then
      # Four intervals, so a single slow pass or a restart in the wrong minute is not a fault. Past
      # that the unit is running and the loop inside it is not, which nothing else here can see.
      check_fail "the model registry has not finished a refresh pass since $catalog_checked although its unit is running; run sudo athanor logs registry"
    else
      case "$catalog_pass" in
        refreshed)
          check_ok "model catalogue: $catalog_models_said, refreshed from the provider at $catalog_refreshed"
          ;;
        failed)
          if [ "$catalog_refreshed_epoch" -eq 0 ] ||
            [ "$((catalog_now - catalog_refreshed_epoch))" -gt "$athanor_catalog_stale_seconds" ]; then
            check_fail "the model catalogue has not refreshed since ${catalog_refreshed:-this server was installed} and the last attempt failed (${catalog_reason:-no reason recorded}); the picker is offering what it held then, at the prices it held then"
          else
            check_warn "the last model catalogue refresh failed (${catalog_reason:-no reason recorded}); the catalogue from $catalog_refreshed stays in use and it tries again every $catalog_interval seconds"
          fi
          ;;
        refused)
          # A failure, not a warning, and the only catalogue state here that is one on its first
          # occurrence. Everything else in this case reports a box that is behaving correctly in a
          # world that is misbehaving: an outage retries, a missing key is a choice. A refusal means
          # a provider answered and what it answered had stopped describing models - a renamed field
          # upstream, which is the failure that used to be written straight over the owner's
          # catalogue and reported as success. It will not clear on its own and nothing else on the
          # box will ever mention it, so this is the whole of the owner's warning.
          check_fail "the model catalogue is not being replaced from the provider: ${catalog_reason:-no reason recorded}"
          ;;
        seeded|frozen)
          # A warning and not a failure, for the reason check_warn exists: an owner running their
          # own endpoint, or a provider this service has no way to ask, is a deliberate arrangement
          # and a `doctor` that returns non-zero for the life of that server is a `doctor` nobody
          # reads. What is true is narrower, and it is what this says.
          if [ "$catalog_refreshed_epoch" -eq 0 ]; then
            check_warn "model catalogue: $catalog_models_said from the built-in list, never refreshed from a provider. Saving a provider key in Settings is what starts the hourly refresh"
          else
            check_warn "model catalogue: $catalog_models_said, unchanged since $catalog_refreshed - there is no provider key this server can refresh from, so a withdrawn model goes on being offered and the recorded prices are what runs are charged against"
          fi
          ;;
        *)
          check_warn "model catalogue: the registry recorded a pass this build has no name for (${catalog_pass:-nothing at all}); run sudo athanor logs registry"
          ;;
      esac
    fi
  else
    # Not a failure. A server that finished updating a minute ago has not had a pass yet, and a
    # registry older than this check writes nothing for it to read.
    check_note "model catalogue: the registry has not recorded a refresh pass yet"
  fi
  # What the catalogue above knows about a model going away, said to the person it is about. The
  # whole argument for reporting it here, and for reporting only the pinned and scheduled cases,
  # is written over `model_retirement_dependencies`.
  #
  # Warnings and not failures, in both arms. A pin on a route that is withdrawn next week is a
  # server that works today and will go on working afterwards - `support.ts` ranks instead when the
  # pin cannot be served - so this is a setting about to stop meaning what the owner meant, which
  # is exactly what `check_warn` is for, and a `doctor` that returned non-zero for it would return
  # non-zero for as long as the owner left the pin alone.
  #
  # Three states, not two. The schema probe below answers `2` on a release that can be asked, `0`
  # or `1` on one too old to hold both columns, and nothing at all when there is no database to ask
  # - a stopped PostgreSQL, or a box where `runuser` or `psql` is not installed. Those are three
  # different sentences and the last of them used to be printed as the second, which told an owner
  # a fact about their release when what was true was "I could not look".
  retirement_columns=$(model_retirement_columns)
  if [ "$retirement_columns" = 2 ]; then
    retirement_counts=$(model_retirement_counts)
    retirement_total=${retirement_counts%%|*}
    retirement_expiring=${retirement_counts##*|}
    retirement_days=$(model_retirement_horizon_days)
    # The well-formed answer is matched, and everything else is "the catalogue did not answer" -
    # which is a different report from a catalogue with nothing being withdrawn in it and must not
    # be rendered as the reassuring one. Written this way round because the empty answer splits
    # into two empty halves, and a shape test on the halves is one bare `|` away from reading as a
    # confident zero.
    case "$retirement_counts" in
      [0-9]*'|'[0-9]*)
        # Whether the question was asked at all is kept apart from what it answered, because this
        # is the one read in this arm whose function ends in `runuser` rather than in a pipeline -
        # `model_retirement_columns` and `model_retirement_counts` both end in `| tr`, which is
        # what has been swallowing psql's exit status for them. So a bare assignment here carries
        # a failing status out into `set -eu` at the top of this file.
        #
        # Measured against the drill's fake host with the schema and count statements answering and
        # this one exiting 2: `doctor` ended on this line. The spending brake, the update state,
        # the backup age and the disk headroom that closes the report were all silently unreached,
        # and the only sign of it was a bare exit 2. A dropped connection, a statement timeout, or
        # a schema carrying `model_releases.metadata` and `task_schedules.model_id` but not
        # `users.preferences` all land here. `and the rest of the report is still printed rather
        # than the run ending there` in scripts/test-doctor-retirement.sh is what re-runs that.
        #
        # The failure is not folded into the empty answer beside it either. Empty means "nothing
        # you depend on is going", which is the reassuring line, and a statement that errored is
        # the same collapse this whole arm was rewritten to remove, one branch further in.
        retirement_asked=yes
        retirement_problems=$(model_retirement_dependencies) || retirement_asked=''
        if [ -z "$retirement_asked" ]; then
          check_note "model retirement: the catalogue answered, but the question of what on this server depends on a model it is withdrawing did not, so it is not known whether any pin or schedule names one; run sudo athanor logs"
        elif [ -n "$retirement_problems" ]; then
          printf '%s\n' "$retirement_problems" |
            while IFS='|' read -r retire_kind retire_who retire_model retire_on retire_name; do
              [ -n "$retire_model" ] || continue
              # The subject and what happens next, per kind, because what happens next is not the
              # same for the two and one sentence for both was false about the worse one.
              #
              # A pin degrades quietly: `pickModelUnderPriceCeiling` in apps/api/src/routes/
              # support.ts ranks instead the moment the pinned id stops resolving, so the account
              # keeps working on a model nobody chose and nothing says so. A schedule does not
              # degrade at all: `dispatchOneDueSchedule` in apps/api/src/maintenance/
              # schedule-dispatch.ts looks the id up in the catalogue itself, forces
              # `model_unavailable` when it is not there, and the run never starts - and after
              # `MODEL_UNAVAILABLE_PAUSE_AFTER` of those it turns the schedule off and writes the
              # owner an event saying it did. That last part is the only reason this warning is
              # worth printing for a schedule: it arrives before the runs start failing, where the
              # pause message arrives after three of them have.
              #
              # The pause count is deliberately not named here. It lives in schedule-dispatch.ts
              # and a second copy of it in this shell is a number that disagrees with itself the
              # first time one of them moves - the same argument as `model_retirement_horizon_days`
              # above, which is read rather than restated because the sentence names it.
              case "$retire_kind" in
                pin)
                  retire_subject="the model $retire_who pinned in Settings"
                  retire_after="it is used until it stops answering, and the ranking then picks for that account instead without saying so"
                  retire_gone="every run it governs is already using the ranking's pick instead of it"
                  retire_remedy="Choose another in Settings, or switch that account back to an automatic pick"
                  ;;
                *)
                  retire_subject="the model a schedule of $retire_who runs on"
                  retire_after="it is used until it stops answering, and then the schedule does not fall back to anything - its runs fail to start, and after a few of them athanor turns the schedule off"
                  retire_gone="its runs are already failing to start, and athanor turns the schedule off once enough of them have"
                  retire_remedy="Choose another model on that schedule before that happens"
                  ;;
              esac
              if [ -n "$retire_on" ]; then
                check_warn "model retirement: $retire_subject - ${retire_name:-$retire_model} ($retire_model) - is withdrawn by its provider on $retire_on. A named model is deliberately exempt from the routing that steers automatic picks away from a dying route, so $retire_after. $retire_remedy"
              else
                check_warn "model retirement: $retire_subject - $retire_model - is not in this server's catalogue at all, so $retire_gone. $retire_remedy"
              fi
            done
        else
          # Said even when there is nothing to warn about, because this is the check whose silence
          # was the defect: a count of zero here is the difference between "no model you depend on
          # is going away" and "nothing has ever looked".
          check_note "model retirement: $retirement_expiring of $retirement_total models in the catalogue are withdrawn by their provider within $retirement_days days, and no pin or schedule on this server names one of them. Automatic picks route around them while anything else is eligible"
        fi
        ;;
      *) check_note "model retirement: the catalogue did not answer, so nothing is known about withdrawals; run sudo athanor logs" ;;
    esac
  elif [ "$retirement_columns" = 0 ] || [ "$retirement_columns" = 1 ]; then
    check_note "model retirement: this release's database has no column for a withdrawal date, so a model the provider is retiring goes on being offered with nothing to say so"
  else
    check_note "model retirement: the database did not answer, so it is not known whether this release can even record a withdrawal date; run sudo athanor logs"
  fi
  # The pre-flight half of the spending brake, reported because a box with a ceiling and a box with
  # none look identical from outside, and the difference is whether anything stops an expensive
  # route being chosen while the owner is asleep. A note rather than a warning: no ceiling is a
  # choice an owner is allowed to make, the same way no daily cap is, and a `doctor` that scolds
  # every default box for the life of that box is a `doctor` nobody finishes reading.
  #
  # Three states here too, and for the identical reason as the retirement guard four lines above:
  # this check sat beside that one printing "this release has no column to store one" over a
  # database that had answered nothing, and two adjacent checks reading the same failure two
  # different ways is worse than either reading alone.
  ceiling_columns=$(spend_ceiling_columns)
  if [ "$ceiling_columns" = 2 ]; then
    ceiling_report=$(spend_ceiling_print)
    if [ -n "$ceiling_report" ]; then
      printf '%s\n' "$ceiling_report" | while IFS= read -r ceiling_line; do
        check_note "model price ceiling - $ceiling_line"
      done
    else
      # Empty is not "none set": every account comes back from the LEFT JOIN whether it has a row
      # in spend_limits or not, so nothing at all means no accounts answered - a box before its
      # first owner, or a database that did not reply.
      check_note "model price ceiling: no account came back from the database, so there is none to report"
    fi
  elif [ "$ceiling_columns" = 0 ] || [ "$ceiling_columns" = 1 ]; then
    check_note "model price ceiling: this release has no column to store one, so nothing limits the price of the model a task picks"
  else
    check_note "model price ceiling: the database did not answer, so it is not known whether anything limits the price of the model a task picks; run sudo athanor logs"
  fi
  # The running half, which is the one that halts a task, and the one no command could reach until
  # `athanor spend-cap` existed. Reported here and nowhere else on a headless box: a cap lives in
  # Settings, Settings is a browser, and an owner setting this computer up over ssh has not opened
  # one yet. A note rather than a warning, and deliberately not an installer prompt - the zero-prompt
  # install is correct, and a question asked before the owner knows what a run of theirs costs is
  # answered by whoever is holding the terminal rather than by whoever is paying.
  if spend_cap_storable; then
    cap_report=$(spend_cap_print)
    if [ -n "$cap_report" ]; then
      printf '%s\n' "$cap_report" | while IFS= read -r cap_line; do
        check_note "spending cap - $cap_line"
      done
    else
      check_note "spending cap: no account came back from the database, so there is none to report"
    fi
  fi
  missing_desktop_tools=""
  for desktop_binary in Xvfb xdpyinfo xprop xauth xrandr xdotool dbus-run-session; do
    command -v "$desktop_binary" >/dev/null 2>&1 ||
      missing_desktop_tools="$missing_desktop_tools $desktop_binary"
  done
  if [ -z "$missing_desktop_tools" ]; then
    check_ok "desktop prerequisites: display, window inspection and control"
  else
    check_warn "desktop tooling is missing:$missing_desktop_tools. Run sudo garden update to repair the installation"
  fi
  # "It could not make my CV" is the report this exists to pre-empt. The skill library prescribes
  # these by name, so a gap here is a job that fails in front of the owner rather than here.
  document_python=/usr/local/lib/athanor/python/bin/python3
  missing_document_tools=""
  [ -x "$document_python" ] || missing_document_tools="$document_python"
  for document_binary in athanor-office-convert athanor-pdf-tables typst soffice qpdf ocrmypdf \
    pdftotext pdftoppm pdffonts pdfinfo magick dot ffmpeg; do
    command -v "$document_binary" >/dev/null 2>&1 ||
      missing_document_tools="$missing_document_tools $document_binary"
  done
  if [ -x "$document_python" ]; then
    for document_module in pptx docx openpyxl pandas pyarrow numpy scipy statsmodels matplotlib PIL pypdf; do
      "$document_python" -c "import $document_module" >/dev/null 2>&1 ||
        missing_document_tools="$missing_document_tools python:$document_module"
    done
  fi
  for document_font in Carlito Caladea 'Liberation Sans' 'DejaVu Sans'; do
    fc-list 2>/dev/null | grep -qi "$document_font" ||
      missing_document_tools="$missing_document_tools font:$document_font"
  done
  if [ -z "$missing_document_tools" ]; then
    check_ok "document toolchain: documents, decks, spreadsheets and PDFs"
  else
    # A note, not a failure. These names are the ones Debian uses, and the installer supports four
    # distribution families - so on Fedora, Arch or openSUSE some of them are simply called
    # something else or come from a package that family does not carry, and reporting that as a
    # broken installation made `doctor` fail forever on three families out of four. What is true is
    # narrower: the jobs needing the missing piece will not work.
    #
    # The advice used to read "On Debian and Ubuntu, sudo athanor update reinstalls it", and it was
    # false in the plainest way: an update installed no packages at all, on any family. The owner of
    # the server this was measured on followed it and nothing happened. It is true now, on all four
    # families, because `install_release_carried_steps` runs the installer's package step - so the
    # sentence names that command, and names the one case it still cannot fix.
    check_warn "some document tooling is missing, so jobs needing it will fail:$missing_document_tools. sudo athanor update installs every package this host's family has for them; a capability the family carries no package for stays missing whatever you run"
  fi
  configured_ddns_provider=$(
    sed -n 's/^DDNS_PROVIDER=//p' "$athanor_config/control.env" 2>/dev/null | sed -n '1p'
  )
  configured_ddns_hostname=$(
    sed -n 's/^DDNS_HOSTNAME=//p' "$athanor_config/control.env" 2>/dev/null | sed -n '1p'
  )
  if [ -n "$configured_ddns_provider" ]; then
    ddns_published_epoch=$(sed -n '2p' "$athanor_state/ddns.state" 2>/dev/null || true)
    case "$ddns_published_epoch" in
      ''|*[!0-9]*) ddns_published_epoch=0 ;;
    esac
    # The publisher re-sends an unchanged address every 24 hours, so a record older
    # than two days means the provider has been rejecting or dropping the update.
    if [ "$(( $(date +%s) - ddns_published_epoch ))" -lt 172800 ]; then
      check_ok "dynamic DNS: $configured_ddns_hostname published through $configured_ddns_provider"
    else
      check_fail "dynamic DNS has not published for two days; run sudo athanor ddns test"
    fi
    if [ -r "$athanor_state/ddns.error" ]; then
      check_note "last dynamic DNS error: $(sed -n '2p' "$athanor_state/ddns.error")"
    fi
  else
    check_note "dynamic DNS is not configured"
  fi
  # Off is the shipped state and the right one for most servers: a public address or a
  # dynamic-DNS name reaches this computer directly, with nobody in between. Saying so plainly
  # matters, because a check that only ever mentions the relay when it is missing reads as a
  # server that is not finished.
  if [ "$(relay_setting .enabled)" != true ]; then
    check_note "relay: off, and that is fine - this server is reached directly, with nobody in between"
  else
    relay_hostname=$(relay_public_hostname)
    case "$(relay_status_value .state)" in
      online)
        check_ok "relay: online at $relay_hostname$(relay_used_summary)"
        case "$(relay_status_value .quota)" in
          warn) check_warn "relay: close to the traffic allowance the relay operator granted" ;;
          shaped) check_warn "relay: over the allowance and being slowed by the relay" ;;
          blocked) check_fail "relay: over the allowance and blocked by the relay; use a direct address until the next period" ;;
        esac
        ;;
      connecting|waiting)
        check_warn "relay: not connected at the moment; clients using $relay_hostname cannot reach this server until it reconnects"
        ;;
      revoked)
        check_fail "relay: the relay operator revoked this server; enroll again or run sudo athanor relay off"
        ;;
      *)
        check_warn "relay: switched on but the connection has not reported in; run sudo athanor logs"
        ;;
    esac
  fi
  # Two separate things have to be true before anyone can sign in from a browser, and each one on
  # its own looks like success. A WebAuthn Relying Party ID has to be a registrable domain name,
  # because the specification does not allow an address literal. And the page has to be one the
  # browser trusts: a certificate error switches WebAuthn off entirely, which accepting the warning
  # does not undo. Either one missing leaves the owner able to sign in from a native client only.
  configured_rp_id=$(
    sed -n 's/^WEBAUTHN_RP_ID=//p' "$athanor_config/control.env" 2>/dev/null | sed -n '1p'
  )
  case "$configured_rp_id" in
    ''|'['*|*:*) rp_id_is_hostname="" ;;
    *[!0-9.]*) rp_id_is_hostname=yes ;;
    *) rp_id_is_hostname="" ;;
  esac
  certificate_trust=$(certificate_trust_state)
  if [ -n "$rp_id_is_hostname" ]; then
    case "$certificate_trust" in
      trusted) check_ok "browser sign-in origin https://$configured_rp_id" ;;
      self-signed)
        check_warn "browser sign-in cannot work at https://$configured_rp_id yet: this server is serving a certificate it signed itself, and a browser will not create or use a passkey on a page whose certificate it does not trust"
        check_warn "to finish: sudo athanor certificate enable --agree-tos --email you@example.com"
        ;;
      *)
        check_warn "browser sign-in origin https://$configured_rp_id: the name is right, but what certificate this server is serving could not be confirmed, and a browser refuses a passkey on one it does not trust; run sudo athanor certificate status"
        ;;
    esac
  else
    check_warn "this server has no hostname, so browser sign-in cannot work: a passkey is bound to a domain name and the standard does not allow an IP address"
    if [ -n "$configured_ddns_provider" ]; then
      check_warn "dynamic DNS publishes $configured_ddns_hostname but it is not the public origin; run sudo athanor set-hostname $configured_ddns_hostname"
    else
      # A fixed address needs one A record, which is what a rented server has. Dynamic DNS chases an
      # address that moves and is the answer to a different question, so it is named second.
      check_warn "fixed address: point a domain at this server and run sudo athanor set-hostname your.domain"
      check_warn "address that changes, as on a home connection: sudo athanor ddns configure"
    fi
  fi
  expected_identity=$(
    openssl pkey -in "$athanor_config/tls/server.key" -pubout 2>/dev/null |
      openssl pkey -pubin -outform DER 2>/dev/null |
      openssl dgst -sha256 -binary |
      openssl base64 -A
  )
  manifest_identity=$(
    jq -r '.identity // empty' "$athanor_state/connection.json" 2>/dev/null || true
  )
  if [ "$manifest_identity" = "sha256/$expected_identity" ]; then
    check_ok "stable connection identity"
  else
    check_fail "connection manifest does not match the server identity"
  fi
  # "It answered" and "it can actually work" are different diagnoses that lead to different next
  # steps, so both are reported. The second reuses release_readiness_failure - the same function the
  # update's rollback gate trusts - rather than probing /healthz, which this file's own comment
  # above explains is a static literal that is true of a build serving an error to every request.
  # One copy of the readiness rules, because a second copy is a second chance to drift back to
  # checking the literal.
  if curl -fsS --max-time 5 http://127.0.0.1:4100/healthz >/dev/null 2>&1; then
    check_ok "API is answering"
    readiness=$(release_readiness_failure)
    if [ -n "$readiness" ]; then
      check_fail "the running release is not usable: $readiness"
    else
      check_ok "the running release is serving real requests"
    fi
  else
    check_fail "API is not answering at all; run sudo athanor logs"
  fi
  # The notifier stays up and serves this endpoint when Web Push is not configured, because an
  # optional feature that crash-loops a unit hides its own reason. So "it answered" is not the same
  # as "notifications are being delivered", and the endpoint says which of the two this is.
  notifications_health=$(curl -fsS --max-time 5 http://127.0.0.1:4203/healthz 2>/dev/null || true)
  # One number out of the payload: digits, `null` when the service could not count, and the empty
  # string when the field is not there at all. Read with sed rather than jq because this arm has to
  # speak on a box where jq is one of the things that is broken, and as two expressions rather
  # than one alternation because alternation is not in the sed every box has.
  notifications_count() {
    printf '%s' "$notifications_health" |
      sed -n -e "s/.*\"$1\":\([0-9][0-9]*\)[,}].*/\1/p" -e t \
        -e "s/.*\"$1\":null[,}].*/null/p"
  }
  case "$notifications_health" in
    *'"deliveryEnabled":false'*)
      check_warn "push notifications are switched off: no Web Push signing keys in /etc/athanor/control.env; re-run the installer to generate a pair"
      ;;
    *'"endpointsFailing":0'*)
      # Zero refusing is trivially true of a box nobody has ever subscribed a device to, and that
      # is the commonest real state: measured on a live box with no subscription, no paired phone
      # and four cards parked waiting for a person, this line said `ok`. So "every device is
      # healthy" and "there is no device" are told apart here, by the counts of what exists, and
      # only the first is health. A count the service could not make is a third answer again.
      endpoints_total=$(notifications_count endpointsTotal)
      destinations_paired=$(notifications_count destinationsPaired)
      case "$endpoints_total:$destinations_paired" in
        0:0)
          check_warn "no device or phone is enrolled for notifications, so nothing can tell you when a task stops to ask; on the device that should be told, open Settings and press \"Turn on notifications\", or pair a phone under Settings, \"Your phone\""
          ;;
        *null*|*:|:*)
          check_note "push notification delivery: the service is sending but could not count the devices and phones enrolled to receive, so it is not known whether anything can be reached; run sudo athanor logs notifications"
          ;;
        *)
          # What exists is a route only while the half of the service that reaches it is up. A
          # paired phone is the owner's half; this box's half is reading from it, which stops
          # without a DATA_MASTER_KEY to open the bot token with - and then the phone cannot be
          # sent to either. Measured on a box with no key, no browser subscription and one paired
          # phone: this line said `ok`, one line above the warning saying the phone could not be
          # read from. A subscribed device with the signing keys removed since is the same shape.
          notifications_reachable=""
          if [ "$endpoints_total" != 0 ]; then
            case "$notifications_health" in
              *'"pushEnabled":false'*) ;;
              *) notifications_reachable=yes ;;
            esac
          fi
          if [ "$destinations_paired" != 0 ]; then
            case "$notifications_health" in
              *'"paired":true,"polling":true'*) notifications_reachable=yes ;;
            esac
          fi
          if [ -n "$notifications_reachable" ]; then
            check_ok "push notification delivery"
          elif [ "$destinations_paired" != 0 ]; then
            check_warn "the only notification route is a paired phone this box is not reading from, so nothing can tell you when a task stops to ask; check DATA_MASTER_KEY in /etc/athanor/control.env and run sudo athanor logs notifications"
          else
            check_warn "a device is subscribed for notifications but there are no Web Push signing keys to send to it with; re-run the installer to generate a pair"
          fi
          ;;
      esac
      ;;
    # Keys configured, the service sending, and a device not receiving. The one thing that cannot
    # report a broken push is a push, so this is where the owner finds out.
    *'"endpointsFailing"'*)
      check_warn "a device is refusing notifications and is being retried with a growing wait; run sudo athanor logs notifications to see which push service and why"
      ;;
    # A notifier too old to count refusing endpoints says nothing about them, and silence is not a
    # warning: keys are configured and it is sending, which is all the older build could report.
    *'"deliveryEnabled":true'*) check_ok "push notification delivery" ;;
    *) check_fail "the notification service is not answering; run sudo athanor logs" ;;
  esac
  # The phone transport's own line. Paired is the owner's half; polling is this box's, and the one
  # reason it stops while paired is a DATA_MASTER_KEY the service cannot open the bot token with.
  case "$notifications_health" in
    *'"paired":true,"polling":false'*)
      check_warn "a phone is paired for notifications but the service is not reading from it; check DATA_MASTER_KEY in /etc/athanor/control.env and run sudo athanor logs notifications"
      ;;
    *'"paired":true,"polling":true'*) check_ok "phone notification transport" ;;
  esac
  if pg_isready -q -h 127.0.0.1 -U athanor -d athanor; then
    check_ok "PostgreSQL"
  else
    check_fail "PostgreSQL"
  fi
  # Stock Debian maps a Unix account to the same-named database role over the local socket. The
  # agent computer runs on this host and the role is called athanor too, so if this ever answers
  # a command can open the database as the owner of every encrypted row.
  if runuser -u athanor -- psql -h /var/run/postgresql -U athanor -d athanor \
    -c 'SELECT 1' >/dev/null 2>&1; then
    check_fail "the database still accepts local socket authentication as athanor; re-run the installer"
  else
    check_ok "database reachable only with the password in root-owned configuration"
  fi
  # These two are what make the boundary in SECURITY.md true. A command that runs as the runner's
  # own account can read the runner's process and its capability signing secret, and a root
  # package helper on the agent's PATH is a root install with no approval card.
  configured_sandbox=$(
    sed -n 's/^AGENT_SANDBOX_HELPER=//p' "$athanor_config/runner.env" 2>/dev/null | sed -n '1p'
  )
  if [ -n "$configured_sandbox" ] && [ -x "$configured_sandbox" ] &&
    runuser -u athanor -- sudo -n "$configured_sandbox" check 2>/dev/null |
    grep -q '^user=athanor-agent$'; then
    check_ok "agent commands run as athanor-agent, not as the runner"
  else
    check_fail "agent commands are not confined to their own account; re-run the installer"
  fi
  # The other boundary, and the one the owner had no way to see at all.
  #
  # `doctor` reported the identity boundary above and said nothing about the filesystem, which is
  # the newest of the three and the one that shipped switched off: no update ever wrote
  # CONFINE_AGENT_FILESYSTEM into runner.env, so a server updated to the release that added Landlock
  # answered `filesystem=landlock` from the helper and `agentFilesystemConfined: false` from the
  # runner at the same moment, and nothing anywhere said so.
  #
  # READ FROM THE RUNNER, NOT FROM THE SETTING, because the setting is the thing that was wrong.
  # /healthz reports what the process actually built its sandbox with; runner.env reports what
  # somebody asked for. A runner too old to publish the field is not evidence either way and is
  # a note.
  #
  # A KERNEL THAT HONESTLY CANNOT IS A NOTE AND NOT A FAULT. Landlock needs a kernel and a
  # util-linux that have it; without them every command still runs as athanor-agent under the
  # network policy, and calling that broken would fail `doctor` for the life of a machine whose
  # owner can do nothing about it. So when the runner says false, the helper is asked whether the
  # rung was available: available and not in force is a fault an update repairs, unavailable is a
  # note that says which boundaries are.
  #
  # A bare `[a-z][a-z]*` rather than a `true\|false` alternation: `\|` is a GNU extension that BSD
  # sed reads as a literal, so the whole expression matched nothing on a developer machine and this
  # arm reported "the runner does not say" against a runner that had just said. The value is
  # examined below instead, where anything that is neither word falls through to the same note.
  runner_filesystem_rung=$(
    curl -fsS --max-time 5 http://127.0.0.1:4300/healthz 2>/dev/null | tr ',' '\n' |
      sed -n 's/.*"agentFilesystemConfined"[[:space:]]*:[[:space:]]*\([a-z][a-z]*\).*/\1/p' |
      sed -n '1p'
  )
  case "$runner_filesystem_rung" in
    true) check_ok "agent commands are confined to their own workspace as well as their own account" ;;
    false)
      if [ -n "$configured_sandbox" ] && [ -x "$configured_sandbox" ] &&
        runuser -u athanor -- sudo -n "$configured_sandbox" check 2>/dev/null |
        grep -q '^filesystem=landlock$'; then
        check_fail "this kernel can confine agent commands to their own workspace and the runner is not doing it; CONFINE_AGENT_FILESYSTEM is missing or false in $athanor_config/runner.env - sudo athanor update writes it from what this kernel measures"
      else
        check_note "agent commands are not confined to their own workspace: this kernel or util-linux has no Landlock, so the account and network boundaries are the ones in force"
      fi
      ;;
    *) check_note "this runner does not report whether agent commands are confined to their own workspace, so it predates that boundary" ;;
  esac
  if [ -e /usr/local/bin/athanor-package-helper ]; then
    check_fail "the root package helper is still on the agent PATH; run sudo athanor update"
  else
    check_ok "root helpers are off the agent PATH"
  fi
  if nginx -t >/dev/null 2>&1; then
    check_ok "TLS gateway configuration"
  else
    check_fail "TLS gateway configuration"
  fi
  # The failure this catches looks like nothing at all: every service running, every log clean, and
  # the whole site answering 403. SELinux forbids the proxy from opening a loopback connection
  # unless this boolean is on, and the athanor API is exactly that.
  if command -v getenforce >/dev/null 2>&1 && [ "$(getenforce 2>/dev/null)" = "Enforcing" ]; then
    if [ "$(getsebool httpd_can_network_connect 2>/dev/null | sed 's/.*--> //')" = "on" ]; then
      check_ok "SELinux permits the gateway to reach athanor"
    else
      check_fail "SELinux is refusing the gateway; run: setsebool -P httpd_can_network_connect 1"
    fi
  fi
  served_certificate="$athanor_config/tls/server.crt"
  certificate_expiry=$(
    openssl x509 -in "$served_certificate" -noout -enddate 2>/dev/null |
      sed 's/^notAfter=//'
  )
  # A certificate covering a bare address is issued under the shortlived profile and lasts 160
  # hours by design, so a flat 30-day margin would report a healthy server as failing every day
  # of its life. The margin has to match the certificate's own lifetime, exactly as the renewal
  # threshold does: renewal starts at 72 hours, so anything above that is on schedule.
  if openssl x509 -in "$served_certificate" -noout -ext subjectAltName 2>/dev/null |
    grep -q 'IP Address'; then
    certificate_margin=259200
    certificate_margin_label="72 hours"
  else
    certificate_margin=2592000
    certificate_margin_label="30 days"
  fi
  # Recorded by the renewal timer. Reported even when the served certificate is still inside its
  # margin: a renewal that has been failing for a day is the only warning before the certificate
  # runs out, and after that the owner's first sign of trouble is a browser refusing to connect.
  if [ -r "$athanor_state/certificate.error" ]; then
    check_fail "TLS renewal failed at $(sed -n '1p' "$athanor_state/certificate.error"): $(sed -n '2p' "$athanor_state/certificate.error")"
  fi
  if openssl x509 -in "$served_certificate" -noout -checkend "$certificate_margin" >/dev/null 2>&1; then
    # A self-signed certificate is written with 825 days on it, so an expiry test alone calls it
    # healthy for over two years and says nothing a browser agrees with. What the browser does with
    # it is the fact worth reporting, because it is the whole of the owner's first hour: a full-page
    # warning, no installable app, no notifications, and no passkey.
    case "$certificate_trust" in
      trusted) check_ok "TLS certificate valid until $certificate_expiry" ;;
      self-signed)
        check_warn "TLS certificate is self-signed, valid until $certificate_expiry: browsers warn on every visit and refuse to create a passkey, so no owner account can be made from a browser. Run sudo athanor certificate enable --agree-tos --email you@example.com"
        ;;
      *)
        check_warn "TLS certificate valid until $certificate_expiry, but who issued it could not be confirmed, so whether a browser will accept this server is unknown; run sudo athanor certificate status"
        ;;
    esac
  elif [ "$(control_env_value ACME_ENABLED)" = true ]; then
    check_fail "TLS certificate expires within $certificate_margin_label and renewal has not replaced it ($certificate_expiry)"
  else
    check_fail "TLS certificate expires within $certificate_margin_label ($certificate_expiry); run sudo athanor certificate enable --agree-tos --email you@example.com"
  fi
  if
    ss -ltnH | awk '
      {
        count = split($4, fields, ":")
        port = fields[count]
        if (port ~ /^(4100|4201|4203|4300|4400)$/) {
          if ($4 !~ /^127[.]0[.]0[.]1:/ && $4 !~ /^\[::1\]:/) exposed = 1
          found[port] = 1
        }
      }
      END {
        required[4100] = required[4201] = required[4203] = 1
        required[4300] = required[4400] = 1
        for (port in required) if (!found[port]) missing = 1
        exit exposed || missing
      }
    '
  then
    check_ok "private service ports are loopback-only"
  else
    check_fail "one or more private services are missing or exposed"
  fi
  if
    runuser -u athanor -- curl -fsSI --max-time 15 https://openrouter.ai/ >/dev/null 2>&1
  then
    check_ok "agent computer internet access"
  else
    check_fail "agent computer cannot reach the internet"
  fi
  # The revision, not the directory. Asking whether ~/.cache/ms-playwright exists answered yes on a
  # box whose browser was a release behind the code that launches it, which is the state every box
  # reaches the first time the pinned Playwright is bumped.
  if runuser -u athanor -- /usr/local/lib/athanor/athanor-gui-broker check >/dev/null 2>&1; then
    check_ok "unprivileged project GUI namespace broker"
  else
    check_fail "project GUI isolation is unavailable; check athanor-gui.service and run garden update"
  fi
  chromium_wanted=$(managed_chromium_revision)
  if [ -z "$chromium_wanted" ]; then
    check_fail "which Chromium this release wants could not be read; the pinned Playwright dependency is missing from the workspace runner"
  elif [ -n "$(managed_chromium_absent)" ]; then
    check_fail "the managed Chromium this release drives (revision $chromium_wanted) is not on this server, so every job needing a browser will fail; sudo athanor update fetches it"
  else
    check_ok "managed Chromium dependency (revision $chromium_wanted)"
  fi
  # Whether an update could arrive at all, which is a different question from whether the timer is
  # enabled. A checkout that is not following a branch reports "on" and never moves.
  if git -C "$athanor_root" rev-parse --abbrev-ref '@{upstream}' >/dev/null 2>&1; then
    update_source_ok=yes
  else
    update_source_ok=""
  fi
  if [ -z "$update_source_ok" ]; then
    check_warn "this checkout follows no branch, so no update can ever arrive; sudo athanor update repairs it"
  fi
  if systemctl is-enabled --quiet "$auto_update_timer" 2>/dev/null; then
    check_note "unattended updates are on (weekly)"
  else
    check_note "unattended updates are off; run sudo athanor auto-update on to enable them"
  fi
  # What the last update run actually did, which is a different question from whether the timer is
  # on - and the one nothing here used to ask, on the arm of this product that is supposed to keep
  # the box current while nobody is watching. A failed unattended update leaves a healthy server:
  # the rollback works, every check below passes, and the box simply stops moving. Every stretch of
  # weeks it stays stopped is a stretch with no security fix. The daily backup has had all three of
  # these - a companion unit, a record, and this - one directory over.
  update_outcome=$(update_status_field outcome)
  update_at=$(update_status_field at)
  update_reason=$(update_status_field reason)
  case "$update_outcome" in
    '')
      if [ -n "$update_source_ok" ]; then
        check_note "no update run recorded yet"
      fi
      ;;
    ok) check_ok "last update run $update_at: ${update_reason:-complete} (revision $(update_status_field revision))" ;;
    running)
      check_warn "an update run started $update_at and has not reported back; if it is not still going, sudo athanor doctor after sudo athanor auto-update run"
      ;;
    skipped)
      # A warning, not a note. Standing down for a running task is the design; standing down every
      # week is a box that has quietly stopped updating, and nothing distinguishes the two from
      # outside except that this line keeps appearing.
      check_warn "the last update run stood down at $update_at - $update_reason; if this repeats, run sudo athanor update at a quiet moment"
      ;;
    *)
      check_fail "the last update run failed at $update_at - $update_reason; run sudo athanor logs and sudo athanor update"
      ;;
  esac
  # Off and never installed are different faults with different repairs, and `is-enabled --quiet`
  # cannot tell them apart: it answers no to both. Only one of them is fixed by switching backups on,
  # because `systemctl enable` on a unit that is not on the disk fails - so a server that was updated
  # across the release adding these units, and never received them, was being sent at a command that
  # could not work. Reported and not repaired: a diagnostic that enables a timer on the owner's
  # behalf is one they cannot run to find out where they stand.
  backup_timer_state=$(systemctl is-enabled "$backup_timer" 2>/dev/null || true)
  case "$backup_timer_state" in
    enabled|enabled-runtime) backup_timer_on=yes ;;
    *) backup_timer_on="" ;;
  esac
  if [ "$backup_timer_state" = not-found ]; then
    check_warn "the daily backup timer is not installed on this server, so no backup will ever be taken on its own; sudo athanor update places it"
    backup_timer_repair="sudo athanor update installs the daily timer, then sudo athanor backup auto on switches it on"
  else
    backup_timer_repair="sudo athanor backup auto on takes one daily"
  fi
  # Twenty-five checks and not one of them used to mention backups, on a product whose whole promise
  # is that it keeps running while nobody is watching. A copy that does not exist is the one fault
  # here that cannot be repaired after the fact.
  backup_age=$(latest_backup_age)
  # What the last run did, which is a different question from how old the newest copy is. "No
  # backup yet; the daily window will take the first one" was the friendliest thing this check
  # could say and, on a box whose every window had stood down for a busy worker, the least true.
  backup_outcome=$(backup_status_field outcome)
  backup_reason=$(backup_status_field reason)
  case "$backup_age" in
    '')
      case "$backup_outcome" in
        skipped|failed)
          check_fail "no backup exists; the last run $backup_outcome - $backup_reason. Run sudo athanor backup to take one now"
          ;;
        *)
          if [ -n "$backup_timer_on" ]; then
            check_note "no backup yet; the daily window will take the first one"
          else
            check_warn "no backup exists: $backup_timer_repair"
          fi
          ;;
      esac
      ;;
    0|1|2)
      if [ "$backup_outcome" = failed ]; then
        check_warn "newest backup ${backup_age} days old, but the last run failed - $backup_reason"
      else
        check_ok "newest backup ${backup_age} days old"
      fi
      ;;
    *)
      if [ "$backup_outcome" = failed ] || [ "$backup_outcome" = skipped ]; then
        check_warn "newest backup is $backup_age days old; the last run $backup_outcome - $backup_reason"
      elif [ -n "$backup_timer_on" ]; then
        check_warn "newest backup is $backup_age days old; check athanor logs for why the daily run stopped"
      else
        check_warn "newest backup is $backup_age days old: $backup_timer_repair"
      fi
      ;;
  esac
  # Whether the copies exist anywhere but on the disk they are copies of. Every check above can be
  # green on a box whose only backups die with the data: five verified copies in /var/backups is
  # five copies of one disk. `off` is a note rather than a warning because naming a second place
  # needs hardware this report cannot conjure, and nagging daily about a disk the owner has not
  # bought is how a report stops being read.
  case "$(backup_status_field off_host)" in
    ok) check_ok "the newest backup was also copied off-host, encrypted" ;;
    failed)
      check_warn "copied locally, not yet off-host - $(backup_status_field off_host_reason)"
      ;;
    running)
      check_warn "copied locally; the off-host copy started and never reported back, so it was cut off by the backup unit's own time limit. The local copy is complete"
      ;;
    *)
      # No off-host line at all, which two very different boxes reach. `record_backup_status`
      # rewrites this file from nothing on every run, so a run that stood down for a busy worker -
      # the designed ordinary outcome, not a fault - or one that failed outright takes the
      # off-host field of the copy before it away with it. Reading the record alone therefore told
      # an owner who had already named a second disk that their backups were on one, which is
      # false, and pointed them at the command they had already run. The configuration is what
      # tells the two apart, and it is asked here for that reason. It is read the way the ACME and
      # model-catalogue checks above read theirs; `doctor` is root already.
      if [ -n "$(control_env_value BACKUP_DESTINATION)" ]; then
        check_note "an off-host destination is named, and the last run recorded nothing about the copy, which is what a run that stood down or failed leaves behind; sudo athanor backup destination show"
      else
        check_note "backups are kept on this computer only, on the same disk as the data; sudo athanor backup destination names a second place"
      fi
      ;;
  esac
  available_kb=$(df -Pk "$athanor_home" | awk 'NR == 2 {print $4}')
  if [ "$available_kb" -ge 10485760 ]; then
    check_ok "disk headroom $((available_kb / 1048576)) GiB"
  else
    check_fail "less than 10 GiB disk headroom"
  fi
  [ "$failed" -eq 0 ]
}

connection_details() {
  [ -r "$athanor_config/control.env" ] ||
    fail "run this command as root to read the active pairing code"
  pairing_code=$(sed -n 's/^REGISTRATION_BOOTSTRAP_TOKEN=//p' "$athanor_config/control.env")
  pairing_expires=$(sed -n 's/^REGISTRATION_BOOTSTRAP_EXPIRES_AT=//p' "$athanor_config/control.env")
  current_epoch=$(date +%s)
  case "$pairing_expires" in
    ''|*[!0-9]*) pairing_expires=0 ;;
  esac
  if [ -z "$pairing_code" ] || [ "$pairing_expires" -le "$current_epoch" ]; then
    pairing_code=$(openssl rand -hex 16)
    pairing_expires=$((current_epoch + 86400))
    set_control_value REGISTRATION_BOOTSTRAP_TOKEN "$pairing_code"
    set_control_value REGISTRATION_BOOTSTRAP_EXPIRES_AT "$pairing_expires"
    systemctl restart athanor@api.service
    wait_until_serving
  fi
  identity_key="$athanor_config/tls/server.key"
  [ -f "$identity_key" ] || fail "server identity key is missing"
  server_identity=$(
    openssl pkey -in "$identity_key" -pubout 2>/dev/null |
      openssl pkey -pubin -outform DER 2>/dev/null |
      openssl dgst -sha256 -binary |
      openssl base64 -A
  )
  "$(runtime_path /usr/local/lib/athanor/athanor-network-refresh)"
  endpoints_json=$(jq -c '.endpoints' "$athanor_state/connection.json")
  ticket=$(
    # The JavaScript is intentionally single-quoted so the shell cannot expand ticket data.
    # shellcheck disable=SC2016
    node -e '
      const payload = {
        version: 2,
        endpoints: JSON.parse(process.argv[1]),
        identity: `sha256/${process.argv[2]}`,
        discovery: { mdnsService: "_athanor._tcp.local", mdnsPort: 443 },
        pairingCode: process.argv[3],
        expiresAt: Number(process.argv[4])
      };
      process.stdout.write(Buffer.from(JSON.stringify(payload)).toString("base64url"));
    ' "$endpoints_json" "$server_identity" "$pairing_code" "$pairing_expires"
  )
  pairing_uri="garden://pair/$ticket"
  # The code has to encode an ordinary address, not the `athanor://` link: the device being paired
  # is the one with nothing installed, so a phone pointed at that link opened nothing at all. Same
  # shape the server mints for the settings screen, and the same shape the installer prints.
  public_url=$(control_env_value PUBLIC_APP_URL)
  if [ -n "$public_url" ]; then
    printf '\nOpen your computer at: %s\n' "$public_url"
    printf '\nOr scan this from a phone:\n\n'
    qrencode -t ANSIUTF8 "$public_url/#pair=$ticket" 2>/dev/null ||
      printf '  %s\n' "$public_url/#pair=$ticket"
  fi
  printf '\nOne-time pairing code, if you opened the address by hand: %s\n' "$pairing_code"
  printf 'Connection ticket, for the native client:\n%s\n' "$pairing_uri"
  printf '\n%s\n' '────────────────────────────────────────────────────────────'
  printf 'Detected endpoints:\n'
  printf '%s' "$endpoints_json" | jq -r '.[] | "  " + .'
  printf 'Server identity: sha256/%s\n' "$server_identity"
}

# Reachability through a relay is settings-screen work - enrolling needs a token from the relay
# operator, and only the running server can redeem one. What belongs on the server itself is the
# honest picture and the switch that ends the tunnel without a browser.
relay_command() {
  need_root relay "$@"
  case "${1:-status}" in
    status)
      if [ "$(relay_setting .enabled)" != true ]; then
        printf 'Relay: off\n'
        if [ -n "$(relay_setting .label)" ]; then
          printf 'An enrollment with %s is saved; turn it back on with sudo athanor relay on.\n' \
            "$(relay_setting .host)"
        else
          printf 'This server is reached directly, with nobody in between. A relay is only needed\n'
          printf 'when inbound connections cannot arrive at all - see docs/relay.md.\n'
        fi
        return 0
      fi
      printf 'Relay:    on, through %s\n' "$(relay_setting .host)"
      printf 'Address:  https://%s\n' "$(relay_public_hostname)"
      printf 'State:    %s%s\n' \
        "$(relay_status_value .state)" "$(relay_used_summary)"
      relay_error=$(relay_status_value .lastError)
      [ -z "$relay_error" ] || printf 'Last error: %s\n' "$relay_error"
      printf 'The relay operator sees connection metadata and byte counts. They cannot read the\n'
      printf 'traffic: TLS terminates on this computer.\n'
      ;;
    on)
      [ -n "$(relay_setting .label)" ] ||
        fail "this server has no relay enrollment; add one from Settings, which needs a hostname and an enrollment token"
      relay_set_enabled true
      printf 'The relay is on again at https://%s\n' "$(relay_public_hostname)"
      ;;
    off)
      [ -r "$relay_settings" ] || fail "this server has no relay to turn off"
      relay_set_enabled false
      printf 'The relay is off: the tunnel is closed and this server no longer advertises the relay\n'
      printf 'address. The enrollment is kept, so sudo athanor relay on needs no new token.\n'
      ;;
    *) fail "usage: athanor relay {status|on|off}" ;;
  esac
}

# The API owns this file, so the ownership and mode have to be put back exactly: it holds the
# relay identity's settings and nothing but the control account may read them.
relay_set_enabled() {
  relay_temp=$(mktemp "$relay_settings.XXXXXX")
  jq --argjson enabled "$1" '.enabled = $enabled' "$relay_settings" >"$relay_temp" || {
    rm -f "$relay_temp"
    fail "the relay settings could not be read"
  }
  chmod 0600 "$relay_temp"
  chown athanor-control:athanor-control "$relay_temp"
  mv "$relay_temp" "$relay_settings"
  # The running server holds the connection open, so the file alone does not close it.
  systemctl restart athanor@api.service
  wait_until_serving
  "$(runtime_path /usr/local/lib/athanor/athanor-network-refresh)"
}

pairing_code() {
  need_root pairing-code
  fresh_code=$(openssl rand -hex 16)
  fresh_expiry=$(( $(date +%s) + 86400 ))
  set_control_value REGISTRATION_BOOTSTRAP_TOKEN "$fresh_code"
  set_control_value REGISTRATION_BOOTSTRAP_EXPIRES_AT "$fresh_expiry"
  systemctl restart athanor@api.service
  connection_details
  printf '\nThis code expires in 24 hours and is consumed when the first owner is created.\n'
}

# Where this computer answers, written as the five settings that have to agree.
#
# They are one fact in five places and they only make sense together: an origin that disagrees with
# the WebAuthn relying party is a server that serves pages on which a browser will refuse to create
# a passkey at all. Written here once because two callers now move them - `set-hostname`, and the
# fresh-host arm of `restore` - and a second copy of five lines is a second thing free to drift.
#
# The bracket forms are for an IPv6 literal, and match what the installer writes for the same
# address. A DNS name takes neither branch's brackets, so this is byte-for-byte what
# `set-hostname` wrote before it called through here.
set_public_origin() {
  origin_host="$1"
  case "$origin_host" in
    *:*)
      origin_url="https://[$origin_host]"
      origin_rp_id="[$origin_host]"
      ;;
    *)
      origin_url="https://$origin_host"
      origin_rp_id="$origin_host"
      ;;
  esac
  previous_origin=$(control_env_value PUBLIC_APP_URL)
  previous_preview=$(control_env_value PREVIEW_BASE_URL)
  set_control_value PUBLIC_APP_URL "$origin_url"
  case "$previous_preview" in
    ''|"$previous_origin/__athanor/preview"|"$previous_origin:8443/__athanor/preview")
      set_control_value PREVIEW_BASE_URL "$origin_url:8443/__athanor/preview"
      ;;
  esac
  /bin/sh "$athanor_root/scripts/athanor-native-runtime" preview-origin
  set_control_value PUBLIC_RUNNER_URL "$(printf 'wss://%s/runner' "${origin_url#https://}")"
  set_control_value WEBAUTHN_RP_ID "$origin_rp_id"
  set_control_value WEBAUTHN_ORIGIN "$origin_url"
}

# This computer's own globally routable addresses, one per line.
#
# The same reading, with the same interfaces left out, as athanor-network-refresh: a container
# bridge is an address nothing outside this machine can reach, and on a box that runs containers it
# is frequently the first one `ip` lists. Answers with nothing at all when `ip` is absent or has
# nothing to say, and every caller here treats "no addresses" as "do not guess".
host_global_addresses() {
  ip -o -4 address show scope global 2>/dev/null |
    awk '$2 !~ /^(docker|br-|veth|cni|podman|virbr)/ {
      address = $4
      sub(/\/.*/, "", address)
      print address
    }' | sort -u
  ip -o -6 address show scope global -temporary 2>/dev/null |
    awk '$2 !~ /^(docker|br-|veth|cni|podman|virbr)/ {
      address = $4
      sub(/\/.*/, "", address)
      print address
    }' | sort -u
}

# The address a client outside this machine should be given, chosen the way the installer chooses
# it: a public IPv4 first, then anything at all rather than nothing. Private ranges are passed over
# only while something better exists, because a box on a home LAN has nothing else to offer and an
# origin on 192.168.1.20 is one its owner can actually open.
#
# Said plainly: this is the installer's address half and not its name half. The installer also
# hunts for a name - `hostname -f`, then reverse DNS on each address, each forward-confirmed - and
# none of that is repeated here, so a restored machine whose provider gave it a name gets an
# address origin rather than that name. `--hostname NAME` is what asks for a name, and the
# fresh-host arm prints it. Duplicating eighty lines of search into a second copy free to drift
# from the first is the cost that was not worth paying for a case one flag already answers.
host_primary_address() {
  primary_address=""
  for candidate_address in $(host_global_addresses); do
    case "$candidate_address" in
      10.*|127.*|169.254.*|192.168.*|*:*) continue ;;
      172.*)
        candidate_second_octet=$(printf '%s' "$candidate_address" | cut -d. -f2)
        if [ "$candidate_second_octet" -ge 16 ] && [ "$candidate_second_octet" -le 31 ]; then
          continue
        fi
        ;;
    esac
    primary_address="$candidate_address"
    break
  done
  if [ -z "$primary_address" ]; then
    primary_address=$(host_global_addresses | sed -n '1p')
  fi
  [ -z "$primary_address" ] || printf '%s\n' "$primary_address"
}

# Whether the origin a backup carries still names the computer it has just been restored onto.
#
# The commonest planned move keeps the domain and changes the machine underneath it, and on that
# move the restored PUBLIC_APP_URL is not stale at all: replacing it with an address would throw
# away every browser passkey bound to the name, which is the opposite of the repair. So the name is
# forward-confirmed against this machine's own addresses, exactly as the installer confirms the one
# it discovers, and only a name that does not land here is replaced.
#
# An address literal answers no whatever it resolves to. An address cannot have followed a machine:
# that is the whole of what went wrong.
restored_origin_reaches_here() {
  origin_candidate="$1"
  case "$origin_candidate" in
    ''|*[!A-Za-z0-9.-]*|.*|-*|*.) return 1 ;;
    *.*) ;;
    *) return 1 ;;
  esac
  case "$origin_candidate" in
    *[!0-9.]*) ;;
    *) return 1 ;;
  esac
  origin_resolved=$(getent ahosts "$origin_candidate" 2>/dev/null | awk '{print $1}' | sort -u)
  [ -n "$origin_resolved" ] || return 1
  for local_address in $(host_global_addresses); do
    if printf '%s\n' "$origin_resolved" | grep -Fqx "$local_address"; then
      return 0
    fi
  done
  return 1
}

set_hostname() {
  need_root set-hostname "${1:-}"
  requested_hostname="${1:-}"
  hostname_value=$(
    node -e '
      const value = process.argv[1].trim().toLowerCase().replace(/[.]$/, "");
      const labels = value.split(".");
      if (
        value.length > 253 ||
        labels.length < 2 ||
        labels.some((label) =>
          !/^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$/.test(label)
        )
      ) process.exit(1);
      process.stdout.write(value);
    ' "$requested_hostname"
  ) || fail "use a DNS hostname such as ai.example.com"
  getent ahosts "$hostname_value" >/dev/null 2>&1 ||
    fail "$hostname_value does not resolve yet; finish dynamic-DNS setup and try again"

  set_public_origin "$hostname_value"
  "$(runtime_path /usr/local/lib/athanor/athanor-network-refresh)"
  # A trusted certificate issued before this hostname existed does not carry it, and a browser
  # reaching the new origin would get a name mismatch. Reissue now rather than leaving the
  # server broken until the renewal timer notices the missing name.
  if [ "$(sed -n 's/^ACME_ENABLED=//p' "$athanor_config/control.env" | sed -n '1p')" = true ]; then
    "$(runtime_path /usr/local/lib/athanor/athanor-certificate)" issue ||
      printf 'garden: the certificate could not be reissued for %s; the previous certificate is still serving. Run sudo athanor certificate issue once the name is reachable.\n' \
        "$hostname_value" >&2
  fi
  restart_athanor
  printf 'Stable hostname saved: %s\n' "$hostname_value"
  # This used to be printed whatever the certificate was, five lines under the test for whether a
  # trusted one is even being requested. A name is only half of what a browser needs: it will not
  # run the passkey ceremony at all on a page it does not trust, so on a self-signed certificate
  # the sentence sent the owner straight to a button that cannot succeed.
  certificate_trust=$(certificate_trust_state)
  if [ "$certificate_trust" = trusted ]; then
    printf 'Browser sign-in now works: a passkey can be bound to %s, which it could never be to an\n' \
      "$hostname_value"
    printf 'IP address.\n'
  else
    printf 'A passkey can now be bound to %s, which it could never be to an IP address. That is\n' \
      "$hostname_value"
    printf 'half of what a browser needs. The other half is a certificate the browser trusts: it\n'
    printf 'will not create a passkey on a page it does not trust, and accepting the warning does\n'
    printf 'not change that.\n'
    if [ "$certificate_trust" = self-signed ]; then
      printf 'This server is still serving the certificate it signed itself. To finish:\n'
      printf '  sudo athanor certificate enable --agree-tos --email you@example.com\n'
    else
      printf 'What this server is serving could not be confirmed. To see it, and to fix it if it needs\n'
      printf 'fixing:\n'
      printf '  sudo athanor certificate status\n'
      printf '  sudo athanor certificate enable --agree-tos --email you@example.com\n'
    fi
  fi
  printf 'Run “sudo athanor pairing-code” for a fresh code and a QR against the new name.\n'
  printf 'Native-client passkeys remain valid. Direct-browser passkeys from the old origin must be added again.\n'
}

# Free kibibytes on the filesystem holding a path, or nothing at all when df cannot say - a
# destination on a mount that has just gone away answers with neither a number nor a guess, and
# every caller here treats "no number" as "do not claim to know".
free_kb() {
  df -Pk "$1" 2>/dev/null | awk 'NR == 2 {print $4}'
}

# Half a gibibyte of elbow room on top of whatever is being written. Compression means the archive
# is smaller than its source and the margin covers the postgres dump alongside it, but the real
# reason for a margin at all is that finishing with a full disk is its own outage: journald, the
# database and nginx all need somewhere to write the moment the services come back.
athanor_space_margin_kb=524288

# The one backup directory prune_backups may not remove: the copy a restore is reading from.
protected_backup=""

# Compared as resolved paths rather than as the strings they were typed as. The operator names the
# backup on the command line and `find` names it from the root, so a trailing slash or a relative
# path would be a different string for the same directory - and the whole point of this is not to
# delete that directory.
is_protected_backup() {
  [ -n "$protected_backup" ] || return 1
  [ "$(cd "$1" 2>/dev/null && pwd -P)" = "$protected_backup" ]
}

# Keeps the most recent backups this script created and removes the rest. A destination the
# operator named themselves is theirs to manage and is never touched, which is why only the
# generated timestamp directories match.
# A backup is a directory with a verified SHA256SUMS in it. Anything else is wreckage from a run
# that died partway, and it used to count: five failed runs in a row - which is what a full disk
# produces - left five unusable directories occupying all five retained slots, each run having
# deleted a good backup to make room for rubbish. Failed runs are cleared here too, so the disk does
# not fill with them.
#
# The copy a restore is reading from is never removed, whatever its age. A restore prunes to make
# room exactly as a backup does, and deleting the copy the operator is in the middle of restoring
# is the one way that could turn a recovery into a loss - and the sixth-newest is precisely the one
# somebody reaches for when the newest five all carry the fault they are recovering from.
prune_backups() {
  [ -d "$athanor_backup_root" ] || return 0
  find "$athanor_backup_root" -mindepth 1 -maxdepth 1 -type d -name '*.partial' 2>/dev/null |
    while IFS= read -r abandoned; do
      is_protected_backup "$abandoned" && continue
      rm -rf -- "$abandoned"
      printf 'Removed incomplete backup %s\n' "$abandoned"
    done
  find "$athanor_backup_root" -mindepth 1 -maxdepth 1 -type d \
    -name '????????T??????Z' 2>/dev/null |
    while IFS= read -r candidate; do
      [ -f "$candidate/SHA256SUMS" ] && printf '%s\n' "$candidate"
    done |
    sort -r |
    tail -n +$((athanor_backup_keep + 1)) |
    while IFS= read -r superseded; do
      is_protected_backup "$superseded" && continue
      rm -rf -- "$superseded"
      printf 'Removed superseded backup %s\n' "$superseded"
    done
}

# The files a backup is made of, in the order they are named in SHA256SUMS. Named here rather than
# globbed so that a stray file in the directory - a decrypted copy somebody left behind, an editor's
# swap file - is never quietly shipped off the machine. `packages.txt` and `revision` are absent
# from copies made by older releases and are skipped when they are.
athanor_backup_files="database.dump workspaces.tar.gz configuration.tar.gz packages.txt revision SHA256SUMS"

# A second copy, somewhere the failure of this computer's disk cannot reach.
#
# WHY. All five retained copies live in /var/backups/athanor, on the same disk as the data they are
# copies of. That is a copy of the data and it is not a backup: the commonest way a one-box product
# is lost outright is the disk, and the disk takes both. docs/OPERATIONS.md and the settings screen
# have advised an off-host copy since before there was any way for this product to make one.
#
# WHAT IT DOES NOT DO. It writes to a path this computer can already write to: a removable disk, a
# NAS mount, anything mounted. It does not speak ssh, rsync, S3, or any provider's API, and that is
# a decision and not a gap. A credential on this box that can write to the destination can also
# delete what is already there, so a box that is broken into loses every copy it has ever made in
# one command. A mount the owner controls - better, a disk they unplug - does not have that shape.
# If that trade is wrong for a particular owner, `athanor backup /path` has always written a copy
# wherever they say, and cron and rsync are theirs to point at it.
#
# ENCRYPTION IS NOT OPTIONAL HERE. configuration.tar.gz carries DATA_MASTER_KEY and
# SESSION_SIGNING_KEY: a copy of a backup is a copy of everything this product protects. What makes
# that tolerable in /var/backups is that the disk it sits on already holds those keys. A copy that
# leaves the machine has no such excuse, so a destination with no recipient is refused where it is
# configured, in daylight, rather than discovered at three in the morning by a timer.
#
# gpg rather than a pinned age binary: `gpg --recipient-file` needs no keyring, no state and no
# download, and the installer already relies on gpg being present to place the NodeSource keyring.
# A box without it is told so and keeps its local copy.
copy_backup_off_host() {
  off_host_source="$1"
  off_host_destination=$(control_env_value BACKUP_DESTINATION)
  if [ -z "$off_host_destination" ]; then
    record_backup_off_host off ''
    return 0
  fi
  # Pessimistic first and corrected on the way out, for the same reason `auto_backup_run` does it
  # for the run as a whole: the daily unit has a start timeout, and a copy killed by it reaches no
  # further line here. Without this, a kill during the copy left `outcome=ok` with nothing said
  # about the second copy at all, which reads exactly like a box that has no destination configured.
  record_backup_off_host running ''
  off_host_recipient=$(control_env_value BACKUP_ENCRYPTION_RECIPIENT)
  off_host_failure=""
  if [ -z "$off_host_recipient" ]; then
    off_host_failure="no encryption recipient is configured"
  elif [ ! -r "$off_host_recipient" ]; then
    off_host_failure="the encryption recipient $off_host_recipient cannot be read"
  elif ! command -v gpg >/dev/null 2>&1; then
    off_host_failure="gpg is not installed on this computer"
  elif [ ! -d "$off_host_destination" ]; then
    off_host_failure="$off_host_destination is not a directory this computer can see; is the disk mounted?"
  fi
  if [ -z "$off_host_failure" ]; then
    # Written aside and renamed, the same way the local copy is and for the same reason: a run
    # interrupted halfway leaves something obviously unfinished rather than a directory that looks
    # like a backup and is missing the file nobody checked.
    off_host_target="$off_host_destination/$(basename -- "$off_host_source")"
    rm -rf -- "$off_host_target.partial"
    if install -d -m 0700 "$off_host_target.partial" 2>/dev/null; then
      for off_host_file in $athanor_backup_files; do
        [ -f "$off_host_source/$off_host_file" ] || continue
        if ! gpg --batch --yes --trust-model always \
          --recipient-file "$off_host_recipient" \
          --output "$off_host_target.partial/$off_host_file.gpg" \
          --encrypt "$off_host_source/$off_host_file" >/dev/null 2>&1; then
          off_host_failure="$off_host_file could not be encrypted to $off_host_recipient"
          break
        fi
      done
    else
      off_host_failure="$off_host_destination could not be written to"
    fi
  fi
  if [ -z "$off_host_failure" ]; then
    # Sums of the encrypted files, in the clear. Nothing here can verify the plaintext without the
    # private key - which is the point of the private key being elsewhere - so this is the one
    # question the owner can still answer at the destination: did the copy arrive whole.
    (
      cd "$off_host_target.partial" &&
        sha256sum ./*.gpg >SHA256SUMS.encrypted
    ) || off_host_failure="the copied files could not be checksummed at $off_host_destination"
  fi
  if [ -n "$off_host_failure" ]; then
    rm -rf -- "${off_host_target:-$off_host_destination/nowhere}.partial"
    # Never fatal. The backup this box needed is complete and verified on the local disk; what
    # failed is the second copy, and saying "the backup failed" about that would send an owner
    # hunting for a copy that is sitting there.
    warn "the local backup is complete; the off-host copy did not run: $off_host_failure"
    record_backup_off_host failed "$off_host_failure"
    return 0
  fi
  rm -rf -- "$off_host_target"
  mv -- "$off_host_target.partial" "$off_host_target"
  record_backup_off_host ok ''
  printf 'Encrypted copy written to %s\n' "$off_host_target"
}

# Added to the record `record_backup_status` has just written, in the same shape as the fields above
# it, so `doctor` and the settings screen can tell "copied locally" from "copied off-host" rather
# than reporting a green backup that exists in exactly one place.
#
# It rewrites its own two lines rather than appending them, because this is called twice in one run
# - pessimistically on the way in, corrected on the way out - and every reader here takes the first
# match. Appending would have left the pessimistic line permanently in front of the true one, which
# is a status field that can never say anything but "running".
#
# Never fatal, at any step: a backup that is complete on disk must not be reported as failed because
# a note about it could not be written.
record_backup_off_host() {
  off_host_record=$(mktemp "$athanor_backup_status.XXXXXX" 2>/dev/null) || return 0
  {
    grep -v '^off_host' "$athanor_backup_status" 2>/dev/null || true
    printf 'off_host=%s\n' "$1"
    printf 'off_host_reason=%s\n' "${2:-}"
  } >"$off_host_record" 2>/dev/null || {
    rm -f "$off_host_record"
    return 0
  }
  # World-readable like the record it is part of, so the API can read it unprivileged.
  chmod 0644 "$off_host_record" 2>/dev/null || true
  mv "$off_host_record" "$athanor_backup_status" 2>/dev/null || rm -f "$off_host_record"
}

# Naming the second place, and who may open what is put there.
#
# A command rather than an instruction to edit control.env, because the two settings are only safe
# together: a destination with no recipient would write this product's data key onto a disk that
# leaves the building. Refusing that here means it is refused while somebody is watching.
backup_destination_command() {
  need_root backup destination "$@"
  case "${1:-show}" in
    show)
      destination_path=$(control_env_value BACKUP_DESTINATION)
      if [ -z "$destination_path" ]; then
        printf 'Off-host copy: off\n'
        printf 'Backups are kept in %s, on the same disk as the data. To add a second copy on a\n' \
          "$athanor_backup_root"
        printf 'disk this one failing does not take:\n'
        printf '  sudo athanor backup destination /mnt/backup-disk --recipient /root/backup-key.pub\n'
        return 0
      fi
      printf 'Off-host copy: %s\n' "$destination_path"
      printf 'Encrypted to:  %s\n' "$(control_env_value BACKUP_ENCRYPTION_RECIPIENT)"
      case "$(backup_status_field off_host)" in
        ok) printf 'Last run:      copied\n' ;;
        failed) printf 'Last run:      not copied - %s\n' "$(backup_status_field off_host_reason)" ;;
        running) printf 'Last run:      started copying and never reported back\n' ;;
        *) printf 'Last run:      nothing recorded yet; the next backup will copy\n' ;;
      esac
      ;;
    off)
      set_control_value BACKUP_DESTINATION ''
      set_control_value BACKUP_ENCRYPTION_RECIPIENT ''
      printf 'Off-host copies are off. Backups are kept in %s only, which is the same disk as\n' \
        "$athanor_backup_root"
      printf 'the data. Copies already at the old destination are left where they are.\n'
      ;;
    *)
      destination_path="$1"
      [ "${2:-}" = "--recipient" ] && [ -n "${3:-}" ] ||
        fail "usage: sudo athanor backup destination /mnt/backup-disk --recipient /root/backup-key.pub"
      destination_recipient="$3"
      command -v gpg >/dev/null 2>&1 ||
        fail "gpg is not installed on this computer, and an off-host copy is not written without it: sudo apt-get install gnupg"
      [ -d "$destination_path" ] ||
        fail "$destination_path is not a directory; mount the disk first, then name the directory on it"
      [ -r "$destination_recipient" ] ||
        fail "$destination_recipient cannot be read; export the public key of the identity that will open these backups, and keep the private half off this computer"
      gpg --batch --show-keys "$destination_recipient" >/dev/null 2>&1 ||
        fail "$destination_recipient is not a public key gpg can read; export it with gpg --armor --export"
      # The one thing this feature exists for. A destination on the disk that already holds the
      # data and the local copies survives exactly the failures the local copies survive, and none
      # of the one that costs an owner everything. `df` naming the same filesystem for both is the
      # cheapest true form of that question; when it will not answer for either path, nothing is
      # refused, because a guess is not a reason to reject somebody's own disk.
      destination_device=$(df -P "$destination_path" 2>/dev/null | awk 'NR == 2 {print $1}')
      backup_root_device=$(df -P "$athanor_backup_root" 2>/dev/null | awk 'NR == 2 {print $1}')
      if [ -n "$destination_device" ] && [ "$destination_device" = "$backup_root_device" ]; then
        fail "$destination_path is on the same filesystem ($destination_device) as $athanor_backup_root, so it is lost by the same disk failure. Name a path on another disk, a removable one, or a mount"
      fi
      set_control_value BACKUP_DESTINATION "$destination_path"
      set_control_value BACKUP_ENCRYPTION_RECIPIENT "$destination_recipient"
      printf 'Every backup will also be encrypted to %s and copied to %s.\n' \
        "$destination_recipient" "$destination_path"
      printf 'The copy runs after the services are back, so it costs no downtime, and a copy that\n'
      printf 'fails does not fail the backup: sudo athanor doctor says which of the two happened.\n'
      printf '\nKEEP THE PRIVATE HALF OF THAT KEY SOMEWHERE THIS COMPUTER IS NOT. Without it the\n'
      printf 'off-host copies cannot be opened by anybody, including you. Restoring one is:\n'
      printf '  gpg --decrypt --output database.dump database.dump.gpg   (and each other file)\n'
      printf '  sudo athanor restore /path/to/decrypted --yes --new-host\n'
      ;;
  esac
}

backup_athanor() {
  need_root backup "${1:-}"
  acquire_maintenance_lock
  restart_mode="${2:-restart}"
  [ "$restart_mode" = "restart" ] || [ "$restart_mode" = "keep-stopped" ] ||
    fail "invalid internal backup restart mode"
  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  final_destination="${1:-$athanor_backup_root/$stamp}"
  # Written aside and renamed at the end, so a run that dies partway leaves something obviously
  # unfinished rather than a directory that looks like a backup and cannot restore one.
  destination="$final_destination.partial"
  rm -rf -- "$destination"
  install -d -m 0700 "$destination"
  # Backups fail mostly because the disk is full, which is exactly when every retained copy is
  # already there. Refusing before stopping the services costs the owner nothing; discovering it
  # after the archive is half-written costs them the outage and a slot.
  required_kb=$(du -sk "$athanor_home" 2>/dev/null | awk '{print $1}')
  available_kb=$(df -Pk "$athanor_backup_root" 2>/dev/null | awk 'NR == 2 {print $4}')
  if [ -n "$required_kb" ] && [ -n "$available_kb" ] &&
    [ "$available_kb" -lt "$((required_kb + 524288))" ]; then
    prune_backups
    available_kb=$(df -Pk "$athanor_backup_root" 2>/dev/null | awk 'NR == 2 {print $4}')
  fi
  if [ -n "$required_kb" ] && [ -n "$available_kb" ] &&
    [ "$available_kb" -lt "$((required_kb + 524288))" ]; then
    rm -rf -- "$destination"
    fail "not enough room for a backup: $((available_kb / 1024)) MiB free, about $(((required_kb + 524288) / 1024)) MiB needed. Free space or move $athanor_backup_root to a larger disk."
  fi
  systemctl stop athanor.target
  # Only ever names the partial directory, and is emptied the moment the finished backup takes its
  # real name — otherwise a failure in the seconds after the rename would delete the good copy this
  # run had just produced.
  partial_destination="$destination"
  jobs_frozen=false
  trap 'if [ "$jobs_frozen" = true ]; then systemctl thaw athanor-jobs.service >/dev/null 2>&1 || true; fi; rm -rf -- "$partial_destination"; systemctl start athanor.target >/dev/null 2>&1 || true' EXIT INT TERM
  if systemctl is-active --quiet athanor-jobs.service; then
    systemctl freeze athanor-jobs.service
    jobs_frozen=true
  fi
  runuser -u postgres -- pg_dump -Fc athanor >"$destination/database.dump"
  # The services are down for the whole of this archive, so what goes into it is outage time.
  # Package caches and installed dependency trees are the bulk of a working agent computer and
  # every one of them can be fetched again, so they are skipped; everything the agent produced
  # or was given, including its browser profile and its logins, is kept. Level 1 compression
  # roughly halves the processor time for a few per cent of size, which is the right trade when
  # the interface is offline until it finishes.
  #
  # The managed browser belongs on that list and was not on it: about 400 MB of Chromium, the
  # headless shell and ffmpeg, already compressed so gzip -1 recovers almost nothing, copied into
  # every daily backup and every pre-update rollback copy while this run printed that package caches
  # were skipped. Five retained copies is more than a gigabyte of purely re-downloadable bytes, and
  # the services are stopped for all of it. The runner reinstalls it at the lockfile's revision and
  # the restore path already tolerates it being absent.
  tar -C "$athanor_home" \
    --exclude=node_modules \
    --exclude=.pnpm-store \
    --exclude=.npm \
    --exclude=.venv \
    --exclude=__pycache__ \
    --exclude=./.cache/pip \
    --exclude=./.cache/pypoetry \
    --exclude=./.cache/ms-playwright \
    --exclude=./.cache/puppeteer \
    --exclude=./.cargo \
    --use-compress-program='gzip -1' \
    -cf "$destination/workspaces.tar.gz" .
  config_parent=$(dirname "$athanor_config")
  config_name=$(basename "$athanor_config")
  tar -C "$config_parent" -czf "$destination/configuration.tar.gz" "$config_name"
  if [ -f "$athanor_state/installed-packages" ]; then
    install -m 0600 "$athanor_state/installed-packages" "$destination/packages.txt"
  else
    : >"$destination/packages.txt"
    chmod 0600 "$destination/packages.txt"
  fi
  chmod 0600 "$destination/database.dump" "$destination/workspaces.tar.gz" \
    "$destination/configuration.tar.gz"
  # Which revision this copy belongs to, so `athanor rollback` knows what code the data came from.
  git -C "$athanor_root" rev-parse --verify HEAD >"$destination/revision" 2>/dev/null ||
    : >"$destination/revision"
  chmod 0600 "$destination/revision"
  (
    cd "$destination"
    sha256sum database.dump workspaces.tar.gz configuration.tar.gz packages.txt revision >SHA256SUMS
  )
  rm -rf -- "$final_destination"
  mv -- "$destination" "$final_destination"
  partial_destination=""
  destination="$final_destination"
  last_backup_destination="$final_destination"
  if [ "$jobs_frozen" = true ]; then systemctl thaw athanor-jobs.service; jobs_frozen=false; fi
  if [ "$restart_mode" = "restart" ]; then
    systemctl start athanor.target
  fi
  trap - EXIT INT TERM
  # Only after the new backup is complete and checksummed, so a failed run never costs the
  # operator the copy they still had.
  #
  # The record is written here rather than in the timer's own path, so every route to a verified
  # copy answers the same question the same way: the daily run, the operator's own command, and the
  # copy an update takes before it touches anything. "When did this box last copy itself" has one
  # answer, not one per caller. Under the same condition as the prune, and for the same reason -
  # a destination the operator named is theirs to keep track of, and reporting it here would let a
  # copy onto a USB stick paper over a daily run that has been failing for a fortnight.
  [ -n "${1:-}" ] || {
    prune_backups
    record_backup_status ok ''
    # After the record, because the record truncates that file and this appends to it; and after
    # the restart above, deliberately, because an off-host copy crosses a link this program does
    # not control and a slow uplink has no business being outage time. Nothing it does can fail
    # the backup: the verified local copy already exists and is what `restore` reads.
    copy_backup_off_host "$destination"
  }
  printf 'Checksum-verified backup created at %s\n' "$destination"
  printf 'Dependency trees and package caches were skipped; the agent reinstalls those.\n'
  printf 'It contains server keys and must be stored as securely as the server.\n'
}

validate_restore_source() {
  source_directory="$1"
  checksum_names=$(
    awk 'NF == 2 {print $2}' "$source_directory/SHA256SUMS" | sort | tr '\n' ' ' |
      sed 's/ $//'
  )
  # Every shape a backup has ever had, oldest first. A copy made by an older release has to stay
  # restorable by a newer one: the whole point of the file is the day the current release is the
  # thing that went wrong.
  case "$checksum_names" in
    "configuration.tar.gz database.dump workspaces.tar.gz") ;;
    "configuration.tar.gz database.dump packages.txt workspaces.tar.gz") ;;
    "configuration.tar.gz database.dump packages.txt revision workspaces.tar.gz") ;;
    *) fail "backup checksum manifest contains unexpected files" ;;
  esac
  (cd "$source_directory" && sha256sum --check --strict SHA256SUMS)
  workspace_listing=$(mktemp)
  configuration_listing=$(mktemp)
  trap 'rm -f "$workspace_listing" "$configuration_listing"' EXIT INT TERM
  tar -tzf "$source_directory/workspaces.tar.gz" >"$workspace_listing" ||
    fail "workspace backup is not a readable gzip archive"
  awk '$0 ~ /^\// || $0 ~ /(^|\/)[.][.]($|\/)/ {exit 1}' "$workspace_listing" ||
    fail "workspace backup contains an unsafe path"
  tar -tzf "$source_directory/configuration.tar.gz" >"$configuration_listing" ||
    fail "configuration backup is not a readable gzip archive"
  config_parent=$(dirname "$athanor_config")
  config_name=$(basename "$athanor_config")
  awk -v root="$config_name" '$0 !~ ("^" root "(/|$)") {exit 1}' "$configuration_listing" ||
    fail "configuration backup contains an unexpected path"
  rm -f "$workspace_listing" "$configuration_listing"
  trap - EXIT INT TERM
}

restore_athanor() {
  # Parsed by reading "$@" rather than by shifting through it, because `need_root` below re-execs
  # this whole script through sudo with exactly the arguments it is handed. Consuming them first
  # and re-execing with what was left would drop every flag on the way to root - and the one path
  # on which these flags matter is an owner at a shell on a machine they have just built.
  source_directory=""
  confirmation=""
  restore_new_host=""
  restore_keep_stopped=""
  restore_hostname=""
  restore_expect_hostname=""
  for restore_argument in "$@"; do
    if [ -n "$restore_expect_hostname" ]; then
      restore_hostname="$restore_argument"
      restore_expect_hostname=""
      continue
    fi
    case "$restore_argument" in
      --yes) confirmation=--yes ;;
      --new-host) restore_new_host=yes ;;
      --keep-stopped) restore_keep_stopped=yes ;;
      --hostname)
        restore_expect_hostname=yes
        restore_new_host=yes
        ;;
      --hostname=*)
        restore_hostname="${restore_argument#--hostname=}"
        restore_new_host=yes
        ;;
      -*) fail "athanor restore: unknown option $restore_argument" ;;
      *)
        if [ -n "$source_directory" ]; then
          fail "athanor restore takes one backup directory; got $source_directory and $restore_argument"
        fi
        source_directory="$restore_argument"
        ;;
    esac
  done
  [ -z "$restore_expect_hostname" ] ||
    fail "athanor restore --hostname needs a name, such as --hostname ai.example.com"
  [ -z "$restore_keep_stopped" ] || [ -z "$restore_new_host" ] ||
    fail "athanor restore --keep-stopped cannot be combined with --new-host or --hostname, which restart services"
  [ -f "$source_directory/database.dump" ] &&
    [ -f "$source_directory/workspaces.tar.gz" ] &&
    [ -f "$source_directory/configuration.tar.gz" ] &&
    [ -f "$source_directory/SHA256SUMS" ] ||
    fail "usage: sudo athanor restore /path/to/backup --yes [--keep-stopped | --new-host [--hostname NAME]]"
  [ "$confirmation" = "--yes" ] ||
    fail "restore replaces the database, workspace files, and server keys; re-run with --yes"
  need_root restore "$@"
  acquire_maintenance_lock
  validate_restore_source "$source_directory"
  # Restore empties the workspace tree before it extracts into it, so a disk that turns out to be
  # too small is discovered with the owner's files already deleted and the archive half unpacked -
  # the one failure this command exists to recover from, caused by the command itself. The backup
  # path refuses before it stops a single service for exactly that reason. This is the same care in
  # the same order: size the source, look at the destination, prune, look again, refuse.
  #
  # The size is the length of the decompressed stream, measured by decompressing it, rather than
  # the length gzip records in its own trailer - that one is only correct below 4 GiB and a
  # workspace tree is routinely past it. Counting the tar headers and padding along with the files
  # overstates the answer by a fraction of a per cent, which is the direction to be wrong in. It
  # costs a second read of the archive, spent here rather than after the services are down, so none
  # of it is outage time. The database dump is deliberately not measured beside it: what a
  # custom-format dump expands to cannot be known without restoring it, and dropping the old
  # database first frees roughly what the new one takes, so the margin below is the honest
  # allowance rather than a number invented to look like a calculation.
  #
  # What the wipe is about to free counts as room. A box restored over itself needs almost no new
  # space at all, and a check that ignored that would refuse the commonest recovery there is.
  restore_kb=$(gzip -dc "$source_directory/workspaces.tar.gz" 2>/dev/null | wc -c |
    awk '{ printf "%.0f\n", ($1 + 1023) / 1024 }')
  reclaimed_kb=$(du -sk "$athanor_home" 2>/dev/null | awk '{print $1}')
  [ -n "$reclaimed_kb" ] || reclaimed_kb=0
  available_kb=$(free_kb "$athanor_home")
  if [ -n "$restore_kb" ] && [ -n "$available_kb" ] &&
    [ "$((available_kb + reclaimed_kb))" -lt "$((restore_kb + athanor_space_margin_kb))" ]; then
    protected_backup=$(cd "$source_directory" && pwd -P)
    prune_backups
    protected_backup=""
    available_kb=$(free_kb "$athanor_home")
  fi
  if [ -n "$restore_kb" ] && [ -n "$available_kb" ] &&
    [ "$((available_kb + reclaimed_kb))" -lt "$((restore_kb + athanor_space_margin_kb))" ]; then
    fail "not enough room to restore: $(((available_kb + reclaimed_kb) / 1024)) MiB would be free on $athanor_home, about $(((restore_kb + athanor_space_margin_kb) / 1024)) MiB needed. No restore data has been changed. Free space, or restore onto a larger disk."
  fi
  systemctl stop athanor.target
  for unit_name in $service_units; do systemctl stop "$unit_name"; done
  trap 'systemctl stop athanor.target >/dev/null 2>&1 || true; printf "garden: restore did not complete; the server remains stopped and the backup is preserved.\\n" >&2' EXIT
  trap 'exit 130' INT TERM
  runuser -u postgres -- psql -v ON_ERROR_STOP=1 -v database_name=athanor \
    -d postgres <<'SQL'
SELECT pg_terminate_backend(pid)
FROM pg_stat_activity
WHERE datname = :'database_name' AND pid <> pg_backend_pid();
SQL
  runuser -u postgres -- dropdb --if-exists athanor
  runuser -u postgres -- createdb -O athanor athanor
  runuser -u postgres -- pg_restore -d athanor <"$source_directory/database.dump"
  find "$athanor_home" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
  tar -C "$athanor_home" -xzf "$source_directory/workspaces.tar.gz"
  chown -R athanor:athanor "$athanor_home"
  restore_workspace_ownership
  tar -C "$config_parent" -xzf "$source_directory/configuration.tar.gz"
  restored_password=$(sed -n 's|^DATABASE_URL=postgres://athanor:\([^@]*\)@.*|\1|p' \
    "$athanor_config/control.env")
  [ -n "$restored_password" ] || fail "restored database password is missing"
  runuser -u postgres -- psql -v ON_ERROR_STOP=1 -v password="$restored_password" <<'SQL'
SELECT format('ALTER ROLE athanor WITH LOGIN PASSWORD %L', :'password')\gexec
SQL
  if [ -n "$restore_keep_stopped" ]; then
    # Rehearsals must be able to inspect recovered data before copied tasks can resume.
    trap - EXIT INT TERM
    printf 'Restore complete. Garden remains stopped for offline verification.\n'
    printf 'Runtime repair and connection refresh were skipped. Starting Garden may resume restored work.\n'
    return 0
  fi
  if [ -f "$athanor_root/scripts/athanor-native-runtime" ] &&
    grep -q '^  preview-origin)' "$athanor_root/scripts/athanor-native-runtime"; then
    /bin/sh "$athanor_root/scripts/athanor-native-runtime" preview-origin
  fi
  systemctl start athanor.target
  systemctl reload-or-restart nginx
  wait_until_serving
  trap - EXIT INT TERM

  # Browser binaries are excluded from the archive and the workspace restore clears their cache.
  # Repair only after data is serving, so a download failure cannot undo a successful recovery.
  fetch_managed_chromium

  # Last, and never fatal.
  #
  # This is disaster recovery and the last step of every update rollback, and it used to run between
  # wiping the database and resetting the role password - so one withdrawn package, or a host with
  # no network, aborted the restore at the one moment the server could not reach its own database.
  # The owner was left with a box that had their data and could not open it. Nothing here is needed
  # to serve: the agent reinstalls what it needs, and an unsafe name is now skipped rather than
  # taken as a reason to stop a restore that has already succeeded.
  if [ -f "$source_directory/packages.txt" ]; then
    set --
    skipped_packages=""
    while IFS= read -r package_name; do
      [ -n "$package_name" ] || continue
      case "$package_name" in
        *[!A-Za-z0-9+._:-]*|-*|*::*|*:|.*|/*)
          skipped_packages="$skipped_packages $package_name"
          continue
          ;;
      esac
      set -- "$@" "$package_name"
    done <"$source_directory/packages.txt"
    [ -z "$skipped_packages" ] ||
      warn "skipped package names that are not safe to pass to a package manager:$skipped_packages"
    if [ "$#" -gt 0 ]; then
      if ! "$(runtime_path /usr/local/sbin/athanor-system-packages)" install "$@"; then
        warn "could not reinstall the packages this backup recorded; athanor is serving and the agent will install what it needs. To retry: sudo $(runtime_path /usr/local/sbin/athanor-system-packages) install $*"
      fi
    fi
  fi
  if [ -n "$restore_new_host" ]; then
    restore_to_new_host
  else
    # The line `rollback` has called since the day it was written, twelve hundred lines below in
    # this same file, and `restore` never did. Even restoring onto the same computer, the archive
    # can carry a hostname from before the owner changed it, and the connection manifest and the
    # self-signed certificate's names are both derived from that setting. Non-fatal for the same
    # reason as everything else down here: the data is back and the server is already serving.
    "$(runtime_path /usr/local/lib/athanor/athanor-network-refresh)" >/dev/null 2>&1 ||
      warn "the connection manifest could not be refreshed; run sudo athanor doctor"
  fi
  printf 'Restore complete.\n'
}

# Put the origin back on the machine the data has just landed on.
#
# A backup carries /etc/athanor verbatim, and that is the point: the data key, the session signing
# key and the pinned server identity all have to come back exactly, or the restored box cannot open
# its own database and every paired client rejects it. PUBLIC_APP_URL, WEBAUTHN_ORIGIN and
# WEBAUTHN_RP_ID came back with them, and on a different computer those three name the old one - so
# a restored box served an origin nobody could reach and scoped browser sign-in to an address it no
# longer had. Nothing failed; there was no error anywhere; the box simply could not be opened.
#
# The refresh at the end is the line `rollback` has called since the day it was written, twelve
# hundred lines below in this same file, and `restore` never did - so the connection manifest still
# advertised the old machine's addresses and the self-signed certificate still carried them as its
# only SANs, on the two commands whose whole purpose is a computer that has changed.
#
# Everything here warns rather than fails, and it runs after the restore has already succeeded and
# the server is serving. A name that does not resolve yet from a machine plugged in ten minutes ago
# is an ordinary afternoon, and it is not a reason to end a recovery in an error over a box whose
# data is already back. The price is one extra restart, which is nothing on the day this is run.
restore_to_new_host() {
  if [ -n "$restore_hostname" ]; then
    # `set-hostname` is the whole of this branch: it validates the name, refuses one that does not
    # resolve, writes the five settings, refreshes the network metadata, reissues a trusted
    # certificate if one is configured, restarts, and prints what an owner has to do about their
    # passkeys. In a subshell because every one of those refusals is a `fail`, and a `fail` here
    # would exit a restore that has already put the data back.
    if (set_hostname "$restore_hostname"); then
      return 0
    fi
    warn "the restored server is running, but $restore_hostname could not be set as its name yet. Point the record at this computer, then run: sudo athanor set-hostname $restore_hostname"
    return 0
  fi
  restored_origin=$(control_env_value PUBLIC_APP_URL)
  restored_host=$(
    printf '%s' "$restored_origin" | sed -e 's|^https\{0,1\}://||' -e 's|/.*$||' \
      -e 's/^\[//' -e 's/\]$//'
  )
  if restored_origin_reaches_here "$restored_host"; then
    # The planned move: the domain followed the machine. Rewriting it to an address here would
    # break every browser passkey that still works, so the name is left exactly as it is and only
    # the addresses underneath it are refreshed.
    printf 'The name %s already points at this computer, so it has been kept.\n' "$restored_host"
  else
    detected_address=$(host_primary_address)
    if [ -z "$detected_address" ]; then
      warn "no network address could be detected, so the restored origin $restored_origin still names the old computer. Fix the network, then run: sudo athanor restore --new-host, or sudo athanor set-hostname NAME"
      return 0
    fi
    set_public_origin "$detected_address"
    printf 'This computer is not %s. The address it answers on is now %s.\n' \
      "$restored_host" "$detected_address"
  fi
  "$(runtime_path /usr/local/lib/athanor/athanor-network-refresh)" ||
    warn "the connection manifest and certificate addresses could not be refreshed; run sudo athanor doctor"
  restart_athanor
  printf 'Run “sudo athanor connect” for a ticket and QR carrying the addresses of this computer:\n'
  printf 'the paired clients you have hold the old ones. The server identity survived in the\n'
  printf 'backup, so those clients still trust this box and their passkeys still work.\n'
  printf 'A passkey made in a browser is bound to the origin it was made on. If that origin has\n'
  printf 'changed, those passkeys have to be added again from a client that still signs in.\n'
}

# Agent commands run as athanor-agent and reach their workspace through a group shared with the
# runner. A restored archive carries whatever ownership it was taken with, so without this a
# recovered server comes back with every command unable to read the files it just recovered.
# Everything except .athanor joins the group; the browser profile, the desktop session and the
# artifact store stay the runner's alone, which is what keeps the owner's logins out of reach.
restore_workspace_ownership() {
  getent group athanor-agent >/dev/null 2>&1 || return 0
  chown athanor:athanor-agent "$athanor_home"
  chmod 2710 "$athanor_home"
  for restored_workspace in "$athanor_home"/*/; do
    [ -d "$restored_workspace" ] || continue
    chgrp athanor-agent "$restored_workspace"
    chmod 2770 "$restored_workspace"
    find "$restored_workspace" -mindepth 1 -maxdepth 1 ! -name .athanor -exec \
      chgrp -R athanor-agent {} + 2>/dev/null || true
    find "$restored_workspace" -mindepth 1 -maxdepth 1 ! -name .athanor -exec \
      chmod -R g+rwX {} + 2>/dev/null || true
  done
}

install_runtime_files() {
  install -D -m 0755 scripts/athanor "$(runtime_path /usr/local/bin/athanor)"
  install -D -m 0755 scripts/athanor "$(runtime_path /usr/local/bin/garden)"
  install -D -m 0755 scripts/reproducible-run.py "$(runtime_path /usr/local/bin/garden-run)"
  install -D -m 0644 scripts/garden_system.py "$(runtime_path /usr/local/lib/athanor/garden_system.py)"
  # Deliberately outside every directory on the agent's PATH, and not executable by the account
  # agent commands run as: named directly it would be a root package install with no capability
  # scope and no approval. An update also removes the copy earlier releases left on the PATH.
  rm -f "$(runtime_path /usr/local/bin/athanor-package-helper)"
  install -D -m 0750 -o root -g athanor scripts/athanor-package-helper \
    "$(runtime_path /usr/local/lib/athanor/athanor-package-helper)"
  install -D -m 0755 scripts/athanor-system-packages \
    "$(runtime_path /usr/local/sbin/athanor-system-packages)"
  install -D -m 0644 scripts/mission-supervisor.py \
    "$(runtime_path /usr/local/lib/athanor/mission-supervisor.py)"
  # Drops an agent command to its own unprivileged account, which the runner cannot do itself.
  install -D -m 0755 scripts/athanor-sandbox \
    "$(runtime_path /usr/local/lib/athanor/athanor-sandbox)"
  install -D -m 0755 scripts/athanor-service \
    "$(runtime_path /usr/local/lib/athanor/athanor-service)"
  install -D -m 0755 scripts/athanor-network-refresh \
    "$(runtime_path /usr/local/lib/athanor/athanor-network-refresh)"
  install -D -m 0755 scripts/athanor-network-watch \
    "$(runtime_path /usr/local/lib/athanor/athanor-network-watch)"
  # The network refresh and the renewal timer run these by absolute path, so an update that
  # skipped them would keep running the previous release's dynamic-DNS and ACME code.
  install -D -m 0755 scripts/athanor-ddns \
    "$(runtime_path /usr/local/lib/athanor/athanor-ddns)"
  install -D -m 0755 scripts/athanor-certificate \
    "$(runtime_path /usr/local/lib/athanor/athanor-certificate)"
  install -D -m 0755 scripts/athanor-document \
    "$(runtime_path /usr/local/lib/athanor/athanor-document)"
  # The three the skill library names by absolute path. The installer placed them and no update ever
  # did, so a release could ship a skill telling the agent to run a flag that only exists in the copy
  # under scripts/ - and on a box installed before they were added, a command that is not there at
  # all. Same fault as the backup units, found by comparing the two lists rather than by anyone
  # noticing. Two of them sit on the agent's PATH deliberately: they hold no privilege the agent does
  # not already have, and they are what the skills tell it to run.
  install -D -m 0755 scripts/athanor-office-convert \
    "$(runtime_path /usr/local/bin/athanor-office-convert)"
  install -D -m 0755 scripts/athanor-pdf-tables \
    "$(runtime_path /usr/local/bin/athanor-pdf-tables)"
  install -D -m 0755 scripts/athanor-document-proof \
    "$(runtime_path /usr/local/lib/athanor/athanor-document-proof)"
  install -D -m 0755 scripts/athanor-gui \
    "$(runtime_path /usr/local/lib/athanor/athanor-gui)"
  install -D -m 0755 scripts/athanor-gui-broker \
    "$(runtime_path /usr/local/lib/athanor/athanor-gui-broker)"
  install -D -m 0755 scripts/athanor-snapshot \
    "$(runtime_path /usr/local/lib/athanor/athanor-snapshot)"
  install -D -m 0755 infra/native/start-desktop-session.sh \
    "$(runtime_path /usr/local/lib/athanor/start-desktop-session.sh)"
  install -D -m 0755 infra/native/athanor-desktop-bridge.py \
    "$(runtime_path /usr/local/lib/athanor/athanor-desktop-bridge.py)"
  install -D -m 0644 infra/native/athanor@.service \
    "$(runtime_path /etc/systemd/system/athanor@.service)"
  install -D -m 0644 infra/native/athanor-jobs.service "$(runtime_path /etc/systemd/system/athanor-jobs.service)"
  install -D -m 0644 infra/native/athanor-gui.service "$(runtime_path /etc/systemd/system/athanor-gui.service)"
  install -D -m 0644 infra/native/athanor-work.slice "$(runtime_path /etc/systemd/system/athanor-work.slice)"
  install -D -m 0644 infra/native/athanor-runner.service \
    "$(runtime_path /etc/systemd/system/athanor-runner.service)"
  install -D -m 0644 infra/native/athanor.target \
    "$(runtime_path /etc/systemd/system/athanor.target)"
  install -D -m 0644 infra/native/athanor-network-refresh.service \
    "$(runtime_path /etc/systemd/system/athanor-network-refresh.service)"
  install -D -m 0644 infra/native/athanor-network-refresh.timer \
    "$(runtime_path /etc/systemd/system/athanor-network-refresh.timer)"
  install -D -m 0644 infra/native/athanor-network-refresh.path \
    "$(runtime_path /etc/systemd/system/athanor-network-refresh.path)"
  # The relay identity key and settings live here, so an update has to provision the directory as
  # well as the installer: the unit that makes it writable names it, and a server updated from an
  # earlier release has never seen it.
  install -d -m 0700 -o athanor-control -g athanor-control \
    "$(runtime_path /etc/athanor/relay)"
  install -D -m 0644 infra/native/athanor-network-watch.service \
    "$(runtime_path /etc/systemd/system/athanor-network-watch.service)"
  # Installed but never enabled here: unattended updates stay opt-in, and an operator who
  # turned them on keeps the enablement symlink across updates.
  install -D -m 0644 infra/native/athanor-auto-update.service \
    "$(runtime_path /etc/systemd/system/athanor-auto-update.service)"
  install -D -m 0644 infra/native/athanor-auto-update.timer \
    "$(runtime_path /etc/systemd/system/athanor-auto-update.timer)"
  # Placed and never enabled, exactly like the backup's alert companion: OnFailure= on the update
  # unit is what starts it, and the unit itself refuses a manual start so nothing can file a report
  # about an update that never failed.
  install -D -m 0644 infra/native/athanor-auto-update-alert.service \
    "$(runtime_path /etc/systemd/system/athanor-auto-update-alert.service)"
  # Also installed without being enabled: `athanor certificate enable` turns this one on once the
  # operator has accepted the certificate authority's subscriber agreement.
  install -D -m 0644 infra/native/athanor-certificate-renew.service \
    "$(runtime_path /etc/systemd/system/athanor-certificate-renew.service)"
  install -D -m 0644 infra/native/athanor-certificate-renew.timer \
    "$(runtime_path /etc/systemd/system/athanor-certificate-renew.timer)"
  # Started only by OnFailure= on the renewal unit, so it is installed but never enabled.
  install -D -m 0644 infra/native/athanor-certificate-alert.service \
    "$(runtime_path /etc/systemd/system/athanor-certificate-alert.service)"
  # The backup units were installed by the installer and never by an update, which meant a change
  # to them only ever reached a box somebody reinstalled. The enablement symlink is the installer's
  # and survives being overwritten, so a server whose owner turned automatic backups off keeps them
  # off. Its alert companion is installed and never enabled: OnFailure= starts it.
  install -D -m 0644 infra/native/athanor-backup.service \
    "$(runtime_path /etc/systemd/system/athanor-backup.service)"
  install -D -m 0644 infra/native/athanor-backup.timer \
    "$(runtime_path /etc/systemd/system/athanor-backup.timer)"
  install -D -m 0644 infra/native/athanor-backup-alert.service \
    "$(runtime_path /etc/systemd/system/athanor-backup-alert.service)"
  # An owner locked out by an expired certificate reaches for ssh; this is what greets them there.
  install -D -m 0755 infra/native/athanor-motd \
    "$(runtime_path /etc/update-motd.d/99-athanor)"
  if [ -f "$(runtime_path /etc/nginx/conf.d/athanor.conf)" ] &&
    [ ! -L "$(runtime_path /etc/nginx/sites-enabled/athanor)" ]; then
    install -D -m 0644 infra/native/nginx.conf \
      "$(runtime_path /etc/nginx/conf.d/athanor.conf)"
  else
    install -D -m 0644 infra/native/nginx.conf \
      "$(runtime_path /etc/nginx/sites-available/athanor)"
  fi
  # The site file above includes these on nearly every location it serves, and an update replaced it
  # while leaving them at whatever the install day wrote - so a release that tightened the policy
  # shipped the site that expects the new one and kept the old. The listen snippet is not here on
  # purpose: the installer picks between two of them by the host's nginx version, which an update has
  # no reason to re-decide and no business guessing at. `nginx -t` below is what stands behind these.
  install -D -m 0644 infra/native/nginx-security-headers.conf \
    "$(runtime_path /etc/nginx/snippets/athanor-security-headers.conf)"
  install -D -m 0644 infra/native/nginx-app-csp.conf \
    "$(runtime_path /etc/nginx/snippets/athanor-app-csp.conf)"
}

# Whether the checkout's copy of this script can place its own runtime files.
#
# Asked of the file rather than of the process: a revision from before the phase existed answers
# `athanor update install-runtime-files` with a usage line and exit 0, which is not distinguishable
# from having done the work. What it looks for is the dispatch arm and not merely the name, because
# the name also appears in prose here - and a revision that kept these helpers while losing the arm
# does not print a usage line at all. Every release before this one ignored an argument after
# `update` and simply updated, so asking such a checkout for the phase asks it for a whole second
# update, from inside the first one, on a stopped server.
#
# Anchored so that the pattern does not find itself. Unanchored, this line is a mention of the arm
# in a file being asked whether it has one, and every revision carrying this function would answer
# yes whether or not it kept the arm.
checkout_installs_its_own_runtime_files() {
  grep -q '^ *install-runtime-files)' "$athanor_root/scripts/athanor" 2>/dev/null
}

# Places the runtime files the checkout now holds, using that revision's list rather than this one.
#
# `athanor update` is /usr/local/bin/athanor, which is the previous release's copy of this script
# and is what the running shell goes on executing after the pull. So the list above was always one
# release behind the tree it was installing from, and anything a release added first landed on an
# existing box at the release after it. The server that showed this had the backup units in its
# checkout, no athanor-backup.timer anywhere on disk, and a settings screen still describing a daily
# copy - and nothing about the update had reported an error, because nothing had gone wrong.
#
# The pulled copy runs as a child rather than replacing this shell: the rollback trap, the outage
# clock and `database_at_risk` live here and have to outlive the phase.
#
# What bounds it is the marker below and nothing about the phase, because what the child does is a
# property of the checkout and the whole reason this function exists is that this shell cannot read
# the checkout's mind. Asked for the phase, a revision that does not answer to it runs whatever its
# `update` arm does with an unrecognised argument; for every release before this one that was to
# update, which asks the same question again one generation down. Measured, from a checkout that
# kept these helpers and lost the dispatch arm: an unbounded chain of full updates, each one taking
# its own backup of a server the one above it had already stopped. So the marker is the arm itself,
# and the variable is carried into the child as the second bound - a generation that already came
# from the phase places the files here rather than asking anyone else to.
install_checked_out_runtime_files() {
  if [ -n "${ATHANOR_PLACING_RUNTIME_FILES:-}" ]; then
    install_runtime_files
  elif checkout_installs_its_own_runtime_files; then
    ATHANOR_PLACING_RUNTIME_FILES=1 \
      /bin/sh "$athanor_root/scripts/athanor" update install-runtime-files
  else
    # A revision from before the phase cannot place its own files, so this run places them the way
    # every run used to. That is the old behaviour carrying the old fault, and it is the most this
    # shell can honestly do about a list it has no way to read.
    install_runtime_files
  fi
  runtime_files_match_checkout ||
    fail "the install step did not place matching garden and athanor commands for this revision"
}

# That the runtime files are now this revision's, rather than that something was asked to make them
# so. The copy of this script under /usr/local/bin is the first thing install_runtime_files places,
# so if it still differs from the checkout, the phase did nothing at all - which is precisely how a
# revision that mentions the sub-command without answering to it would fail, silently and looking
# exactly like success. Where `cmp` is missing the update goes on without the evidence, for the
# reason the step timeout does: refusing to update at all is worse than an unwitnessed step.
runtime_files_match_checkout() {
  command -v cmp >/dev/null 2>&1 || return 0
  cmp -s "$athanor_root/scripts/athanor" "$(runtime_path /usr/local/bin/athanor)" || return 1
  if grep -q '^[[:space:]]*install .*runtime_path /usr/local/bin/garden)' "$athanor_root/scripts/athanor"; then
    cmp -s "$athanor_root/scripts/athanor" "$(runtime_path /usr/local/bin/garden)"
  fi
}

# No step of an update may run without a bound. `timeout` is coreutils, so it is on every host
# this installs on; where it is missing the step still runs, because refusing to update at all is
# worse than an unbounded one.
# Says which of the two things happened.
#
# Both used to be reported as the timeout: `timeout ... || fail "passed N minutes"` fires on any
# non-zero exit, so a build that failed in ninety seconds was announced as one that had run for half
# an hour. `timeout` exits 124 when it is the one that stopped the command, and that is the only
# case the old sentence was ever true for; everything else is the step's own failure and should say
# so, with its exit code, because that is what tells someone where to look.
run_update_step() {
  step_label="$1"
  shift
  if command -v timeout >/dev/null 2>&1; then
    timeout --signal=TERM --kill-after=60 "$athanor_update_step_seconds" "$@" || update_step_status=$?
  else
    "$@" || update_step_status=$?
  fi
  if [ "${update_step_status:-0}" -ne 0 ]; then
    if [ "${update_step_status}" -eq 124 ] || [ "${update_step_status}" -eq 137 ]; then
      fail "the update step '$step_label' passed $((athanor_update_step_seconds / 60)) minutes and was stopped"
    fi
    fail "the update step '$step_label' failed with exit ${update_step_status}"
  fi
}

# The same bound, for a step whose failure is not a reason to put a good release back.
#
# Returns non-zero instead of calling `fail`, and keeps its status in a variable of its own:
# `run_update_step` never clears `update_step_status`, so writing into it here would make the next
# `run_update_step` report a failure that had already been handled.
run_optional_update_step() {
  optional_step_label="$1"
  shift
  optional_step_status=0
  if command -v timeout >/dev/null 2>&1; then
    timeout --signal=TERM --kill-after=60 "$athanor_update_step_seconds" "$@" ||
      optional_step_status=$?
  else
    "$@" || optional_step_status=$?
  fi
  if [ "$optional_step_status" -ne 0 ]; then
    if [ "$optional_step_status" -eq 124 ] || [ "$optional_step_status" -eq 137 ]; then
      printf 'garden: %s passed %s minutes and was stopped.\n' \
        "$optional_step_label" "$((athanor_update_step_seconds / 60))" >&2
    fi
    return 1
  fi
  return 0
}

# Whether the checkout's own installer answers to the release-steps entry point.
#
# Asked of the file for the reason `checkout_installs_its_own_runtime_files` is: `athanor update` is
# the PREVIOUS release's copy of this script, so the only thing it can know about the revision it is
# installing is what that revision's files say. A checkout from before the entry point existed
# treats `--release-steps` as a bootstrap argument it does not recognise and runs a whole install -
# accounts, sudoers, a regenerated shared secret, a certificate - on a stopped production box. That
# is the outcome this one grep exists to prevent, and it looks for the dispatch arm rather than the
# name, because the name also appears in prose there.
checkout_runs_its_own_release_steps() {
  grep -q '^  --release-steps)' "$athanor_root/scripts/install-native.sh" 2>/dev/null
}

# The steps a release carries that are not code: the packages in the capability table, the workspace
# layout, and the runner settings measured from this kernel.
#
# WHY THIS CALLS THE INSTALLER RATHER THAN DOING THE WORK. Three of them shipped to the owner's
# server present and switched off, because an update ran three steps - fetch, install dependencies,
# build - and the runtime files, and nothing else an install does. Copying those steps here would
# put the same list in two files, which is the shape that produced the runtime-file lag this script
# already carries a whole phase to work around. The installer is pulled before this runs, so the
# steps that execute are always the ones the incoming release wrote.
#
# A FAILURE HERE DOES NOT ROLL THE RELEASE BACK, for the reason `fetch_managed_chromium` gives: a
# distribution mirror that is unreachable at three in the morning must not put a working release
# back and do it again every week. What the owner gets instead is this sentence and two `doctor`
# arms that name the consequences - the document toolchain, and the filesystem boundary the runner
# is actually enforcing. It runs before `database_at_risk=1`, so nothing here has touched the data.
install_release_carried_steps() {
  if ! checkout_runs_its_own_release_steps; then
    warn "this revision's installer has no --release-steps entry point, so the packages, workspace layout and runner settings it carries were not applied; sudo athanor doctor says what is missing"
    return 0
  fi
  # Output is not captured, deliberately. Installing forty packages is the longest step in an update
  # and it prints for minutes; held back until it ended, an operator at a terminal would watch a
  # silent screen through the slowest part of the run and have nothing to read if it hung.
  run_optional_update_step "applying what this release carries" \
    /bin/sh "$athanor_root/scripts/install-native.sh" --release-steps ||
    warn "some of what this release carries could not be applied; the release itself is installed and running. sudo athanor doctor says which part is missing"
  # Attempted, not succeeded. What the marker answers is "has this run already been through here",
  # and a second attempt in the same outage would fail the same way for the same reason.
  install -d -m 0755 "$athanor_state" 2>/dev/null || true
  : >"$athanor_release_steps_marker" 2>/dev/null || true
}

announce_outage() {
  previous_outage=$(cat "$athanor_state/last-update-outage-seconds" 2>/dev/null || printf '')
  case "$previous_outage" in
    ''|*[!0-9]*) previous_outage="" ;;
  esac
  if [ -n "$previous_outage" ]; then
    printf 'garden: stopping the server now for the backup, rebuild and restart. The previous update was offline for about %s minutes.\n' \
      "$(((previous_outage + 59) / 60))"
  else
    printf 'garden: stopping the server now for the backup, rebuild and restart. This run is bounded to %s minutes per step and its duration is reported at the end.\n' \
      "$((athanor_update_step_seconds / 60))"
  fi
  # The independently supervised jobs survive runner restarts; in-process sessions do not.
  printf 'garden: independently supervised jobs and analysis keep running. In-process sessions may stop; declared services restart.\n'
}

# What an update is about to destroy, asked of the one process on this box that knows.
#
# Sets `runner_background_count` to the number of unfinished background commands, or to the EMPTY
# STRING when the runner answered and did not report the field. That distinction is the point of
# this function and is deliberately not collapsed into a zero: `athanor update` runs the PREVIOUS
# release's copy of this script against whatever runner is on the disk, so this always has to cope
# with a runner older than itself, and reading a missing field as "nothing is running" would be this
# script quietly claiming a protection it never carried out. Callers say "could not tell".
#
# WHERE THE FIELD COMES FROM. The runner's `/healthz` handler in
# services/workspace-runner/src/server.ts, which publishes `ProcessManager.backgroundWork()` under
# exactly the two names the sed patterns below look for. Nothing checks that at build time in either
# direction: renaming a field there, or a pattern here, leaves both halves compiling and turns this
# gate back into the "could not tell" line, silently. long-work.test.ts runs these three functions
# and both case blocks, cut out of this file at test time, against the real body that route answers.
#
# WHY THE EXISTING GATE CANNOT ANSWER IT. `wait_for_idle_worker` reads `athanor_worker_active`,
# which counts TURNS in flight. A background command outlives the turn that started it - that is the
# whole of what `background: true` buys - so on a box whose agent left a long job running and
# finished its turn, the worker is idle, the weekly window opens, and the job dies. Measured on the
# production box, which runs f02ca24 and is fifty-one commits behind this branch and therefore
# describes an older athanor: unattended updates enabled, next run Mon 2026-09-07 03:34:33 UTC,
# `athanor_worker_active 0`, and the runner's /healthz reporting nothing about running commands.
#
# A RUNNER THAT DOES NOT ANSWER COUNTS AS ZERO, not as unknown. There is nothing for a restart to
# destroy on a runner that is not serving, and the alternative - refusing to update while the runner
# is unreachable - would make an unreachable runner the one fault an update can never fix.
runner_background_work() {
  runner_background_count=""
  runner_background_longest_ms=""
  runner_health=$(curl -fsS --max-time 5 http://127.0.0.1:4300/healthz 2>/dev/null) || {
    runner_background_count=0
    return 0
  }
  runner_background_count=$(printf '%s' "$runner_health" | tr ',' '\n' |
    sed -n 's/.*"backgroundCommands"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' | sed -n '1p')
  runner_restart_unsafe=$(printf '%s' "$runner_health" | tr ',' '\n' |
    sed -n 's/.*"runnerRestartUnsafeCommands"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' | sed -n '1p')
  if [ -n "$runner_restart_unsafe" ]; then runner_background_count="$runner_restart_unsafe"; fi
  runner_background_longest_ms=$(printf '%s' "$runner_health" | tr ',' '\n' |
    sed -n 's/.*"backgroundLongestRemainingMs"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' |
    sed -n '1p')
}

# The count and how long the longest job still has, in one sentence an operator can act on. A bare
# count says an update would break something; "the longest has about 6 hours left" is what tells
# them whether to wait for it or to stop it themselves. Hours past two of them, because a ceiling
# that now runs for a day or more turns this into four-figure minutes, which nobody reads as a
# length. Only reached on the arm where the count is a positive number, so the empty case - a runner
# that does not report the field at all - never gets this far and is answered in its own words.
background_work_summary() {
  background_minutes_left=0
  if [ -n "${runner_background_longest_ms:-}" ]; then
    background_minutes_left=$(((runner_background_longest_ms / 1000 + 59) / 60))
  fi
  if [ "$background_minutes_left" -gt 120 ]; then
    printf '%s background command(s) are still running; the longest has about %s hours left' \
      "$runner_background_count" "$(((background_minutes_left + 59) / 60))"
  elif [ "$background_minutes_left" -gt 0 ]; then
    printf '%s background command(s) are still running; the longest has about %s minutes left' \
      "$runner_background_count" "$background_minutes_left"
  else
    printf '%s background command(s) are still running' "$runner_background_count"
  fi
}

# Go back to the release a backup was taken from, on purpose.
#
# The update path already knows how to undo itself, but only while it is failing. A release that
# passes every automatic gate and is still wrong - which is what the printed "keep this backup until
# post-update checks pass" is warning about - left the owner with a verified backup, an instruction
# to keep it, and no command that consumes it. Restoring alone was not enough either: it puts the
# data back under the new code, which is the half that was wrong.
rollback_athanor() {
  need_root rollback "${1:-}"
  acquire_maintenance_lock
  source_directory="${1:-}"
  if [ -z "$source_directory" ]; then
    source_directory=$(
      find "$athanor_backup_root" -mindepth 1 -maxdepth 1 -type d -name '????????T??????Z' \
        2>/dev/null |
        while IFS= read -r candidate; do
          [ -f "$candidate/SHA256SUMS" ] && printf '%s\n' "$candidate"
        done |
        sort -r |
        sed -n '1p'
    )
    [ -n "$source_directory" ] ||
      fail "no complete backup found in $athanor_backup_root; pass one: sudo athanor rollback /path/to/backup"
    printf 'Rolling back to the newest complete backup: %s\n' "$source_directory"
  fi
  [ -f "$source_directory/SHA256SUMS" ] ||
    fail "usage: sudo athanor rollback [/path/to/backup]"
  validate_restore_source "$source_directory"
  target_revision=""
  [ -f "$source_directory/revision" ] && target_revision=$(cat "$source_directory/revision")
  if [ -n "$target_revision" ]; then
    git -C "$athanor_root" cat-file -e "$target_revision^{commit}" 2>/dev/null ||
      fail "revision $target_revision is not in this checkout; fetch it first or restore without changing code: sudo athanor restore $source_directory --yes"
    printf 'Putting the code back to %s and the data back to %s.\n' \
      "$target_revision" "$source_directory"
    stop_athanor
    printf 'The server stays stopped if reconstruction fails; keep backup %s.\n' "$source_directory"
    git -C "$athanor_root" reset --hard "$target_revision" >/dev/null ||
      fail "could not put the checkout back to $target_revision"
    cd "$athanor_root" || fail "could not enter $athanor_root"
    CI=true pnpm install --frozen-lockfile || fail "could not install dependencies for $target_revision"
    CI=true pnpm -r build || fail "could not build $target_revision"
    # The revision being rolled back to places its own files, which is what separates this call site
    # from the one inside the update's own trap. The shell running this command is the release being
    # rolled back *from*, and its list names files a revision from before them never carried: an
    # `install` refusing one of those would abandon the rollback with the data still to go.
    install_checked_out_runtime_files
    nginx -t
    systemctl daemon-reload
  else
    # A backup from before revisions were recorded. The data still goes back; the code cannot, and
    # saying so is better than guessing at a revision.
    printf 'This backup does not record a revision, so only the data is put back.\n'
  fi
  restore_athanor "$source_directory" --yes
  "$(runtime_path /usr/local/lib/athanor/athanor-network-refresh)" >/dev/null 2>&1 || true
  printf 'Rollback complete. Run sudo athanor doctor to confirm, and note that auto-update will\n'
  printf 'move this server forward again at its next window unless you turn it off:\n'
  printf '  sudo athanor auto-update off\n'
}

update_athanor() {
  need_root update
  acquire_maintenance_lock
  [ -d "$athanor_root/.git" ] || fail "$athanor_root is not a Git checkout"
  [ -z "$(git -C "$athanor_root" status --porcelain)" ] ||
    fail "$athanor_root has local changes; preserve or remove them before updating"
  # `wait_for_idle_worker` returns before the stop, so a task that the API queued in between used
  # to be killed mid-flight. Re-checked here, where the remaining window is a fraction of a second.
  if [ "${athanor_require_idle:-0}" = 1 ] && ! worker_is_idle; then
    printf 'garden: a task started while the update was preparing; the next weekly window will retry.\n'
    # Corrected before returning, and this is the only place that can. `auto_update_run` has already
    # written `running` pessimistically - it has to, because a run killed by its own start timeout
    # reaches no further line - and returning through here left that record standing for ever. So a
    # box whose worker happened to pick up a task in the last fraction of a second was reported by
    # `doctor` as an update that started and never reported back, weekly, for as long as it lasted:
    # the loudest thing the record can say, for the most ordinary thing that can happen.
    record_update_status skipped 'a task started while the update was preparing'
    return 0
  fi
  # The work an idle worker does not account for, refused here rather than destroyed below.
  #
  # This is the by-hand arm. `auto_update_run` stands down silently and comes back next week; an
  # operator at a terminal has neither of those, so they are told what is running and left to
  # decide - waiting for a six-hour job is a different choice from stopping it, and this shell is
  # not the thing that should be making it. The override is named in the same sentence, because a
  # refusal an operator cannot get past is its own kind of broken machine.
  #
  # A runner that does not report the field leaves this empty, and an empty answer is not treated as
  # a zero: the update goes ahead - stopping a box from ever updating because it cannot answer a
  # question is worse than the risk - and says out loud that it could not tell.
  runner_background_work
  case "${runner_background_count:-}" in
    '')
      printf 'garden: this runner does not report background commands, so this update cannot tell whether it is about to stop a long job.\n'
      ;;
    0) ;;
    *)
      [ -n "${ATHANOR_UPDATE_OVER_BACKGROUND_WORK:-}" ] ||
        fail "$(background_work_summary), and this update would stop them for good - only declared services come back. Wait for them, stop them from the interface, or run again with ATHANOR_UPDATE_OVER_BACKGROUND_WORK=1 to update anyway"
      printf 'garden: %s, and ATHANOR_UPDATE_OVER_BACKGROUND_WORK is set, so this update will stop them.\n' \
        "$(background_work_summary)"
      ;;
  esac
  previous_revision=$(git -C "$athanor_root" rev-parse --verify HEAD)
  announce_outage
  outage_started=$(date +%s)
  backup_athanor "" keep-stopped
  rollback_backup="$last_backup_destination"
  # Whether the new release has been allowed to touch the database yet.
  #
  # Migrations run when the new code starts, so until `restart_athanor` the schema and every row are
  # exactly what the running release left. The rollback used to drop and pg_restore the owner's only
  # database regardless - so the two commonest unattended failures, an unreachable remote and a
  # registry hiccup at install, both destroyed and rebuilt a database that nothing had touched, and
  # any conversation written between the backup and the failure was lost to a fault that never
  # reached the data.
  database_at_risk=0

  rollback_update() {
    original_status=$?
    trap - EXIT INT TERM
    set +e
    if [ "$database_at_risk" -eq 1 ]; then
      printf 'athanor update failed after the new release started; restoring revision %s and backup %s\n' \
        "$previous_revision" "$rollback_backup" >&2
    else
      printf 'athanor update failed before the new release started; restoring revision %s. The database was not touched and is left alone; backup %s is kept.\n' \
        "$previous_revision" "$rollback_backup" >&2
    fi
    rollback_ok=1
    stop_athanor || rollback_ok=0
    git -C "$athanor_root" reset --hard "$previous_revision" >/dev/null 2>&1 ||
      rollback_ok=0
    if cd "$athanor_root"; then
      CI=true pnpm install --frozen-lockfile >/dev/null 2>&1 || rollback_ok=0
      CI=true pnpm -r build >/dev/null 2>&1 || rollback_ok=0
      # Configuration migrations can run before the first service starts. Restore the verified
      # private configuration before the checked-out revision activates its own runtime files.
      if (validate_restore_source "$rollback_backup"); then
        tar -C "$(dirname "$athanor_config")" -xzf "$rollback_backup/configuration.tar.gz" || rollback_ok=0
      else
        rollback_ok=0
      fi
      if [ "$rollback_ok" -eq 1 ]; then
        (install_checked_out_runtime_files) || rollback_ok=0
      fi
    else
      rollback_ok=0
    fi
    nginx -t >/dev/null 2>&1 || rollback_ok=0
    systemctl daemon-reload || rollback_ok=0
    systemctl enable athanor-network-watch.service athanor-network-refresh.timer \
      athanor-network-refresh.path >/dev/null 2>&1 || rollback_ok=0
    if [ "$database_at_risk" -eq 1 ]; then
      (restore_athanor "$rollback_backup" --yes) || rollback_ok=0
    else
      if [ "$rollback_ok" -eq 1 ]; then
        systemctl start athanor.target >/dev/null 2>&1 || rollback_ok=0
        systemctl reload-or-restart nginx >/dev/null 2>&1 || rollback_ok=0
        wait_until_serving || rollback_ok=0
      fi
    fi
    "$(runtime_path /usr/local/lib/athanor/athanor-network-refresh)" >/dev/null 2>&1 ||
      rollback_ok=0
    if [ "$rollback_ok" -eq 1 ]; then
      printf 'Rollback completed; the failed update was not activated.\n' >&2
      # Written down, not only printed. This function is reached from the weekly timer as often as
      # from a terminal, and on that route the sentence above goes into a journal nobody is reading
      # at three in the morning. Left there, a box that fails the same update every week looks
      # exactly like a box with nothing to update - the rollback worked, so nothing is broken; it
      # has simply stopped moving, and stopping quietly is the failure mode this record ends.
      record_update_status failed 'the update was rolled back and the previous release put back'
    else
      printf 'Automatic rollback was incomplete; keep the backup and run sudo athanor doctor.\n' >&2
      record_update_status failed 'the update failed and the rollback did not finish; keep the backup'
    fi
    exit "$original_status"
  }
  trap rollback_update EXIT
  trap 'exit 130' INT TERM

  # A checkout with nowhere to pull from is repaired rather than reported as up to date.
  #
  # Installing at a pinned tag leaves a detached HEAD, and `git pull --ff-only` answers "Already up
  # to date" on one of those - for ever. Every box installed by the documented command was therefore
  # frozen on the release it was installed with, receiving no fix of any kind, while `doctor`
  # reported unattended updates were on. Putting it on a branch that follows the upstream is all it
  # needs, and it keeps the revision it is on while doing so.
  if ! git -C "$athanor_root" rev-parse --abbrev-ref '@{upstream}' >/dev/null 2>&1; then
    printf 'This checkout was not following a branch, so it could never have updated. Fixing that.\n'
    git -C "$athanor_root" fetch --tags --prune origin ||
      fail "could not reach the source to repair this checkout"
    git -C "$athanor_root" checkout -B athanor HEAD ||
      fail "could not put this checkout on a branch"
    git -C "$athanor_root" branch --set-upstream-to=origin/main athanor ||
      fail "could not follow origin/main for updates"
  fi
  run_update_step "fetching the new revision" git -C "$athanor_root" pull --ff-only
  cd "$athanor_root"
  # CI=true because this runs from a timer with no terminal. When the new revision removes a
  # workspace package, pnpm decides the modules directory must be rebuilt and stops to ask first;
  # with nothing to answer it, the update aborts on ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY and
  # rolls straight back, so the box could never leave the release that dropped the package.
  run_update_step "installing dependencies" env CI=true pnpm install --frozen-lockfile
  run_update_step "building" env CI=true pnpm -r build
  # Cleared first, so that only a marker written by THIS run counts. A checkout whose phase does
  # not apply the release steps leaves none, and this shell applies them itself below.
  rm -f "$athanor_release_steps_marker" 2>/dev/null || true
  install_checked_out_runtime_files
  nginx -t
  systemctl daemon-reload
  systemctl enable --now athanor-network-watch.service athanor-network-refresh.timer \
    athanor-network-refresh.path
  "$(runtime_path /usr/local/lib/athanor/athanor-network-refresh)"
  # Native things the new checkout needs that `pnpm install` does not place. The installer fetches
  # the managed Chromium once and nothing ever fetched it again, so the first release to bump the
  # pinned Playwright left every existing box driving a browser it no longer has - silently, with
  # `doctor` reporting it healthy. Here rather than after the restart because this is the window the
  # server is already stopped for; the owner is paying for one outage either way.
  fetch_managed_chromium
  # And everything else a release carries that is not code, from the incoming release's own
  # installer. After install_checked_out_runtime_files on purpose: the runner settings step measures
  # the filesystem boundary by running /usr/local/lib/athanor/athanor-sandbox, which that step is
  # what places. Before the restart, so the runner comes up reading the settings this release wrote
  # rather than needing a second outage to pick them up.
  if [ -f "$athanor_release_steps_marker" ]; then
    printf 'garden: the packages, workspace layout and runner settings this release carries were applied by the checkout while it placed its runtime files.\n'
  else
    install_release_carried_steps
  fi
  rm -f "$athanor_release_steps_marker" 2>/dev/null || true
  # Past this line the new release is running and its migrations have had the database, so a failure
  # from here does need the backup put back.
  database_at_risk=1
  restart_athanor
  trap - EXIT INT TERM
  outage_seconds=$(($(date +%s) - outage_started))
  # Recorded so the next run can tell the operator what to expect before it takes the server away.
  install -d -m 0755 "$athanor_state" 2>/dev/null || true
  printf '%s\n' "$outage_seconds" >"$athanor_state/last-update-outage-seconds" 2>/dev/null || true
  # Every route to a completed update records itself, exactly as every route to a verified backup
  # does - by hand from a terminal as well as from the weekly timer, because "when did this box last
  # actually move" is the same question either way.
  record_update_status ok ''
  printf 'Update complete after %s minutes offline. Keep rollback backup %s until post-update checks pass.\n' \
    "$(((outage_seconds + 59) / 60))" "$rollback_backup"
}

# A worker that cannot be reached counts as idle: it is not running anything either.
worker_is_idle() {
  active_tasks=$(
    curl -fsS --max-time 5 http://127.0.0.1:4201/metrics 2>/dev/null |
      sed -n 's/^athanor_worker_active //p' |
      sed -n '1p'
  )
  case "$active_tasks" in
    ''|0) return 0 ;;
  esac
  return 1
}

# Waits for the worker to become idle so an unattended update never interrupts a task
# that is already running.
wait_for_idle_worker() {
  waited_seconds=0
  while [ "$waited_seconds" -lt 1800 ]; do
    worker_is_idle && return 0
    sleep 30
    waited_seconds=$((waited_seconds + 30))
  done
  return 1
}

# Waits a short while for the worker to go idle. The unattended backup is not worth an outage in
# the middle of somebody's work, and unlike the update it has no reason to insist: another window
# comes round tomorrow, and a backup a day late is a backup.
#
# What happens at the end of the five minutes is the whole point - it is the path that quietly made
# the interface's daily promise false - so the length is overridable. A policy that can only be
# exercised by waiting five real minutes is one nobody ever exercises.
wait_briefly_for_idle_worker() {
  waited_seconds=0
  while :; do
    worker_is_idle && return 0
    [ "$waited_seconds" -lt "$athanor_backup_idle_wait_seconds" ] || return 1
    sleep 30
    waited_seconds=$((waited_seconds + 30))
  done
}

# The unattended daily backup.
#
# `backup_athanor` stops athanor.target for the length of the archive, because a tar of a workspace
# the agent is writing into is a tar of half-written files. That is the right trade for a copy taken
# once and trusted later, and it is why this waits for an idle worker instead of running regardless:
# on an unattended box at a randomised hour, idle is the normal state, and a run that finds work in
# progress simply leaves it alone.
#
# Without this, backup cadence equalled release cadence - `backup_athanor` was reachable only from
# the sub-command, from `update_athanor` (which returns before the backup when HEAD already matches
# upstream), and from rollback. A server left alone for a year had no copy of its conversations, its
# files, its connector credentials or its keys, and `athanor doctor` never mentioned it.
auto_backup_run() {
  systemctl is-enabled --quiet "$backup_timer" 2>/dev/null ||
    fail "automatic backups are off; run sudo athanor backup auto on"
  if ! wait_briefly_for_idle_worker; then
    # Written down, not merely printed. This is the path that made the promise false while nothing
    # went wrong anywhere: the unit exits zero, the timer schedules tomorrow, and a box that is
    # working every time the window comes round stands down every day in silence. Standing down
    # once is the design; standing down for a month is the owner's to know about.
    record_backup_status skipped 'a task was still running when the window came round'
    printf 'garden: a task is running; the next window will take the backup.\n'
    return 0
  fi
  # The idle check can race with an update; wait on the same kernel lock before inspecting again.
  if acquire_maintenance_lock "$athanor_backup_idle_wait_seconds"; then
    :
  else
    lock_result=$?
    [ "$lock_result" -eq 75 ] || return "$lock_result"
    record_backup_status skipped 'another maintenance operation was still running'
    printf 'garden: maintenance is busy; the next window will take the backup.\n'
    return 0
  fi
  if ! worker_is_idle; then
    record_backup_status skipped 'a task started while waiting for maintenance'
    printf 'garden: a task started; the next window will take the backup.\n'
    return 0
  fi
  backup_runner_health=$(curl -fsS --max-time 5 http://127.0.0.1:4300/healthz 2>/dev/null) || backup_runner_health=''
  if ! printf '%s' "$backup_runner_health" | python3 -c '
import json, sys
try:
    health = json.load(sys.stdin)
    count = health.get("backgroundCommands")
    idle = health.get("ok") is True and type(count) is int and count == 0
except (ValueError, AttributeError):
    idle = False
sys.exit(0 if idle else 1)
'; then
    record_backup_status skipped 'background computation is active or the runner could not confirm it is idle'
    printf 'garden: background work is not confirmed idle; the next window will take the backup.\n'
    return 0
  fi
  # Pessimistic first and corrected on the way out, because a run killed by its own start timeout
  # never reaches another line of this function. Without it the newest thing on record after a
  # ninety-minute kill would be yesterday's success.
  record_backup_status running ''
  # In a subshell so `fail` inside the backup ends the backup rather than this script, which is how
  # `update_athanor` already calls `restore_athanor`. Its output is held back so the reason can be
  # taken from it, then put out again so the journal has the whole of it either way.
  if backup_output=$( (backup_athanor) 2>&1 ); then
    printf '%s\n' "$backup_output"
    return 0
  fi
  printf '%s\n' "$backup_output" >&2
  record_backup_status failed "$(backup_failure_reason "$backup_output")"
  # Non-zero, so systemd marks the unit failed and the journal keeps the run at error level.
  return 1
}

# Started by OnFailure= on the backup unit. Covers the one ending `auto_backup_run` cannot write
# down itself: a run stopped by its own start timeout, or by the power going off, which gets no
# further line to run.
auto_backup_alert() {
  [ "$(backup_status_field outcome)" = running ] || return 0
  record_backup_status failed 'the run was stopped before it finished'
  printf 'garden: the daily backup did not finish. The last complete copy in %s is untouched.\n' \
    "$athanor_backup_root" >&2
}

auto_backup() {
  need_root backup "auto" "${1:-status}"
  case "${1:-status}" in
    on)
      systemctl enable --now "$backup_timer"
      printf 'Automatic backups are on: daily, at a randomised hour, when nothing is running.\n'
      printf 'They are kept in %s and contain server keys.\n' "$athanor_backup_root"
      ;;
    off)
      systemctl disable --now "$backup_timer" >/dev/null 2>&1 || true
      printf 'Automatic backups are off. Run “sudo athanor backup” to take one by hand.\n'
      ;;
    status)
      if systemctl is-enabled --quiet "$backup_timer" 2>/dev/null; then
        printf 'Automatic backups: on\n'
        systemctl list-timers --no-pager --no-legend "$backup_timer" || true
      else
        printf 'Automatic backups: off\n'
      fi
      newest_backup=$(latest_backup_age)
      case "$newest_backup" in
        '') printf 'Newest backup: none\n' ;;
        *) printf 'Newest backup: %s days old\n' "$newest_backup" ;;
      esac
      report_backup_status
      ;;
    run) auto_backup_run ;;
    alert) auto_backup_alert ;;
    *) fail 'usage: sudo athanor backup auto {on|off|status}' ;;
  esac
}

# The newest checksum-verified backup this script manages, or nothing when there is none.
#
# Same two rules as `prune_backups`, for the same reasons: a directory without a SHA256SUMS is
# wreckage from a run that died partway and is not a copy of anything, and a destination the
# operator named themselves is theirs rather than ours. Ordered by name because the name is a UTC
# timestamp, so it sorts chronologically without asking the filesystem anything.
latest_backup_path() {
  [ -d "$athanor_backup_root" ] || return 0
  find "$athanor_backup_root" -mindepth 1 -maxdepth 1 -type d \
    -name '????????T??????Z' 2>/dev/null |
    while IFS= read -r candidate; do
      [ -f "$candidate/SHA256SUMS" ] && printf '%s\n' "$candidate"
    done |
    sort -r |
    sed -n '1p'
}

# When a backup directory was taken, read off its own name rather than off its mtime: the name is
# the second the run started, which is what the copy is a copy of.
backup_taken_at() {
  basename -- "$1" |
    sed -n 's/^\(....\)\(..\)\(..\)T\(..\)\(..\)\(..\)Z$/\1-\2-\3T\4:\5:\6Z/p'
}

# How old the newest checksum-verified backup is, in whole days, or nothing when there is none.
latest_backup_age() {
  newest=$(latest_backup_path)
  [ -n "$newest" ] || return 0
  newest_epoch=$(stat -c '%Y' "$newest/SHA256SUMS" 2>/dev/null) || return 0
  [ -n "$newest_epoch" ] || return 0
  printf '%s' "$((($(date +%s) - newest_epoch) / 86400))"
}

# What the box actually did about backups, written where the interface can read it.
#
# Settings asserted that a backup is taken daily, and an assertion was all it was. Two paths made
# it false without anything on the box saying so: a run that stood down because the worker was
# still busy exited zero and spoke only to the journal, and a run that failed left nothing behind
# at all - `prune_backups` removes a directory with no checksum manifest, because such a directory
# cannot restore anything. An owner could read that sentence every day for a year on a box that had
# never once copied itself.
#
# `at` and `outcome` are about the last run; `copy_at` and `copy_bytes` are about the newest copy
# that actually exists, which is the question underneath. They are separate because the interesting
# case is exactly the one where they disagree.
record_backup_status() {
  install -d -m 0755 "$athanor_state" 2>/dev/null || true
  status_copy=$(latest_backup_path)
  {
    printf 'at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'outcome=%s\n' "$1"
    printf 'reason=%s\n' "${2:-}"
    if [ -n "$status_copy" ]; then
      printf 'copy_at=%s\n' "$(backup_taken_at "$status_copy")"
      printf 'copy_bytes=%s\n' \
        "$(du -sk "$status_copy" 2>/dev/null | awk '{printf "%.0f", $1 * 1024}')"
    fi
  } >"$athanor_backup_status" 2>/dev/null || return 0
  # World-readable on purpose, like the certificate and dynamic DNS files beside it: the API reads
  # it as an unprivileged service so the settings screen can show it. Nothing secret goes in - see
  # backup_failure_reason for the rule that keeps it that way.
  chmod 0644 "$athanor_backup_status" 2>/dev/null || true
}

backup_status_field() {
  sed -n "s/^$1=//p" "$athanor_backup_status" 2>/dev/null | sed -n '1p'
}

# The same record for the update, in the same format and for the same reason.
#
# `revision` is the extra field this one carries: the question underneath "did the update work" is
# "what is this box running", and after a rollback those two have different answers - the run
# failed, and the revision is the one it started from. Both are written so `doctor` can say which.
record_update_status() {
  install -d -m 0755 "$athanor_state" 2>/dev/null || true
  {
    printf 'at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'outcome=%s\n' "$1"
    printf 'reason=%s\n' "${2:-}"
    printf 'revision=%s\n' \
      "$(git -C "$athanor_root" rev-parse --short HEAD 2>/dev/null || printf 'unknown')"
  } >"$athanor_update_status" 2>/dev/null || return 0
  # World-readable like the backup, certificate and dynamic DNS records beside it, so the API can
  # read it as an unprivileged service. Nothing secret goes in: an outcome, a stamp, a revision,
  # and a reason this script wrote itself.
  chmod 0644 "$athanor_update_status" 2>/dev/null || true
}

update_status_field() {
  sed -n "s/^$1=//p" "$athanor_update_status" 2>/dev/null | sed -n '1p'
}

# Why a run failed, in this program's own words and nobody else's.
#
# Everything a failing run printed is in the journal for whoever is at a shell. What lands in a
# world-readable file, and from there in a browser, is restricted to lines this script wrote:
# `tar` and `pg_dump` name the file they choked on, and a path inside somebody's workspace has no
# business sitting outside the encrypted store.
backup_failure_reason() {
  own_words=$(printf '%s\n' "$1" | sed -n -e 's/^garden: //p' -e 's/^athanor: //p' | awk 'NF { last = $0 } END { print last }')
  if [ -n "$own_words" ]; then
    printf '%s' "$own_words"
  else
    printf 'the run did not finish; journalctl -u athanor-backup.service has the detail'
  fi
}

# The last run, in the words the interface uses for it.
report_backup_status() {
  last_outcome=$(backup_status_field outcome)
  case "$last_outcome" in
    '') printf 'Last run: nothing recorded yet\n' ;;
    ok) printf 'Last run: %s, complete\n' "$(backup_status_field at)" ;;
    running) printf 'Last run: started %s and has not reported back\n' "$(backup_status_field at)" ;;
    skipped) printf 'Last run: %s, stood down - %s\n' "$(backup_status_field at)" "$(backup_status_field reason)" ;;
    *) printf 'Last run: %s, failed - %s\n' "$(backup_status_field at)" "$(backup_status_field reason)" ;;
  esac
}

# Written down first, then said. `fail` exits, so a reason that only reached the journal is a reason
# nothing outside the journal can report - and every one of these is a state that repeats weekly for
# as long as its cause lasts, which is precisely the thing this record exists to make visible.
update_failed() {
  record_update_status failed "$1"
  fail "$1"
}

auto_update_run() {
  systemctl is-enabled --quiet "$auto_update_timer" 2>/dev/null ||
    update_failed "unattended updates are off; run sudo athanor auto-update on"
  [ -d "$athanor_root/.git" ] || update_failed "$athanor_root is not a Git checkout"
  git -C "$athanor_root" fetch --quiet --prune ||
    update_failed "the update source could not be reached"
  upstream_revision=$(git -C "$athanor_root" rev-parse --verify --quiet '@{upstream}') ||
    update_failed "$athanor_root has no upstream branch to update from"
  if [ "$(git -C "$athanor_root" rev-parse --verify HEAD)" = "$upstream_revision" ]; then
    printf 'garden: already up to date.\n'
    # A run that found nothing to do is a run that worked. Recording it is what tells the owner
    # weeks later that the timer is still turning, which the revision alone cannot say.
    record_update_status ok 'already on the newest revision'
    return 0
  fi
  if ! wait_for_idle_worker; then
    printf 'garden: a task is still running; the next weekly window will retry.\n'
    # The silent path, and the same one the backup had. Standing down once is the design; standing
    # down every week on a box that is busy whenever the window comes round is the box quietly
    # never updating again, and the exit status says nothing went wrong because nothing did.
    record_update_status skipped 'a task was still running when the window came round'
    return 0
  fi
  # The same stand-down for the work an idle worker cannot see.
  #
  # An agent's background command outlives the turn that started it, so `wait_for_idle_worker` above
  # returns happily while a twenty-hour alignment is four hours from finishing. Stopping the server
  # ends it, and unlike a service nothing brings it back or even records that it existed - the next
  # poll of its id answers "Background process not found". Losing a day of the owner's compute at
  # 03:34 on a Monday is worse than being a week behind on a release, so this waits rather than
  # insists, and `record_update_status` is what stops the waiting from being silent: `doctor` reads
  # that line, so a box that stands down repeatedly says so instead of quietly never updating.
  #
  # Not `wait_for_idle_worker`'s half-hour loop, deliberately. That length suits a turn; a job with
  # hours left would spend the window sleeping and stand down anyway, and holding the timer's unit
  # open for thirty minutes buys nothing here.
  runner_background_work
  case "${runner_background_count:-}" in
    '' | 0) ;;
    *)
      printf 'garden: %s; the next weekly window will retry.\n' "$(background_work_summary)"
      record_update_status skipped \
        "$runner_background_count background command(s) an agent left running would have been stopped"
      return 0
      ;;
  esac
  # Pessimistic first and corrected on the way out, because a run killed by its own two-hour start
  # timeout, or by the power going off mid-update, never reaches another line of this script.
  record_update_status running ''
  # Set as an ordinary variable rather than a command prefix: whether a prefix assignment survives
  # a function call is not the same across shells.
  athanor_require_idle=1
  update_athanor
}

# Started by OnFailure= on the update unit. Covers the one ending nothing above can write down: a
# run stopped by TimeoutStartSec, or by the machine losing power partway, which gets no further line
# to run. The `running` guard is what keeps it from filing a report about a run that finished.
auto_update_alert() {
  [ "$(update_status_field outcome)" = running ] || return 0
  record_update_status failed 'the run was stopped before it finished; the server may be part-updated'
  printf 'garden: the unattended update did not finish. Run sudo athanor doctor.\n' >&2
}

# The last run, in the words the interface uses for it.
report_update_status() {
  case "$(update_status_field outcome)" in
    '') printf 'Last run: nothing recorded yet\n' ;;
    ok)
      last_update_reason=$(update_status_field reason)
      printf 'Last run: %s, %s\n' "$(update_status_field at)" \
        "${last_update_reason:-complete}"
      ;;
    running) printf 'Last run: started %s and has not reported back\n' "$(update_status_field at)" ;;
    skipped) printf 'Last run: %s, stood down - %s\n' "$(update_status_field at)" "$(update_status_field reason)" ;;
    *) printf 'Last run: %s, failed - %s\n' "$(update_status_field at)" "$(update_status_field reason)" ;;
  esac
}

auto_update() {
  need_root auto-update "${1:-status}"
  case "${1:-status}" in
    on)
      systemctl enable --now "$auto_update_timer"
      printf 'Unattended updates are on: weekly, at a randomised time.\n'
      printf 'Each run backs up first and rolls the server back if the update fails.\n'
      ;;
    off)
      systemctl disable --now "$auto_update_timer" >/dev/null 2>&1 || true
      printf 'Unattended updates are off. Run “sudo athanor update” to update by hand.\n'
      ;;
    status)
      if systemctl is-enabled --quiet "$auto_update_timer" 2>/dev/null; then
        printf 'Unattended updates: on\n'
        systemctl list-timers --no-pager --no-legend "$auto_update_timer" || true
      else
        printf 'Unattended updates: off\n'
      fi
      printf 'Installed revision: %s\n' \
        "$(git -C "$athanor_root" rev-parse --short HEAD 2>/dev/null || printf 'unknown')"
      report_update_status
      ;;
    run) auto_update_run ;;
    alert) auto_update_alert ;;
    *) fail "usage: athanor auto-update {on|off|status}" ;;
  esac
}

uninstall_athanor() {
  need_root uninstall
  systemctl disable --now athanor.target >/dev/null 2>&1 || true
  # The backup timer was missing from this line, and it is the one unit here that the installer
  # enables with --now and that runs as root on a schedule of its own. Left enabled it went on
  # starting every day for ever on a machine the owner had been told was uninstalled: on a fully
  # removed box it fails against a target whose unit file this function just deleted and starts its
  # alert companion, daily; on a partly removed one it stops and restarts the whole product and
  # writes a fresh archive of the database, the workspaces and every server key into
  # /var/backups/athanor until the disk fills. On a self-hosted product this command is a promise
  # about the owner's own machine.
  systemctl disable --now athanor-jobs.service athanor-gui.service athanor-network-watch.service athanor-network-refresh.timer \
    athanor-network-refresh.path athanor-auto-update.timer athanor-certificate-renew.timer \
    "$backup_timer" \
    >/dev/null 2>&1 || true
  rm -f "$(runtime_path /etc/systemd/system/athanor-certificate-renew.service)" \
    "$(runtime_path /etc/systemd/system/athanor-certificate-renew.timer)" \
    "$(runtime_path /etc/systemd/system/athanor-certificate-alert.service)" \
    "$(runtime_path /etc/update-motd.d/99-athanor)" \
    "$(runtime_path /etc/systemd/system/athanor@.service)" \
    "$(runtime_path /etc/systemd/system/athanor-runner.service)" \
    "$(runtime_path /etc/systemd/system/athanor-jobs.service)" \
    "$(runtime_path /etc/systemd/system/athanor-gui.service)" \
    "$(runtime_path /etc/systemd/system/athanor-work.slice)" \
    "$(runtime_path /etc/systemd/system/athanor-network-refresh.service)" \
    "$(runtime_path /etc/systemd/system/athanor-network-refresh.timer)" \
    "$(runtime_path /etc/systemd/system/athanor-network-refresh.path)" \
    "$(runtime_path /etc/systemd/system/athanor-network-watch.service)" \
    "$(runtime_path /etc/systemd/system/athanor-auto-update.service)" \
    "$(runtime_path /etc/systemd/system/athanor-auto-update.timer)" \
    "$(runtime_path /etc/systemd/system/athanor-auto-update-alert.service)" \
    "$(runtime_path /etc/systemd/system/athanor-backup.service)" \
    "$(runtime_path /etc/systemd/system/athanor-backup.timer)" \
    "$(runtime_path /etc/systemd/system/athanor-backup-alert.service)" \
    "$(runtime_path /etc/systemd/system/athanor.target)"
  # Both nginx layouts, because only the Debian one was named here: on rhel, arch and suse the site
  # lives in conf.d and was left in place, so nginx went on proxying an application that no longer
  # exists. The snippets go too - they are included by the site file and are ours alone.
  rm -f "$(runtime_path /etc/nginx/sites-enabled/athanor)" \
    "$(runtime_path /etc/nginx/sites-available/athanor)" \
    "$(runtime_path /etc/nginx/conf.d/athanor.conf)" \
    "$(runtime_path /etc/nginx/snippets/athanor-https-listen.conf)" \
    "$(runtime_path /etc/nginx/snippets/athanor-security-headers.conf)" \
    "$(runtime_path /etc/nginx/snippets/athanor-app-csp.conf)" \
    "$(runtime_path /etc/nginx/snippets/athanor-preview-origin.conf)" \
    "$(runtime_path /etc/nginx/snippets/athanor-hsts.conf)"
  # The agent account keeps passwordless root for the package helper for as long as this
  # rule exists, so it has to go with the services it was granted for.
  rm -f "$(runtime_path /etc/sudoers.d/athanor-packages)"
  # Stop advertising a server that no longer answers, otherwise clients keep finding it.
  rm -f "$(runtime_path /etc/avahi/services/athanor.service)"
  # Installed only on a host whose ImageMagick had no `magick` of its own. Matched on its own marker
  # so that a real ImageMagick 7, or anything else an operator put there, is left alone.
  magick_shim=$(runtime_path /usr/local/bin/magick)
  if grep -q 'athanor ImageMagick 6 compatibility' "$magick_shim" 2>/dev/null; then
    rm -f "$magick_shim"
  fi
  systemctl reload avahi-daemon >/dev/null 2>&1 ||
    systemctl restart avahi-daemon >/dev/null 2>&1 || true
  if [ -f "$athanor_root/scripts/athanor-native-runtime" ]; then
    /bin/sh "$athanor_root/scripts/athanor-native-runtime" remove
  fi
  supervisor_path="$(runtime_path /usr/local/lib/athanor/mission-supervisor.py)"
  if cmp -s "$athanor_root/scripts/mission-supervisor.py" "$supervisor_path"; then
    rm -f "$supervisor_path"
  fi
  run_manifest_path="$(runtime_path /usr/local/bin/garden-run)"
  if cmp -s "$athanor_root/scripts/reproducible-run.py" "$run_manifest_path"; then
    rm -f "$run_manifest_path"
  fi
  system_recipe_path="$(runtime_path /usr/local/lib/athanor/garden_system.py)"
  if cmp -s "$athanor_root/scripts/garden_system.py" "$system_recipe_path"; then
    rm -f "$system_recipe_path"
  fi
  systemctl daemon-reload
  systemctl reload nginx >/dev/null 2>&1 || true
  printf 'athanor was disabled, the agent sudo rule and the local advertisement were removed.\n'
  printf '/home/athanor, /etc/athanor, the database, and backups were preserved.\n'
}

# ---------------------------------------------------------------------------
# The retirement warning, and who on this box it is about.
#
# `openrouter-catalog.ts` writes a provider's published withdrawal date onto every model it
# refreshes, and `model-policy.ts` keeps a model within `RETIREMENT_HORIZON_DAYS` of that date out
# of automatic selection. Both halves work. What had no reader was the warning itself: the
# `Retires <date>` tag is computed on every refresh, stored on the row, served on /v1/models and
# rendered by nothing anywhere in this repository, so a box routes around a dying model in silence
# and never says which one - or that the owner's own pin is the one thing that routing does not
# cover.
#
# It does not cover it by design. `rankModels` short-circuits on an explicit `requestedId` and
# never reaches `isRetiringSoon`: the health filter, like the price ceiling beside it, governs what
# athanor chooses for the owner and never what the owner chose for themselves. So the single case
# where this warning has somebody to reach is the single case nothing tells - a standing pin in
# Settings, or a schedule's `model_id`, on a route the provider is withdrawing. When the route
# finally goes, the fallback in `support.ts` quietly ranks instead, which is correct and is also
# the last moment anything could have said so.
#
# Reported by `doctor` because a headless box has nowhere else to hear it: it is a standing fact
# about the server rather than an event, which is what the notification service carries, and it is
# not about any one run, which is what `athanor task` answers. It sits beside the catalogue
# freshness check above because it is only true alongside it - a date read out of a catalogue that
# stopped refreshing in March is a date about March.
#
# HOW OFTEN THIS FIRES, which is the number that decides whether it is a warning or noise. Read
# off a running box's `model_releases` on 2026-09-02, refreshed that morning: 421 rows; 10 publish
# an expiry at all; 3 fall inside the 30-day horizon; 2 more expire 2026-12-31, and 5 carry
# 2098-12-31, which is a provider writing "no expiry" as a date. Exactly 3 rows carry a
# `Retires <date>` tag, and they are the same 3, because `openrouter-catalog.ts` writes that tag
# only inside the horizon. So this speaks about 0.71% of a catalogue - neither the every-model
# reading, which is a warning an owner learns to skip, nor the no-model reading, which is dead
# weight.
#
# Re-read it rather than trusting this sentence. Nothing in this checkout holds a catalogue, so the
# figures above cannot be re-derived from the tree and have to come off a box:
#
#   sudo runuser -u postgres -- psql -tAqc "SELECT COUNT(*), COUNT(*) FILTER (WHERE EXISTS (
#     SELECT 1 FROM jsonb_array_elements_text(recommendation_tags) t WHERE t LIKE 'Retires %'))
#     FROM model_releases" athanor
#
# That box, that morning, answered 421|3. It also held 1 pin and 0 enabled schedules, and the
# pinned model carries no expiry - so the arm below printed its note there and no warning at all.
# Nobody has yet watched it print a warning on a real box; that gap is real and is not closed by
# the harness, which fakes the database.

# The horizon read out of the policy that enforces it, the way `spend_ceiling_max` reads its bound
# out of the contract: a number kept in two places is a number that disagrees with itself the first
# time one of them moves.
model_retirement_horizon_days() {
  retirement_horizon=$(
    sed -n 's/^export const RETIREMENT_HORIZON_DAYS = \([0-9][0-9]*\);$/\1/p' \
      "$athanor_root/packages/core/src/model-policy.ts" 2>/dev/null | sed -n '1p'
  )
  [ -n "$retirement_horizon" ] || retirement_horizon=30
  printf '%s' "$retirement_horizon"
}

# How many of the two columns this server's schema carries, echoed rather than compared against 2
# here, and the empty string when the question could not be asked at all. Both columns are needed
# and neither is old: the expiry travels inside `model_releases.metadata`, and a schedule could not
# name a model before `task_schedules.model_id` existed. A report drawn from a release missing
# either would say "nothing is being withdrawn" when what is true is "half the question was never
# asked".
#
# This returned a boolean until it was measured, and the boolean collapsed three states an owner
# has to tell apart into one. A database that is down, a `runuser` or `psql` that is not on this
# box, and a schema that genuinely predates the columns all came back false, and the caller
# reported the third of them as a fact: "this release's database has no column for a withdrawal
# date" was printed on a probe box whose database answered nothing at all. Echoing the count is
# what lets the caller say which of the three it is. The rule is the one written over
# `model_retirement_counts` below, whose empty answer "must not be rendered as the reassuring one":
# a check that could not run reads as silence, not as health.
model_retirement_columns() {
  runuser -u postgres -- psql -tAqc \
    "SELECT COUNT(*) FROM information_schema.columns
     WHERE table_schema = 'public'
       AND ((table_name = 'model_releases' AND column_name = 'metadata')
            OR (table_name = 'task_schedules' AND column_name = 'model_id'))" \
    athanor 2>/dev/null | tr -d '[:space:]'
}

# How many models this catalogue holds, and how many of them the provider withdraws inside the
# horizon, as `total|expiring`.
#
# The expiry is compared as text rather than cast to a date, and that is the safe reading rather
# than the lazy one: it arrives from a provider feed as free JSON, an ISO day already sorts
# correctly as a string, and a malformed value is refused by the pattern instead of throwing out of
# a cast and taking this whole arm of `doctor` down with it. The pattern is also what stops a value
# like `soon` sorting below every real date and being reported as an imminent retirement.
model_retirement_counts() {
  runuser -u postgres -- psql -tAqc \
    "SELECT COUNT(*) || '|' || COUNT(*) FILTER (
       WHERE metadata->>'expiresAt' ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}'
         AND substring(metadata->>'expiresAt' FROM 1 FOR 10)
             <= to_char(CURRENT_DATE + INTERVAL '$(model_retirement_horizon_days) days','YYYY-MM-DD')
     )
     FROM model_releases" \
    athanor 2>/dev/null | tr -d '[:space:]'
}

# One line per thing on this box that names a model and has a problem with the model it names,
# as `kind|who|model id|withdrawal date or empty|display name or empty`.
#
# Two kinds, because there are two ways an unattended run comes to use a route nobody re-chose. A
# pin is `users.preferences.model`, and `automatic: false` is what makes it a pin - `modelId` on
# its own is not one, because the web app writes the currently recommended id into that field on
# every ranking it receives, so reading it whenever it is set would report a warning about whatever
# the picker happened to be showing when the owner last had the app open. A schedule is
# `task_schedules.model_id`, which is the same setting for a run that starts at three in the
# morning; disabled schedules are left out because they start nothing.
#
# Only the problems come back. A pin on a model that is present and not expiring is the ordinary
# case and has nothing to report, and a `doctor` that lists every account's model on every run is
# one nobody finishes reading.
model_retirement_dependencies() {
  runuser -u postgres -- psql -tAqc \
    "WITH horizon AS (
       SELECT to_char(CURRENT_DATE + INTERVAL '$(model_retirement_horizon_days) days','YYYY-MM-DD') AS edge
     ),
     depends AS (
       SELECT 'pin' AS kind, u.username AS who, u.preferences->'model'->>'modelId' AS model_id
         FROM users u
        WHERE u.preferences->'model'->>'automatic' = 'false'
          AND COALESCE(u.preferences->'model'->>'modelId', '') <> ''
       UNION ALL
       SELECT 'schedule', COALESCE(u.username, 'an account that is gone'), s.model_id
         FROM task_schedules s
         LEFT JOIN users u ON u.id = s.user_id
        WHERE s.enabled
          AND COALESCE(s.model_id, '') <> ''
     ),
     verdict AS (
       SELECT d.kind, d.who, d.model_id,
              COALESCE(
                CASE
                  WHEN m.metadata->>'expiresAt' ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}'
                   AND substring(m.metadata->>'expiresAt' FROM 1 FOR 10) <= h.edge
                  THEN substring(m.metadata->>'expiresAt' FROM 1 FOR 10)
                END, '') AS expires_on,
              COALESCE(m.display_name, '') AS display_name,
              (m.id IS NULL) AS missing
         FROM depends d
         CROSS JOIN horizon h
         LEFT JOIN model_releases m ON m.id = d.model_id
     )
     SELECT kind || '|' || who || '|' || model_id || '|' || expires_on || '|' || display_name
       FROM verdict
      WHERE missing OR expires_on <> ''
      ORDER BY kind, who, model_id" \
    athanor 2>/dev/null
}

# ---------------------------------------------------------------------------
# The pre-flight half of the spending brake.
#
# The caps in Settings are the running half: they watch what a task has already spent and halt it.
# They cannot stop the box picking a $75-per-million route in the first place, and the moment that
# matters is the one nobody is watching - "silently spending over a ceiling the owner set while they
# are asleep is the one outcome a ceiling exists to prevent", as `model-policy.ts` has said since
# the apparatus was written. It was written correct and never given a caller: as of this release no
# `ModelRequest` anywhere in the repository carries a ceiling, and there was no column, no contract
# field and no control to set one with.
#
# This is the control. It is a command rather than a screen because on a self-hosted box the owner
# is root on the host, and the price of the model their computer chooses is a host setting in the
# same sense the backup schedule is.
spend_ceiling_max() {
  # Read the bound out of the contract rather than restating it here. `doctor` reads the expected
  # schema version out of migrations.ts the same way, for the same reason: a number kept in two
  # places is a number that disagrees with itself the first time one of them moves.
  ceiling_max=$(
    sed -n 's/^export const MAX_PRICE_CEILING_USD_PER_MILLION = \([0-9][0-9]*\);$/\1/p' \
      "$athanor_root/packages/contracts/src/index.ts" 2>/dev/null | sed -n '1p'
  )
  [ -n "$ceiling_max" ] || ceiling_max=100
  printf '%s' "$ceiling_max"
}

# Whether this server's schema can hold a ceiling at all. It cannot yet, and a command that printed
# a confirmation over a database that stored nothing would be worse than no command.
# The count, echoed, and the empty string when there was no database to ask. `doctor` needs the
# three states apart - a schema that cannot hold a ceiling is a different report from a database
# that did not answer - and the two command arms below only need the yes-or-no, so the predicate
# stays and reads this. Kept in step with `model_retirement_columns` deliberately: these two guards
# sit four lines apart in `doctor` and one of them saying "I could not look" while the other says
# "your release cannot do this" under the identical failure is the disagreement worth avoiding.
spend_ceiling_columns() {
  runuser -u postgres -- psql -tAqc \
    "SELECT COUNT(*) FROM information_schema.columns
     WHERE table_schema = 'public' AND table_name = 'spend_limits'
       AND column_name IN ('max_input_usd_per_million_tokens',
                           'max_output_usd_per_million_tokens')" \
    athanor 2>/dev/null | tr -d '[:space:]'
}

spend_ceiling_storable() {
  [ "$(spend_ceiling_columns)" = 2 ]
}

# One rate, validated. Echoes the SQL literal - a bare number, or NULL for "no ceiling on this
# rate". Everything that reaches the statement below has passed through here, so the interpolation
# there is over a string this function proved is digits and at most one point.
spend_ceiling_rate() {
  case "$1" in
    none|off|unset) printf 'NULL'; return 0 ;;
  esac
  printf '%s' "$1" | grep -Eq '^[0-9]+(\.[0-9]+)?$' ||
    fail "a rate is dollars per million tokens, such as 2 or 0.75, or the word none - not '$1'"
  awk -v rate="$1" -v limit="$(spend_ceiling_max)" 'BEGIN { exit !(rate <= limit) }' ||
    fail "$1 per million tokens is above the largest ceiling this server accepts ($(spend_ceiling_max)); a per-task budget is Settings, not this"
  printf '%s' "$1"
}

# One line per account, because `spend_limits` is keyed by user and a box may hold more than the
# first owner. An account that has never opened the spend settings has no row at all, which reads
# as "none" here rather than as a missing account.
spend_ceiling_rows() {
  runuser -u postgres -- psql -tAqc \
    "SELECT u.username || '|' ||
            COALESCE(s.max_input_usd_per_million_tokens::text, 'none') || '|' ||
            COALESCE(s.max_output_usd_per_million_tokens::text, 'none')
     FROM users u LEFT JOIN spend_limits s ON s.user_id = u.id
     ORDER BY u.created_at, u.username" \
    athanor 2>/dev/null
}

# Nothing on stdout means no account was found - which `doctor` reads as its own answer rather
# than as an empty ceiling, because a database that answered with no rows at all is a different
# report from an owner who has set none.
spend_ceiling_print() {
  spend_ceiling_rows | while IFS='|' read -r ceiling_user ceiling_in ceiling_out; do
    [ -n "$ceiling_user" ] || continue
    # Said as four sentences rather than one with holes in it. A half-set ceiling is a real state -
    # an owner may cap what a route charges to read a transcript and not care what it charges to
    # write a reply - and "at most any price per million in" is not a sentence.
    case "$ceiling_in|$ceiling_out" in
      'none|none')
        printf '%s: no price ceiling. Any model in the catalogue may be chosen, at any price.\n' \
          "$ceiling_user"
        ;;
      'none|'*)
        printf '%s: no ceiling on input; at most $%s per million tokens out.\n' \
          "$ceiling_user" "$ceiling_out"
        ;;
      *'|none')
        printf '%s: at most $%s per million tokens in; no ceiling on output.\n' \
          "$ceiling_user" "$ceiling_in"
        ;;
      *)
        printf '%s: at most $%s per million tokens in and $%s per million tokens out.\n' \
          "$ceiling_user" "$ceiling_in" "$ceiling_out"
        ;;
    esac
  done
}

spend_ceiling_command() {
  need_root price-ceiling "$@"
  ceiling_action="${1:-show}"
  case "$ceiling_action" in
    show|'')
      if ! spend_ceiling_storable; then
        printf 'This server cannot store a model price ceiling: its database has no column for one.\n'
        printf 'Nothing limits the price of the model a task picks. Run sudo athanor update once a\n'
        printf 'release that adds it is published.\n'
        return 0
      fi
      spend_ceiling_print
      ;;
    set)
      shift
      [ "$#" -eq 2 ] ||
        fail "usage: athanor price-ceiling set INPUT OUTPUT - dollars per million tokens, or none"
      # `fail` exits, but inside a command substitution it exits the subshell and leaves the
      # caller holding an empty string - which would reach the statement below as a syntax error
      # rather than as a refusal. `set -e` would catch it; saying so is cheaper than relying on it.
      ceiling_input=$(spend_ceiling_rate "$1") || exit 1
      ceiling_output=$(spend_ceiling_rate "$2") || exit 1
      # Refused rather than reported. A command that validates an owner's ceiling, prints it back
      # and stores nothing is how a control comes to wear a brake's name while being wired to
      # nothing, which is the one thing this command exists not to be.
      spend_ceiling_storable || {
        printf 'garden: %s per million in and %s per million out is a valid ceiling, and this\n' \
          "$1" "$2" >&2
        printf 'server cannot store it: its database has no column for one. Nothing was changed.\n' >&2
        printf 'Run sudo athanor update once a release that adds it is published.\n' >&2
        exit 1
      }
      # `monthly_cap_usd` is written on the INSERT arm and deliberately not on the UPDATE arm.
      #
      # This command creates a `spend_limits` row for an owner who has never had one, and every
      # money cap in that row is NULL. `cappedMonthlyUsd` in billing.ts reads a stored row as the
      # owner's answer in full - an explicit NULL means "no ceiling, thank you" - and gives the
      # $100 default only where no row exists at all. So setting a price ceiling, a command about
      # dollars per million tokens, silently removed the only dollar ceiling on the box. The comment
      # on DEFAULT_MONTHLY_CAP_USD names this writer by name and says the fix belongs in a column
      # default; until one exists, the writer that caused it can decline to cause it.
      runuser -u postgres -- psql -v ON_ERROR_STOP=1 -q athanor <<SQL
INSERT INTO spend_limits (user_id, max_input_usd_per_million_tokens,
                          max_output_usd_per_million_tokens, monthly_cap_usd)
SELECT id, $ceiling_input, $ceiling_output, $(default_monthly_cap) FROM users
ON CONFLICT (user_id) DO UPDATE SET
  max_input_usd_per_million_tokens = EXCLUDED.max_input_usd_per_million_tokens,
  max_output_usd_per_million_tokens = EXCLUDED.max_output_usd_per_million_tokens,
  updated_at = NOW();
SQL
      spend_ceiling_print
      ;;
    clear)
      spend_ceiling_command set none none
      ;;
    *) fail "usage: athanor price-ceiling [show|set INPUT OUTPUT|clear]" ;;
  esac
}

# The default the running code applies to a box with no spend_limits row, read out of the file that
# decides it rather than restated here - the same rule `spend_ceiling_max` follows against the
# contract, and for the same reason: a number kept in two places is a number that disagrees with
# itself the first time one of them moves.
default_monthly_cap() {
  monthly_default=$(
    sed -n 's/^export const DEFAULT_MONTHLY_CAP_USD = \([0-9][0-9]*\);$/\1/p' \
      "$athanor_root/packages/data/src/store/billing.ts" 2>/dev/null | sed -n '1p'
  )
  # NULL rather than a guessed number when the constant cannot be read. Writing a dollar cap this
  # script invented would be worse than writing none: the owner would be stopped mid-task by a
  # figure nothing on the box can account for.
  [ -n "$monthly_default" ] || monthly_default=NULL
  printf '%s' "$monthly_default"
}

# The other half of the brake, and the half the owner probably meant.
#
# `spend-ceiling` was a price-per-million control wearing the name of a money cap. The money caps -
# daily and monthly dollars, the thing that actually halts a run - had no command at all: they were
# reachable only through Settings, which is a browser, which is the one thing an owner setting up a
# headless box over ssh does not have yet. So the command named for spending could not limit
# spending, and the control that could was not on this computer's command line.
#
# Deliberately not an installer prompt. The zero-prompt install is correct and stays: a question at
# install time is a question asked before the owner knows what a run of theirs costs, and answered
# by whoever is holding the terminal rather than by whoever is paying. `doctor` says once, every
# time it is run, that no cap is set. That is the right cadence for a decision the owner should make
# with their own numbers in front of them.
#
# Left as a predicate, unlike `spend_ceiling_columns` above. This one has no false-health case to
# split apart: its caller in `doctor` prints nothing at all when the answer is no, so a database
# that did not answer already reads as silence there rather than as a fact about the release. That
# it is silent about being unable to look is a smaller defect and a different one, and it is not
# this change.
spend_cap_storable() {
  [ "$(
    runuser -u postgres -- psql -tAqc \
      "SELECT COUNT(*) FROM information_schema.columns
       WHERE table_schema = 'public' AND table_name = 'spend_limits'
         AND column_name IN ('daily_cap_usd', 'monthly_cap_usd')" \
      athanor 2>/dev/null | tr -d '[:space:]'
  )" = 2 ]
}

# One amount, validated. Echoes the SQL literal - a bare number, or NULL for "no cap". Everything
# reaching the statement below has passed through here, so the interpolation there is over a string
# this function proved is digits and at most one point. No upper bound, unlike a price ceiling: this
# is the owner's own money and a cap refused for being large is a cap nobody sets.
spend_cap_amount() {
  case "$1" in
    none | off | unset)
      printf 'NULL'
      return 0
      ;;
  esac
  printf '%s' "$1" | grep -Eq '^[0-9]+(\.[0-9]+)?$' ||
    fail "a cap is an amount in dollars, such as 20 or 5.50, or the word none - not '$1'"
  printf '%s' "$1"
}

spend_cap_rows() {
  runuser -u postgres -- psql -tAqc \
    "SELECT u.username || '|' ||
            COALESCE(s.daily_cap_usd::text, 'none') || '|' ||
            COALESCE(s.monthly_cap_usd::text, 'none') || '|' ||
            (CASE WHEN s.user_id IS NULL THEN 'no-row' ELSE 'row' END)
     FROM users u LEFT JOIN spend_limits s ON s.user_id = u.id
     ORDER BY u.created_at, u.username" \
    athanor 2>/dev/null
}

# Said in the owner's terms, and the absent row said differently from an explicit none - because
# they mean different things to the code that reads them. No row is nobody having been asked, and
# the running build answers that with its own monthly default; an explicit none is the owner having
# answered, and it is answered for good.
spend_cap_print() {
  cap_default=$(default_monthly_cap)
  spend_cap_rows | while IFS='|' read -r cap_user cap_daily cap_monthly cap_row; do
    [ -n "$cap_user" ] || continue
    if [ "$cap_row" = no-row ] && [ "$cap_default" != NULL ]; then
      printf '%s: no cap set, so this release applies its own $%s a month. Nothing caps a single day.\n' \
        "$cap_user" "$cap_default"
      continue
    fi
    case "$cap_daily|$cap_monthly" in
      'none|none')
        printf '%s: no spending cap at all. Nothing halts a run for cost.\n' "$cap_user"
        ;;
      'none|'*) printf '%s: at most $%s a month; nothing caps a single day.\n' "$cap_user" "$cap_monthly" ;;
      *'|none') printf '%s: at most $%s a day; nothing caps a month.\n' "$cap_user" "$cap_daily" ;;
      *) printf '%s: at most $%s a day and $%s a month.\n' "$cap_user" "$cap_daily" "$cap_monthly" ;;
    esac
  done
}

spend_cap_command() {
  need_root spend-cap "$@"
  cap_action="${1:-show}"
  case "$cap_action" in
    show | '')
      spend_cap_storable || {
        printf 'This server cannot store a spending cap: its database has no column for one.\n'
        return 0
      }
      spend_cap_print
      ;;
    set)
      shift
      [ "$#" -eq 2 ] ||
        fail "usage: athanor spend-cap set DAILY MONTHLY - amounts in dollars, or none"
      # `fail` exits, but inside a command substitution it exits the subshell and leaves the caller
      # holding an empty string, which would reach the statement below as a syntax error rather than
      # as a refusal.
      cap_daily=$(spend_cap_amount "$1") || exit 1
      cap_monthly=$(spend_cap_amount "$2") || exit 1
      spend_cap_storable || {
        printf 'garden: this server has no column to store a spending cap. Nothing was changed.\n' >&2
        exit 1
      }
      runuser -u postgres -- psql -v ON_ERROR_STOP=1 -q athanor <<SQL
INSERT INTO spend_limits (user_id, daily_cap_usd, monthly_cap_usd)
SELECT id, $cap_daily, $cap_monthly FROM users
ON CONFLICT (user_id) DO UPDATE SET
  daily_cap_usd = EXCLUDED.daily_cap_usd,
  monthly_cap_usd = EXCLUDED.monthly_cap_usd,
  updated_at = NOW();
SQL
      spend_cap_print
      ;;
    clear) spend_cap_command set none none ;;
    *) fail "usage: athanor spend-cap [show|set DAILY MONTHLY|clear]" ;;
  esac
}

# --- driving work from a script -----------------------------------------------------------------
#
# `athanor task` is athanor's whole headless surface. It drives the same HTTP API a browser drives,
# with an API token in place of a passkey session, and not one route below is new: creating a task,
# reading it, listing what it stopped to ask and answering those questions have all been reachable
# with a bearer token today, on the scopes `requiredApiTokenScope` already assigns them. What did
# not exist was a caller that turns them into an exit code and one object of data, which is the part
# a script written by hand gets wrong.
#
# It adds nothing to what the model is sent. This is a command an operator types, not a tool the
# agent can see, so the catalogue is the same byte-for-byte with it and without it.
#
# Three promises, in the order they matter:
#   - the exit code says how the WORK ended, and a run whose task died never exits 0;
#   - the outcome is one JSON object on stdout on the contract in docs/HEADLESS.md, so nothing has
#     to grep a transcript for a string the way scripts/live-drill.mjs still does;
#   - a task that stopped to ask is reported as having stopped to ask. Nothing here answers an
#     approval on the owner's behalf. How much gets asked is the workspace's security mode and this
#     command cannot loosen it; `athanor task approvals` and `approve` are separate, deliberate acts
#     so that a run which answered its own questions is a run whose log says it did.
#
# No token is minted here and none can be. `POST /v1/api-tokens` wants a passkey ceremony from
# inside the step-up window, and no scope in `requiredApiTokenScope` reaches that route at all, so a
# token cannot mint a second one. docs/HEADLESS.md says what an operator does instead, and why that
# refusal is kept rather than fixed.

# What an exit code means. A wrapper that reports success while the work died is the defect this
# subcommand exists to make impossible, so every way a run can end has a number of its own. `run`,
# `wait`, `show` and `cancel` answer with these; `approvals`, `approve` and `deny` describe a
# request about work that is still going, so they answer 0 or 1 and print what happened.
task_exit_ok=0
task_exit_failed=2
task_exit_asked=3
task_exit_timeout=4
task_exit_cancelled=5
task_exit_blocked=6
task_exit_running=7

# How long one HTTP call may take. Generous, because creating a task waits on a model catalogue
# read and a workspace check, and because a slow answer is not a lost one.
task_http_seconds="${ATHANOR_TASK_HTTP_SECONDS:-30}"
# How often the wait asks. Two seconds rather than the half-second `scripts/live-drill.mjs` uses,
# because that one polls in-process and this one crosses a socket: at half a second a twenty-minute
# job costs 2,400 requests to watch a status field that changes a handful of times. Two seconds
# costs 600 and delays the answer by at most two seconds.
task_poll_seconds="${ATHANOR_TASK_POLL_SECONDS:-2}"
# The default wait. Half an hour was chosen rather than measured - nothing in this repository
# records how long an ordinary job takes - so it is a number picked to be wrong in the cheap
# direction. Running out is exit 4 and the task carries on running and spending; it is not a kill.
# The cost of this being too short is a caller that has to run `wait` again, not work thrown away.
task_default_wait_seconds="${ATHANOR_TASK_TIMEOUT:-1800}"

task_scratch=''

task_cleanup() {
  if [ -n "$task_scratch" ]; then
    rm -rf -- "$task_scratch"
  fi
  task_scratch=''
}

# Everything the calls below share: the tools, the address, the token, and a private directory to
# put bodies in.
task_setup() {
  command -v curl >/dev/null 2>&1 || fail "athanor task needs curl"
  command -v jq >/dev/null 2>&1 || fail "athanor task needs jq"
  task_api="${ATHANOR_API:-http://127.0.0.1:4100}"
  task_token="${ATHANOR_TOKEN:-}"
  # Where a token lives on the box itself, beside the runner's shared secret and owned the same way.
  # An operator puts one there once and it is never in a shell history, an environment or a process
  # list; `sudo athanor task ...` is then the ordinary invocation on the server. ATHANOR_TOKEN is
  # for a caller on another machine, where there is no /etc/athanor to read.
  task_token_file="${ATHANOR_TOKEN_FILE:-$athanor_config/api-token}"
  if [ -z "$task_token" ] && [ -r "$task_token_file" ]; then
    task_token=$(cat "$task_token_file")
  fi
  [ -n "$task_token" ] ||
    fail "no API token. Mint one in Settings, then either put it in $task_token_file or export ATHANOR_TOKEN"
  # The server's own pattern, checked here rather than at the far end, for two reasons: a typo
  # should not cost a round trip and an authentication failure the operator has to interpret, and
  # a value that matches this cannot contain a quote or a backslash - which is what makes it safe
  # to write into the curl configuration file below without escaping anything.
  task_token_body="${task_token#oc_live_}"
  case "$task_token" in
    oc_live_*) ;;
    *) fail "that is not an athanor API token: they begin oc_live_" ;;
  esac
  case "$task_token_body" in
    *[!A-Za-z0-9_-]*) fail "that API token has characters an athanor token cannot contain" ;;
  esac
  if [ "${#task_token_body}" -lt 40 ] || [ "${#task_token_body}" -gt 80 ]; then
    fail "that API token is the wrong length for an athanor token"
  fi
  task_scratch=$(mktemp -d) || fail "could not create a working directory"
  trap task_cleanup EXIT INT TERM
  task_config="$task_scratch/curl.conf"
  task_body="$task_scratch/body.json"
  task_record="$task_scratch/task.json"
  task_trail="$task_scratch/events.json"
  task_pending="$task_scratch/approvals.json"
  task_payload="$task_scratch/payload.json"
  printf 'header = "Authorization: Bearer %s"\n' "$task_token" >"$task_config"
  # Read by the outcome builder whether or not the call that fills them was made or answered, so
  # `null` is what an unmade call leaves behind rather than a parse error.
  for task_file in "$task_record" "$task_trail" "$task_pending"; do
    printf 'null\n' >"$task_file"
  done
  task_outcome=''
  task_result_code="$task_exit_ok"
  task_waited=0
  task_transcript="unavailable"
}

# One request. The body lands in $task_body and the HTTP status in $task_code.
#
# The token goes in a curl configuration file rather than on the command line because the wait loop
# runs a curl every couple of seconds for as long as the work lasts, and an argument list is
# readable out of /proc by anything else on the box for as long as the process is alive.
#
# A third argument means "this is a write": it carries the Idempotency-Key, which every write on
# this API requires, and $task_payload is sent as the body.
task_call() {
  if [ "$#" -ge 3 ]; then
    task_code=$(
      curl --silent --show-error --config "$task_config" --max-time "$task_http_seconds" \
        --request "$1" --output "$task_body" --write-out '%{http_code}' \
        --header 'Content-Type: application/json' --header "Idempotency-Key: $3" \
        --data-binary "@$task_payload" "$task_api$2"
    ) || task_code=000
  else
    task_code=$(
      curl --silent --show-error --config "$task_config" --max-time "$task_http_seconds" \
        --request "$1" --output "$task_body" --write-out '%{http_code}' \
        "$task_api$2"
    ) || task_code=000
  fi
}

# Stop on anything but success, saying what the server said rather than a status number on its own.
# $1 is what was being attempted, $2 the scope the token needed for it - the refusal an operator
# actually hits is a token minted without the scope this call wanted, and a 403 that does not name
# it leaves them guessing between four possibilities.
task_expect() {
  case "$task_code" in
    2??) return 0 ;;
    000)
      fail "$task_api did not answer while $1. Is athanor running, and is ATHANOR_API right?"
      ;;
    401 | 403)
      fail "the API token was refused while $1 (HTTP $task_code). It needs the $2 scope and must not have expired"
      ;;
  esac
  task_message=$(jq -r '.error.message // empty' "$task_body" 2>/dev/null || true)
  task_reason=$(jq -r '.error.code // empty' "$task_body" 2>/dev/null || true)
  fail "$1 failed: HTTP $task_code ${task_reason:-unknown} ${task_message:-}"
}

# The task record and the tail of its transcript, rendered as the one object this command promises.
#
# The answer is read out of the `completed` event's payload rather than searched for in prose. That
# payload has carried the model's own account of the turn, the completion contract's verification
# and whatever it left open since the finish gate existed; nothing exposed it, so every caller so
# far has filtered the event list by hand and then grepped the JSON for a string. A failure's reason
# comes from the last event the worker addressed to the owner the same way.
#
# Which event that is took two corrections, both of them measured against the worker rather than
# assumed. Reading "the last `error` event" was wrong in both directions at once:
#
#   - too narrow. `agent.ts` writes the sentence that ends a run as kind `warning`, not `error`,
#     whenever the code contains "provider" (agent.ts:2157), and only three provider codes park the
#     task instead of failing it (PARKABLE_PROVIDER_WALLS, agent.ts:144). So a run that died of
#     `provider_stream_unparsed` or `provider_request_failed` came back as exit 2 with `reason` and
#     `reasonCode` null - no reason at all for the commonest class of failure there is.
#   - too wide. `tool-recording.ts:170` writes an `error` event for every tool call that throws,
#     mid-run. A task that recovered and finished came back `completed`, with an answer, and with
#     `reason: "shell failed"` beside it. A caller treating a non-null reason as "something went
#     wrong" would have scored that run as broken.
#
# So: only on an ending that has a reason, and only an event the worker marked `owner: true`, which
# is what its two terminal writes set and what a tool failure does not. The fallback to any `error`
# event is there for a transcript written before that flag existed.
task_emit() {
  jq -n \
    --arg outcome "$task_outcome" \
    --arg transcript "$task_transcript" \
    --argjson exitCode "$task_result_code" \
    --argjson waitedSeconds "$task_waited" \
    --slurpfile task "$task_record" \
    --slurpfile trail "$task_trail" \
    --slurpfile pending "$task_pending" \
    '
      ($task[0] // {}) as $t
      | (($trail[0].events // [])) as $events
      | ($events | map(select(.kind == "completed")) | last) as $done
      | (($pending[0] // []) | map({ id, taskId, action, preview })) as $approvals
      | ($events | map(select(.kind == "question_asked")) | last) as $asked
      | (if ($outcome == "failed" or $outcome == "blocked")
         then (((($events
                  | map(select(((.kind == "error") or (.kind == "warning"))
                               and ((.payload.owner // false) == true))))
                 # A spend pause parks the task with a `status` carrying `blockedBy`, not an error -
                 # so `blocked` came back with `reason: null` while the timeline held the sentence
                 # "Paused at $0.0015 of the $0.01 limit for this task. Raise the limit to carry on."
                 # The one channel a headless caller has said only "blocked".
                 + ($events
                    | map(select(.kind == "status" and ((.payload.blockedBy // "") != "")))))
                # The latest of those by sequence, not the owner-marked one first. A provider wall
                # the task was resumed past is still the last owner-marked warning on the timeline,
                # and read first it was reported as the reason a ceiling had parked the task, with
                # the ceiling itself invisible.
                | sort_by(.sequence)
                | last)
               // ($events | map(select(.kind == "error")) | last))
         else null end) as $bad
      # Which ceiling a spend pause names: "task", "daily" or "monthly". The worker writes one other
      # word in the same field - `spend_guard_unavailable`, when the guard could not answer at all -
      # and that is not a ceiling: nothing was crossed, and raising a limit changes nothing. So it
      # is a reason code and not a ceiling, and only the three ceilings are `blockedBy`.
      | ($bad.payload.blockedBy // "") as $stoppedBy
      | ($stoppedBy == "task" or $stoppedBy == "daily" or $stoppedBy == "monthly") as $byCeiling
      | {
          contract: "athanor.task.outcome/1",
          outcome: $outcome,
          exitCode: $exitCode,
          taskId: ($t.id // null),
          workspaceId: ($t.workspaceId // null),
          status: ($t.status // null),
          securityMode: ($t.securityMode // null),
          modelId: ($t.modelId // null),
          spentUsd: ($t.spentUsd // null),
          computeCredits: {
            used: ($t.actualComputeCredits // null),
            max: ($t.maxComputeCredits // null)
          },
          waitedSeconds: $waitedSeconds,
          transcript: $transcript,
          answer: ($done.payload.summary // $done.summary // null),
          verification: ($done.payload.verification // null),
          outstanding: ($done.payload.outstanding // []),
          reason: ($bad.summary // null),
          # The `status` event a spend ceiling writes carries `blockedBy` and no `code`, so the
          # commonest blocked ending there is came back with `reason` filled and `reasonCode` null -
          # the machine-readable half missing on exactly the ending a script branches on. The
          # worker never names this one, so the name is given here, and only when nothing else is.
          reasonCode: ($bad.payload.code
                       // (if $byCeiling then "spend_ceiling"
                           elif $stoppedBy != "" then $stoppedBy
                           else null end)),
          # Which ceiling stopped it - "task", "daily" or "monthly" - rather than a code invented
          # here for the occasion. Null for every stop that is not a spend ceiling.
          blockedBy: (if $byCeiling then $stoppedBy else null end),
          pendingApprovals: $approvals,
          # A question is what the task is waiting on, so it is reported on the awaiting outcome
          # and nowhere else. "Was a question ever asked" is true of every finished conversation
          # that asked one, and reporting it beside `completed` invited a second answer to a task
          # that has stopped listening.
          question: (if $outcome != "awaiting_approval" or ($approvals | length) > 0 or $asked == null
                     then null else {
              question: ($asked.payload.question // $asked.summary // null),
              why: ($asked.payload.why // null),
              options: ($asked.payload.options // [])
            } end),
          lastEventSequence: ($events | last | .sequence)
        }
    '
}

# Ask until the work stops, or until the deadline. $2 and $3 are what to call it when the deadline
# arrives first, because that is the one thing `run` and `show` disagree about: for a run it is a
# wait that ran out, for a look at a task it is a task that is still going.
#
# `paused` and `awaiting_resource` both end the wait. The second one reads like it will clear on its
# own and does not: it is where a provider wall, a disconnected provider or an unreachable model
# parks a task, and nothing picks it up again without a resume. Waiting on it is waiting forever.
task_wait_for() {
  task_id="$1"
  task_started=$(date +%s)
  task_deadline=$((task_started + task_wait_seconds))
  while :; do
    task_call GET "/v1/tasks/$task_id"
    task_expect "reading the task" "tasks:read"
    cp "$task_body" "$task_record"
    task_waited=$(($(date +%s) - task_started))
    case "$(jq -r '.status // "unknown"' "$task_record")" in
      completed)
        task_outcome=completed
        task_result_code="$task_exit_ok"
        return 0
        ;;
      failed)
        task_outcome=failed
        task_result_code="$task_exit_failed"
        return 0
        ;;
      cancelled)
        task_outcome=cancelled
        task_result_code="$task_exit_cancelled"
        return 0
        ;;
      awaiting_user)
        task_outcome=awaiting_approval
        task_result_code="$task_exit_asked"
        return 0
        ;;
      paused | awaiting_resource)
        task_outcome=blocked
        task_result_code="$task_exit_blocked"
        return 0
        ;;
    esac
    if [ "$(date +%s)" -ge "$task_deadline" ]; then
      task_outcome="$2"
      task_result_code="$3"
      return 0
    fi
    sleep "$task_poll_seconds"
  done
}

# The tail of the transcript, and - only when the task stopped to ask - what it stopped to ask.
# Fifty is the newest window the events route pages; a turn's ending is at the end of it by
# construction, and a task that has not ended yet has no ending to find.
task_collect() {
  task_call GET "/v1/tasks/$1/events?page=1&limit=50"
  if [ "$task_code" = 200 ]; then
    cp "$task_body" "$task_trail"
    task_transcript="read"
  else
    # Said out loud rather than left to be inferred. Without this an `answer` of null on a completed
    # task means either "the turn wrote nothing" or "the transcript could not be read", and a caller
    # scoring on the answer cannot tell those apart - which is the same shape of quiet wrong the
    # exit codes above exist to prevent.
    task_transcript="unavailable"
  fi
  if [ "$task_outcome" = awaiting_approval ]; then
    task_call GET "/v1/approvals?status=pending"
    if [ "$task_code" = 200 ]; then
      cp "$task_body" "$task_pending"
    fi
  fi
  # Guarded, because jq's own failure exit is 5 and 5 is this contract's word for "cancelled". A
  # 200 carrying something that is not JSON - a proxy's courtesy page is the way that happens - made
  # the whole command exit 5 under `set -e`, so a caller reading only the status saw a task the
  # owner had stopped. It could not do its job, which is 1.
  task_emit ||
    fail "the server answered $task_api but not with JSON this could read, so there is no outcome"
  exit "$task_result_code"
}

task_run() {
  task_workspace=''
  task_prompt=''
  task_prompt_file=''
  task_model=''
  task_privacy='provider_zdr'
  task_credits=''
  task_spend=''
  task_wait_seconds="$task_default_wait_seconds"
  task_key=''
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --workspace)
        [ "$#" -ge 2 ] || fail "athanor task run --workspace needs a workspace id"
        task_workspace="$2"
        shift 2
        ;;
      --prompt)
        [ "$#" -ge 2 ] || fail "athanor task run --prompt needs the words to send"
        task_prompt="$2"
        shift 2
        ;;
      --prompt-file)
        [ "$#" -ge 2 ] || fail "athanor task run --prompt-file needs a path, or - for standard input"
        task_prompt_file="$2"
        shift 2
        ;;
      --model)
        [ "$#" -ge 2 ] || fail "athanor task run --model needs a model id"
        task_model="$2"
        shift 2
        ;;
      --privacy-route)
        [ "$#" -ge 2 ] || fail "athanor task run --privacy-route needs a route"
        task_privacy="$2"
        shift 2
        ;;
      --credits)
        [ "$#" -ge 2 ] || fail "athanor task run --credits needs a number"
        task_credits="$2"
        shift 2
        ;;
      --spend-usd)
        [ "$#" -ge 2 ] || fail "athanor task run --spend-usd needs a number"
        task_spend="$2"
        shift 2
        ;;
      --timeout)
        [ "$#" -ge 2 ] || fail "athanor task run --timeout needs a number of seconds"
        task_wait_seconds="$2"
        shift 2
        ;;
      --key)
        [ "$#" -ge 2 ] || fail "athanor task run --key needs an idempotency key"
        task_key="$2"
        shift 2
        ;;
      *) fail "athanor task run: unknown option $1" ;;
    esac
  done
  if [ -n "$task_prompt_file" ]; then
    if [ "$task_prompt_file" = "-" ]; then
      task_prompt=$(cat)
    else
      [ -r "$task_prompt_file" ] || fail "cannot read $task_prompt_file"
      task_prompt=$(cat "$task_prompt_file")
    fi
  fi
  [ -n "$task_workspace" ] || fail "athanor task run needs --workspace ID"
  [ -n "$task_prompt" ] || fail "athanor task run needs --prompt TEXT or --prompt-file PATH"
  case "$task_wait_seconds" in
    '' | *[!0-9]*) fail "athanor task run --timeout takes whole seconds" ;;
  esac
  # There is deliberately no --security-mode here. What a run stops to ask is the workspace's
  # setting, and a flag on the command that started the work could quietly answer questions the
  # owner asked to be shown. The mode is reported in every outcome instead, so a result always
  # carries the terms it was produced under. docs/HEADLESS.md gives the one call that changes it.
  jq -n \
    --arg workspaceId "$task_workspace" \
    --arg prompt "$task_prompt" \
    --arg modelId "$task_model" \
    --arg privacyRoute "$task_privacy" \
    --arg credits "$task_credits" \
    --arg spend "$task_spend" \
    '{ workspaceId: $workspaceId, prompt: $prompt, privacyRoute: $privacyRoute }
      + (if $modelId == "" then {} else { modelId: $modelId } end)
      + (if $credits == "" then {} else { maxComputeCredits: ($credits | tonumber) } end)
      + (if $spend == "" then {} else { maxSpendUsd: ($spend | tonumber) } end)' \
    >"$task_payload" ||
    fail "could not build the request - are --credits and --spend-usd numbers?"
  # A generated key is unique per invocation, so a retry of the whole command starts a second task
  # rather than replaying the first. A caller that wants a retry to be free rather than doubled
  # passes --key and keeps it across attempts; that is what the header is for and it is the only
  # protection against paying twice for one job.
  if [ -z "$task_key" ]; then
    task_key="athanor-task-$(date +%s)-$(od -An -N8 -tx1 /dev/urandom | tr -d ' \n')"
  fi
  task_call POST "/v1/tasks" "$task_key"
  task_expect "starting the task" "tasks:write"
  task_started_id=$(jq -r '.id // empty' "$task_body")
  [ -n "$task_started_id" ] || fail "the server accepted the task but returned no id"
  task_wait_for "$task_started_id" timed_out "$task_exit_timeout"
  task_collect "$task_started_id"
}

task_wait() {
  task_wait_seconds="$task_default_wait_seconds"
  task_target=''
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --timeout)
        [ "$#" -ge 2 ] || fail "athanor task wait --timeout needs a number of seconds"
        task_wait_seconds="$2"
        shift 2
        ;;
      -*) fail "athanor task wait: unknown option $1" ;;
      *)
        task_target="$1"
        shift
        ;;
    esac
  done
  [ -n "$task_target" ] || fail "athanor task wait needs a task id"
  case "$task_wait_seconds" in
    '' | *[!0-9]*) fail "athanor task wait --timeout takes whole seconds" ;;
  esac
  task_wait_for "$task_target" timed_out "$task_exit_timeout"
  task_collect "$task_target"
}

task_show() {
  [ "$#" -ge 1 ] || fail "athanor task show needs a task id"
  task_wait_seconds=0
  task_wait_for "$1" running "$task_exit_running"
  task_collect "$1"
}

task_cancel() {
  [ "$#" -ge 1 ] || fail "athanor task cancel needs a task id"
  printf '{}\n' >"$task_payload"
  task_call POST "/v1/tasks/$1/cancel" "athanor-cancel-$1"
  task_expect "cancelling the task" "tasks:write"
  cp "$task_body" "$task_record"
  # The number describes the work, not the request: a script that cancels a run and then logs a
  # zero has recorded the same thing a run that finished would have recorded.
  task_outcome=cancelled
  task_result_code="$task_exit_cancelled"
  task_collect "$1"
}

task_approvals() {
  task_call GET "/v1/approvals?status=pending"
  task_expect "listing approvals" "approvals:read"
  # Guarded for the same reason `task_collect` guards its own: jq exits 5 on a body it cannot read,
  # and letting that out of here would answer with a number this command has never promised.
  if [ "$#" -ge 1 ]; then
    jq --arg taskId "$1" '[ .[] | select((.taskId | tostring) == $taskId) ]' "$task_body" ||
      fail "the approvals list came back as something this could not read"
  else
    jq '.' "$task_body" || fail "the approvals list came back as something this could not read"
  fi
  exit "$task_exit_ok"
}

task_decide() {
  [ "$#" -ge 2 ] || fail "athanor task $1 needs an approval id"
  printf '{}\n' >"$task_payload"
  # The key names the decision as well as the approval, so answering yes and then no is two
  # operations rather than a replay of the first one.
  task_call POST "/v1/approvals/$2/$1" "athanor-$1-$2"
  task_expect "answering the approval" "approvals:write"
  jq -n --arg approvalId "$2" --arg decision "$1" \
    '{ contract: "athanor.approval.decision/1", approvalId: $approvalId, decision: $decision }'
  exit "$task_exit_ok"
}

# Answering the other kind of stop.
#
# `awaiting_user` is two situations wearing one status: a card the owner has to decide, and a
# question the agent stopped to ask. Only the first had a verb, so a headless run that was asked
# anything parked for ever - `approvals` returned an empty list, `wait` returned the same empty
# list, and there was no command anywhere that could reply. The answer is an ordinary next message
# on the conversation, which is exactly what the agent is told to expect, so this is `run`'s own
# payload with only the words in it.
task_answer() {
  [ "$#" -ge 1 ] || fail "athanor task answer needs a task id"
  task_answer_id="$1"
  shift
  task_answer_text=''
  task_answer_file=''
  task_key=''
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --text)
        [ "$#" -ge 2 ] || fail "athanor task answer --text needs the words to send"
        task_answer_text="$2"
        shift 2
        ;;
      --text-file)
        [ "$#" -ge 2 ] || fail "athanor task answer --text-file needs a path, or - for standard input"
        task_answer_file="$2"
        shift 2
        ;;
      --key)
        [ "$#" -ge 2 ] || fail "athanor task answer --key needs an idempotency key"
        task_key="$2"
        shift 2
        ;;
      *) fail "athanor task answer: unknown option: $1" ;;
    esac
  done
  if [ -n "$task_answer_file" ]; then
    if [ "$task_answer_file" = "-" ]; then
      task_answer_text=$(cat)
    else
      [ -r "$task_answer_file" ] || fail "cannot read $task_answer_file"
      task_answer_text=$(cat "$task_answer_file")
    fi
  fi
  [ -n "$task_answer_text" ] ||
    fail "athanor task answer needs --text TEXT or --text-file PATH"
  jq -n --arg prompt "$task_answer_text" '{ prompt: $prompt }' >"$task_payload"
  # Without a key of the caller's own, the words are the key: sending the same answer twice is the
  # same act, and a retried curl after a timeout must not become a second message in the
  # conversation. A caller that means to say the same thing twice passes --key.
  [ -n "$task_key" ] ||
    task_key="athanor-answer-$task_answer_id-$(printf '%s' "$task_answer_text" | cksum | tr -d ' ')"
  task_call POST "/v1/tasks/$task_answer_id/messages" "$task_key"
  task_expect "answering the question" "tasks:write"
  jq -n --arg taskId "$task_answer_id" \
    '{ contract: "athanor.task.answer/1", taskId: $taskId, sent: true }'
  exit "$task_exit_ok"
}

task_usage() {
  printf '%s\n' \
    'Usage: garden task {run|wait|show|cancel|approvals|approve|deny|answer}' \
    '' \
    '  run --workspace ID (--prompt TEXT | --prompt-file PATH)' \
    '      [--model ID] [--privacy-route ROUTE] [--credits N] [--spend-usd N]' \
    '      [--timeout SECONDS] [--key IDEMPOTENCY-KEY]' \
    '  wait TASK_ID [--timeout SECONDS]' \
    '  show TASK_ID' \
    '  cancel TASK_ID' \
    '  approvals [TASK_ID]' \
    '  approve APPROVAL_ID' \
    '  deny APPROVAL_ID' \
    '  answer TASK_ID (--text TEXT | --text-file PATH) [--key IDEMPOTENCY-KEY]' \
    '' \
    'The outcome is JSON on standard output. The exit code is 0 completed, 2 failed,' \
    '3 stopped to ask, 4 the wait ran out, 5 cancelled, 6 stopped and needing a resume,' \
    '7 still running. See docs/HEADLESS.md.'
}

# How often the agent actually reaches for each tool, per turn, over a window of this box's work.
#
# WHY AN OWNER WOULD RUN THIS. The catalogue of tool schemas sent to the model on every request is
# the largest fixed cost of a turn, and the largest saving anyone has priced against it - moving the
# cold, fat two thirds behind an on-demand open - is held back on one number nobody has from a real
# box: how often a deferred tool would actually have to be opened. The working is in
# docs/design/organs/PREAMBLE.md; its frequencies come from 83 hand-written eval turns in which the
# model is a script. This reads the box's own turns instead. A week of ordinary use is what it wants.
#
# It reports the share of TURNS that reached each tool at least once - never the number of calls,
# because a tool called five times inside one turn is opened once - and it refuses to report any
# share at all below the sample it names, which is 33 turns. That floor is not caution: it is where
# the rule of three the design document quotes first puts a never-called tool under the 9.2%
# threshold, so below it there is nothing to print that the decision could be made from. The exact
# binomial bound the report actually carries is one turn tighter, and MIN_TURNS_TO_ANSWER in
# apps/api/src/routes/usage.ts says why the looser number is the one held to.
#
# Read-only, and it costs nothing to run: no provider is called and nothing is billed.
tool_opens() {
  task_setup
  # Both arguments are optional and the usage line says so, so neither may depend on the other being
  # there: reading the day count off $1 made `athanor tool-opens --json` - the shortest form the
  # usage line offers - refuse with "takes a whole number of days", which names the wrong argument
  # and is the kind of error message that sends an operator to read this script.
  tool_opens_days=''
  tool_opens_json=''
  for tool_opens_arg in "$@"; do
    case "$tool_opens_arg" in
      --json) tool_opens_json=1 ;;
      '' | *[!0-9]*) fail "athanor tool-opens takes a whole number of days and an optional --json" ;;
      *) tool_opens_days="$tool_opens_arg" ;;
    esac
  done
  [ -n "$tool_opens_days" ] || tool_opens_days=7
  task_call GET "/v1/usage/tool-opens?days=$tool_opens_days"
  task_expect "reading the tool open rate" "usage:read"
  if [ -n "$tool_opens_json" ]; then
    jq '.' "$task_body" || fail "the answer came back as something this could not read"
    exit "$task_exit_ok"
  fi
  jq -r '
    "Window:        " + (.window.start | .[0:10]) + " to " + (.window.end | .[0:10])
      + " (" + (.window.days | tostring) + " days)",
    "Turns:         " + (.turns | tostring) + "  over " + (.tasksScanned | tostring)
      + " conversations",
    (if .unreadableCalls > 0 then
       "Unreadable:    " + (.unreadableCalls | tostring)
         + " tool calls this key could not open; their turns still count"
     else empty end),
    (if .windowTruncated then
       "NOTE:          more conversations in this window than one read walks; the oldest were cut"
     else empty end),
    (if (.truncatedTasks | length) > 0 then
       "NOTE:          cut off part-way through " + (.truncatedTasks | length | tostring)
         + " conversation(s): " + (.truncatedTasks | join(", "))
     else empty end),
    "",
    (if .decidable then
       ("Share of turns that reached each tool at least once. The 95% column is the upper bound:",
        "a tool is only worth deferring if that column, not the share, stays under the threshold.",
        "Any tool absent from this list was reached in no turn at all, upper bound "
          + ((.unseenToolUpper95 * 1000 | round / 10) | tostring) + "%.",
        "",
        "  tool                        turns     share    95% upper",
        (.tools[] |
          "  " + (.tool + "                            ")[0:26]
            + (("     " + (.turns | tostring))[-6:])
            + (("        " + ((.shareOfTurns * 1000 | round / 10) | tostring) + "%")[-10:])
            + (("        " + ((.upper95 * 1000 | round / 10) | tostring) + "%")[-11:])))
     else
       ("This box has " + (.turns | tostring) + " turns in that window and this refuses to divide by",
        "fewer than " + (.minimumTurns | tostring) + ". At " + (.minimumTurns | tostring)
          + " turns a tool nobody called once has a 95% upper bound just under the",
        "9.2% threshold the deferral decision uses, so below that this prints no share at all.",
        "Keep using the box, or ask for a longer window:",
        "  athanor tool-opens 30")
     end)
  ' "$task_body" || fail "the answer came back as something this could not read"
  exit "$task_exit_ok"
}

# Speak Agent Client Protocol on stdin and stdout, so somebody else's editor can drive this box.
#
# Not a server and not a daemon: an ACP client SPAWNS this, talks JSON-RPC down the pipe, and the
# process ends when the pipe closes. So there is nothing to start, nothing listening, and nothing
# the model can see - the same standing `task` has, for the same reason.
#
# The work is in scripts/acp/athanor-acp.mjs, which is Node with no dependencies. This arm is here
# rather than the logic itself because the protocol needs a request table and two-way correlation,
# and neither is a thing to write in shell. docs/ACP.md is the page.
acp_command() {
  command -v node >/dev/null 2>&1 ||
    fail "athanor acp needs node. The API already runs on it, so this box should have it"
  # Beside this script when run from a checkout, then under the installed root. No install step of
  # its own: /opt/athanor is the checkout `athanor update` pulls into, so the file is already there.
  acp_self_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
  for acp_candidate in "$acp_self_dir/acp/athanor-acp.mjs" "$athanor_root/scripts/acp/athanor-acp.mjs"; do
    if [ -r "$acp_candidate" ]; then
      exec node "$acp_candidate" "$@"
    fi
  done
  fail "cannot find scripts/acp/athanor-acp.mjs beside $acp_self_dir or under $athanor_root"
}

task_command() {
  task_action="${1:-}"
  if [ "$#" -gt 0 ]; then shift; fi
  case "$task_action" in
    run | wait | show | cancel | approvals | approve | deny | answer) task_setup ;;
    help | '')
      task_usage
      exit 0
      ;;
    *)
      printf 'athanor task: unknown command: %s\n' "$task_action" >&2
      task_usage >&2
      exit 64
      ;;
  esac
  case "$task_action" in
    run) task_run "$@" ;;
    wait) task_wait "$@" ;;
    show) task_show "$@" ;;
    cancel) task_cancel "$@" ;;
    approvals) task_approvals "$@" ;;
    approve) task_decide approve "$@" ;;
    deny) task_decide deny "$@" ;;
    answer) task_answer "$@" ;;
  esac
}

usage() {
  printf '%s\n' \
    'Usage: garden {install|start|stop|restart|status|logs [api|worker|runner|registry|notifications|nginx]|doctor|connect|pairing-code|set-hostname HOST|price-ceiling [show|set INPUT OUTPUT|clear]|spend-cap [show|set DAILY MONTHLY|clear]|backup [dir]|backup auto on|off|status|backup destination [show|PATH --recipient FILE|off]|restore DIR --yes [--keep-stopped | --new-host [--hostname NAME]]|update|rollback [dir]|auto-update on|off|status|relay status|on|off|uninstall|certificate ...|ddns ...|task ...|tool-opens [DAYS] [--json]|acp --workspace ID [--approvals park|relay]}' \
    '' \
    'Browser sign-in needs a hostname: a passkey is bound to a domain name and the WebAuthn' \
    'standard does not allow an IP address. If this server has no name, run:' \
    '  sudo athanor ddns configure'
}

command_name="${1:-help}"
if [ "$#" -gt 0 ]; then shift; fi

case "$command_name" in
  install)
    need_root install
    exec /bin/sh "$athanor_root/scripts/install-native.sh"
    ;;
  start) start_athanor ;;
  stop) stop_athanor ;;
  restart) restart_athanor ;;
  status) status_athanor ;;
  logs) logs_athanor "${1:-}" ;;
  doctor) doctor ;;
  connect)
    need_root connect
    connection_details
    ;;
  pairing-code) pairing_code ;;
  price-ceiling) spend_ceiling_command "$@" ;;
  # The name this was shipped under, kept answering rather than removed. It set a price per million
  # tokens while wearing the name of a money cap, which is the confusion the rename exists to end -
  # but an owner with the old name in a note or a shell history should be told what it is called
  # now, not told there is no such command. Two lines, and it also disambiguates: there is now a
  # real spend cap, and somebody typing the old name may want either.
  spend-ceiling)
    printf 'garden: "spend-ceiling" set a price per million tokens, and is now called
' >&2
    printf '  sudo athanor price-ceiling %s
' "$*" >&2
    printf 'To cap what a day or a month may cost in dollars, use sudo athanor spend-cap.
' >&2
    spend_ceiling_command "$@"
    ;;
  spend-cap) spend_cap_command "$@" ;;
  set-hostname) set_hostname "${1:-}" ;;
  backup)
    case "${1:-}" in
      auto) shift; auto_backup "${1:-status}" ;;
      destination) shift; backup_destination_command "$@" ;;
      *) backup_athanor "${1:-}" ;;
    esac
    ;;
  # Every argument, not the first two: `--new-host` and `--hostname NAME` arrive behind `--yes`,
  # and passing a fixed pair silently dropped them on the one command they exist for.
  restore) restore_athanor "$@" ;;
  update)
    case "${1:-}" in
      # One phase of an update, run by the update as a child so that the files a release adds are
      # placed by that release's own code. Under `update` rather than beside it because it is not a
      # command of its own: on its own it puts a checkout's files onto a running server without
      # stopping it, without a backup and with nothing to go back to. The update is the command.
      install-runtime-files)
        need_root update install-runtime-files
        acquire_maintenance_lock
        cd "$athanor_root" || fail "could not enter $athanor_root"
        install_runtime_files
        # And what this release carries besides its files, here as well as in `update_athanor`.
        #
        # WHY BOTH. `athanor update` is the PREVIOUS release's copy of this script, so the release
        # that first calls `install_release_carried_steps` from `update_athanor` cannot make itself
        # arrive: the shell running that update has never heard of the call. This phase is the one
        # route a release has into the shell of an update that is already under way, and it is why
        # the phase exists at all - every revision back to the one that introduced it hands the
        # placement to the checkout. Reaching it from here means a box whose /usr/local/bin/athanor
        # predates the call gets the packages, the workspace layout and the runner settings on the
        # NEXT update rather than the one after it. On the server this was measured on that is the
        # difference between the filesystem boundary coming on next week and coming on in a
        # fortnight.
        #
        # NOT TWICE. The marker below is how the shell that started the update learns this already
        # happened; it clears it before the phase and clears it again after, so only a marker
        # written during this run counts, and a checkout whose phase does not do this leaves none.
        # Running the steps twice would be harmless - every one of them is idempotent and
        # scripts/test-update.sh runs them twice to prove it - but it would cost a second package
        # resolution in the middle of the owner's outage.
        #
        # After install_runtime_files, not before: the settings step measures the filesystem rung by
        # running /usr/local/lib/athanor/athanor-sandbox, and the line above is what puts this
        # release's copy of that helper there.
        install_release_carried_steps
        # Native entry points must be usable before this release is activated.
        run_update_step "activating native tools" \
          /bin/sh "$athanor_root/scripts/athanor-native-runtime" all
        ;;
      '') update_athanor ;;
      *) fail "usage: athanor update" ;;
    esac
    ;;
  rollback) rollback_athanor "${1:-}" ;;
  auto-update) auto_update "${1:-status}" ;;
  relay) relay_command "${1:-status}" ;;
  uninstall) uninstall_athanor ;;
  certificate)
    # Operator-invoked only. Requesting a publicly trusted certificate means accepting the CA's
    # subscriber agreement, which athanor will not do on the operator's behalf during install.
    # The sub-command has to survive the re-exec through sudo, otherwise `athanor certificate
    # issue` run without sudo would silently become `athanor certificate` and print status.
    need_root certificate "$@"
    exec /bin/sh "$athanor_root/scripts/athanor-certificate" "$@"
    ;;
  ddns)
    need_root ddns "$@"
    exec /bin/sh "$athanor_root/scripts/athanor-ddns" "$@"
    ;;
  # The one command here that is not a host operation and does not want root of its own. It talks to
  # the running API over HTTP with an API token, so it works from this box or from anywhere else
  # that can reach it; root only matters because that is who may read a token out of /etc/athanor.
  task) task_command "$@" ;;
  # Same plumbing as `task`: over HTTP to the running API with an API token, so it works from
  # this box or from anywhere that can reach it. Needs the usage:read scope.
  tool-opens) tool_opens "$@" ;;
  # Spawned by an ACP client rather than typed, and it never returns to this dispatch: `acp_command`
  # execs the bridge so the client's pipe belongs to one process and a signal reaches it directly.
  acp) acp_command "$@" ;;
  help)
    usage
    ;;
  # A misspelling used to print the usage line and exit 0, so a script that ran `athanor resart`
  # carried on as though the server had been restarted, and so did the operator reading a green
  # terminal. Asking for help is a success; asking for a command that does not exist is not.
  *)
    printf 'garden: unknown command: %s\n' "$command_name" >&2
    usage >&2
    exit 64
    ;;
esac
