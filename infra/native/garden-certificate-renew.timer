[Unit]
Description=garden certificate renewal check

[Timer]
# A certificate covering a bare address lasts 160 hours and is renewed inside its final 72, so a
# daily check would leave only three chances to recover from an outage. Every six hours gives
# roughly twelve, and costs nothing: a certificate outside its renewal window exits immediately.
# The random delay spreads load rather than having every garden host ask at the same minute.
OnCalendar=*-*-* 00/6:00:00
RandomizedDelaySec=45m
AccuracySec=1h
# A machine that was asleep or powered off through its window still checks on the next boot.
Persistent=true
# And so does one that was off for less than a window: a server started after days away may hold a
# certificate that expired or is inside its margin, and waiting up to six hours for the next tick
# means hours of browser warnings on a machine that has only just come back. The delay is enough
# for the network and nginx to settle; renewal needs both.
OnBootSec=3min
Unit=garden-certificate-renew.service

[Install]
WantedBy=timers.target
