[Unit]
Description=Daily garden backup

[Timer]
# Daily rather than weekly: what this protects is conversations, files, connector credentials and
# the server's own keys, and a week of those is not something an owner would choose to lose. The
# random delay spreads the load and, more usefully here, means the run lands at a different hour
# each day - so a box that is busy at the same time every evening still gets copied eventually.
OnCalendar=daily
RandomizedDelaySec=3h
AccuracySec=1h
# A server that was off overnight takes its backup when it comes back rather than skipping the day.
Persistent=true
Unit=garden-backup.service

[Install]
WantedBy=timers.target
