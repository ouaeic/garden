[Unit]
Description=Record a failed garden backup
# Started by OnFailure= on the backup unit, never on its own. `no` is systemd's default and said
# the opposite of the line above it: it let `systemctl start garden-backup-alert` file an error
# about a backup that never failed. `yes` refuses only an explicit start request; activation as
# another unit's dependency, which is what OnFailure= is, is unaffected.
RefuseManualStart=yes

[Service]
Type=oneshot
ExecStart=/usr/local/bin/garden backup auto alert
# The journal is the one place a failure is already being written, so it is written at the level
# that shows up in `journalctl -p err` rather than buried among informational lines.
SyslogIdentifier=garden-backup
SyslogLevel=err
