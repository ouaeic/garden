[Unit]
Description=garden backup
After=network-online.target postgresql.service
Wants=postgresql.service
# A backup that keeps failing is invisible by construction: the archive puts the services back and
# the box carries on serving, and a run that died partway leaves no directory behind, because a
# copy with no checksum manifest cannot restore anything. This records the failure where the
# settings screen and `garden doctor` will report it. `garden backup auto run` writes down the
# ordinary failures itself; this catches the run stopped by TimeoutStartSec below, which gets no
# further line of its own to run.
OnFailure=garden-backup-alert.service

[Service]
Type=oneshot
# `garden backup auto run` waits a few minutes for the worker to go idle and stands down if it does
# not, because the archive stops the services for its duration and that is not worth doing over
# somebody's work. It runs without the sandboxing the long-lived services use: it stops and starts
# units, reads the whole workspace and writes outside its own tree.
ExecStart=/usr/local/bin/garden backup auto run
# Bounded, because this runs unattended. A large workspace on a slow disk is the long case; past
# this the run is abandoned and the partial copy is removed by its own trap, leaving yesterday's.
#
# Ninety minutes was the whole budget when the run ended at the local archive. It now has a second
# phase - encrypt the finished files and write them to an off-host destination - which reads and
# writes the same bytes again over a link this program does not control. A twenty-gibibyte archive
# onto a USB disk at 30 MB/s is about a quarter of an hour; the same archive to a NAS over a bad
# wireless link is the case that chose this number, and doubling the old budget with half an hour
# on top is the allowance for it. What would change it is evidence of a real box being killed here:
# a run stopped by this limit records `off_host=running` and never corrects it, so `doctor` says the
# off-host copy did not report back rather than reporting a copy that does not exist.
TimeoutStartSec=3h
