[Unit]
Description=Record a failed garden unattended update
# Started by OnFailure= on the update unit, never on its own. `no` is systemd's default and would
# say the opposite of this line: it lets `systemctl start garden-auto-update-alert` file an error
# about an update that never failed. `yes` refuses only an explicit start request; activation as
# another unit's dependency, which is what OnFailure= is, is unaffected. The backup's alert unit
# carries the identical directive for the identical reason.
RefuseManualStart=yes

[Service]
Type=oneshot
ExecStart=/usr/local/bin/garden auto-update alert
# The journal is the one place a failure is already being written, so it is written at the level
# that shows up in `journalctl -p err` rather than buried among informational lines.
SyslogIdentifier=garden-auto-update
SyslogLevel=err
