[Unit]
Description=Refresh garden endpoints when the relay is switched on or off

[Path]
# The reconciliation timer runs every six hours, which is fine for an address that changed and
# useless for an owner who just switched the relay off: the connection manifest would keep offering
# a relay address nothing answers on until the timer came round. This makes the manifest follow the
# setting immediately, without giving the control services any privilege to rewrite it themselves.
PathChanged=/etc/garden/relay/settings.json
Unit=garden-network-refresh.service

[Install]
WantedBy=paths.target
