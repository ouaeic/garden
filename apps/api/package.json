{
  "name": "@garden/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--conditions=development tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_OPTIONS=--conditions=development vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.0",
    "@fastify/helmet": "13.2.0",
    "@fastify/websocket": "11.3.6",
    "@garden/contracts": "workspace:*",
    "@garden/core": "workspace:*",
    "@garden/data": "workspace:*",
    "@garden/model-gateway": "workspace:*",
    "@garden/relay-client": "workspace:*",
    "@garden/worker": "workspace:*",
    "@simplewebauthn/server": "14.0.3",
    "fastify": "5.12.8",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/ws": "8.18.2"
  }
}
