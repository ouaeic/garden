{
  "name": "@athanor/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/agent.ts",
      "development": "./src/agent.ts",
      "default": "./dist/agent.js"
    },
    "./media-job-domain": {
      "types": "./src/media-job-domain.ts",
      "development": "./src/media-job-domain.ts",
      "default": "./dist/media-job-domain.js"
    },
    "./media-jobs": {
      "types": "./src/media-jobs.ts",
      "development": "./src/media-jobs.ts",
      "default": "./dist/media-jobs.js"
    }
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--conditions=development tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_OPTIONS=--conditions=development vitest run"
  },
  "dependencies": {
    "@athanor/contracts": "workspace:*",
    "@athanor/core": "workspace:*",
    "@athanor/data": "workspace:*",
    "@athanor/model-gateway": "workspace:*",
    "zod": "4.6.5"
  }
}
