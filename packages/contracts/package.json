{
  "name": "@garden/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./env": {
      "types": "./src/env.ts",
      "development": "./src/env.ts",
      "default": "./dist/env.js"
    },
    "./permission-policy": {
      "types": "./src/permission-policy.ts",
      "browser": "./src/permission-policy.ts",
      "development": "./src/permission-policy.ts",
      "default": "./dist/permission-policy.js"
    },
    "./artifact-reference": {
      "types": "./src/artifact-reference.ts",
      "browser": "./src/artifact-reference.ts",
      "development": "./src/artifact-reference.ts",
      "default": "./dist/artifact-reference.js"
    },
    "./analysis-run": {
      "types": "./src/analysis-run.ts",
      "browser": "./src/analysis-run.ts",
      "development": "./src/analysis-run.ts",
      "default": "./dist/analysis-run.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_OPTIONS=--conditions=development vitest run"
  },
  "dependencies": {
    "zod": "4.4.3"
  }
}
