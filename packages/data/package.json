{
  "name": "@garden/data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./test-support/database-fixtures": {
      "types": "./src/test-support/database-fixtures.ts",
      "development": "./src/test-support/database-fixtures.ts"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_OPTIONS=--conditions=development vitest run"
  },
  "dependencies": {
    "@garden/contracts": "workspace:*",
    "@garden/core": "workspace:*",
    "@electric-sql/pglite": "0.5.4",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.21.0"
  }
}
