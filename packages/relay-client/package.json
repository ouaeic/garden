{
  "name": "@garden/relay-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_OPTIONS=--conditions=development vitest run && NODE_OPTIONS=--conditions=development tsx scripts/relay-roundtrip.mts && NODE_OPTIONS=--conditions=development tsx scripts/relay-bind-refusal.mts"
  },
  "dependencies": {
    "@garden/relay": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
}
