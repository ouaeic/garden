# Local development configuration: copy it to .env for `pnpm dev`. A server install never reads
# this file - ./install.sh runs scripts/install-native.sh, which generates /etc/garden/control.env
# and /etc/garden/runner.env with secrets of its own.
#
# Every value here matches the default its process already declares, except where a comment says
# why a checkout wants something different. scripts/check-repository.mjs holds that to be true, so
# a default that moves in code cannot leave a stale number here overriding it.
DEPLOYMENT_MODE=development
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_SOURCE_URL=
PREVIEW_BASE_URL=http://preview.localhost:4400
API_HOST=127.0.0.1
API_PORT=4100
PREVIEW_GATEWAY_HOST=127.0.0.1
PREVIEW_GATEWAY_PORT=4400
# A fixed name, so a lease in the log belongs to something recognisable. A packaged install lets
# each worker name itself after its process instead, because two of them must never share a lease.
WORKER_ID=worker-dev-1

# PGlite keeps local development dependency-free. Server installs use PostgreSQL.
DATABASE_DRIVER=pglite
PGLITE_PATH=.garden/postgres
DATABASE_URL=postgres://garden:garden@localhost:5432/garden

# Generate local values with:
#   openssl rand -base64 32
DATA_MASTER_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
SESSION_SIGNING_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
RUNNER_SHARED_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Local passkey fallback. Production uses HTTPS and real WebAuthn.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=garden
WEBAUTHN_ORIGIN=http://localhost:5173
ALLOW_INSECURE_DEV_AUTH=true

# Persistent Linux agent computer.
WORKSPACE_RUNNER_URL=http://127.0.0.1:4300
PUBLIC_RUNNER_URL=ws://127.0.0.1:4300
WORKSPACE_ROOT=.garden/workspaces
RUNNER_HOST=127.0.0.1
RUNNER_PORT=4300
BROWSER_EXECUTABLE_PATH=
DESKTOP_BRIDGE_EXECUTABLE=
DESKTOP_SESSION_EXECUTABLE=
# Foreground and unnamed task-session ceilings. Named finite jobs have an optional deadline;
# omitting it lets an analysis run until it finishes or the owner stops it.
MAX_EXECUTION_SECONDS=3600
MAX_BACKGROUND_SECONDS=86400
ISOLATE_AGENT_NETWORK=false
# Whether an agent command also gets a Landlock ruleset - its own workspace/ and .home writable,
# the system directories readable, /home granted nowhere - on the same exec line as the drop to the
# agent account. Written by scripts/install-native.sh from what `garden-sandbox check` measured on
# the host, not chosen here: a kernel or a util-linux that cannot apply a ruleset is told to stop
# asking rather than left failing every command. Turning it on by hand on a box that cannot do it
# makes every agent command exit 125. /healthz reports what the runner actually resolved.
CONFINE_AGENT_FILESYSTEM=false

# Configure a provider in Settings after signing in. These are optional operator fallbacks.
AI_PROVIDER=openrouter
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_DEFAULT_MODEL=
AI_REQUIRE_ZDR=true
ALLOW_INSECURE_PROVIDER_URLS=false
# provider_catalog offers every chat model your own provider account can reach, so models
# released after this build appear without an Garden update. reviewed_open_weight restricts
# selection to models with a current independent weight-licence review and fails closed when
# one lapses.
MODEL_CATALOG_SCOPE=provider_catalog
# Only if the catalogue should be refreshed from an account other than the one the owner saved in
# Settings. Left empty the registry uses the owner's own provider key, which is what a shipped
# install has, and an empty value here is the normal state rather than a missing step.
OPENROUTER_REGISTRY_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Comma-separated HTTPS host suffixes the owner may connect as WebDAV or MCP services.
CONNECTOR_ALLOWED_HOST_SUFFIXES=
REGISTRY_REFRESH_SECONDS=3600
WORKER_POLL_MS=1000
SCHEDULER_POLL_MS=15000
TASK_MAX_STEPS=120
# How many times one turn may give itself another step budget rather than stopping for a reply. It
# only ever happens when the harness has just run the turn's own acceptance checks and found them
# failing, and it buys steps rather than money - the compute allowance and the spending caps are
# untouched. Zero switches it off and a turn stops at TASK_MAX_STEPS as it always did.
TASK_MAX_SELF_CONTINUATIONS=60

# Optional generic Web Push.
PUSH_VAPID_SUBJECT=mailto:operator@example.com
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_ENDPOINT_HOST_SUFFIXES=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com,.notify.windows.com
NOTIFICATION_POLL_MS=2000
NOTIFICATION_BATCH_SIZE=100
# The phone transport: where its bot API answers (one real value; a test points it at a stub) and
# how many seconds one inbound long poll waits. The bot token itself is entered in Settings and
# sealed in the database under DATA_MASTER_KEY, never written here.
TELEGRAM_API_BASE_URL=https://api.telegram.org
NOTIFICATION_INBOUND_POLL_TIMEOUT_S=50
# Share links: a read-only, encrypted snapshot of one conversation behind /v1/shares/<id>#<key>.
# Absent or true is on; false answers every link, existing ones included, with the same 404 an
# unknown link gets. The key after # never reaches this server, so the rows hold only ciphertext.
SHARING_ENABLED=true
